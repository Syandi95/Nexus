{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conversation Index",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "integer" },
    "appVersion": { "type": "string" },
    "updatedAt": { "type": "string" },
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "modelId": { "type": "string" },
          "messageCount": { "type": "integer" }
        },
        "required": ["id", "title", "createdAt", "updatedAt", "provider", "model", "modelId", "messageCount"]
      }
    }
  },
  "required": ["schemaVersion", "appVersion", "updatedAt", "conversations"]
}
