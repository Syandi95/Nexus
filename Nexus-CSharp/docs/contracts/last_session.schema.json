{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Last Session",
  "type": "object",
  "properties": {
    "Messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Content": {
            "type": "string"
          },
          "Role": {
            "type": "string"
          }
        },
        "required": [
          "Content",
          "Role"
        ]
      }
    },
    "Timestamp": {
      "type": "string"
    },
    "ActiveModel": {
      "type": "string"
    }
  },
  "required": [
    "Messages",
    "Timestamp",
    "ActiveModel"
  ]
}
