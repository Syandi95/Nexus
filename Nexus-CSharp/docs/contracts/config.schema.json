{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppConfig",
  "type": "object",
  "properties": {
    "theme": {
      "type": "string",
      "description": "Current UI theme"
    },
    "accentColor": {
      "type": "string"
    },
    "activeTab": {
      "type": "string"
    },
    "aiProvider": {
      "type": "string"
    },
    "aiModel": {
      "type": "string"
    },
    "windowWidth": {
      "type": "integer"
    },
    "windowHeight": {
      "type": "integer"
    },
    "recentFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "theme"
  ]
}
