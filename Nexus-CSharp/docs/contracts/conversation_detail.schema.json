{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conversation Detail",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "integer" },
    "appVersion": { "type": "string" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "modelId": { "type": "string" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "role": { "type": "string" },
          "content": { "type": "string" },
          "timestamp": { "type": "string" },
          "EditProposal": { 
            "type": "object",
            "description": "candidate_eval: EditProposal"
          }
        },
        "required": ["id", "role", "content", "timestamp"]
      }
    }
  },
  "required": ["schemaVersion", "appVersion", "id", "title", "createdAt", "updatedAt", "provider", "model", "modelId", "messages"]
}
