<Project>
  <Target Name="AutoSignNexusOutputs" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -Command &quot;if (Get-PSDrive Cert -ErrorAction SilentlyContinue) { $c = Get-ChildItem Cert:\CurrentUser\My | Where-Object { $_.EnhancedKeyUsageList.ObjectId -contains '1.3.6.1.5.5.7.3.3' } | Select-Object -First 1; if ($c) { Set-AuthenticodeSignature -Certificate $c -FilePath '$(TargetPath)' | Out-Null; if (Test-Path '$(TargetDir)$(TargetName).exe') { Set-AuthenticodeSignature -Certificate $c -FilePath '$(TargetDir)$(TargetName).exe' | Out-Null } } }&quot;" ContinueOnError="true" />
  </Target>
</Project>
