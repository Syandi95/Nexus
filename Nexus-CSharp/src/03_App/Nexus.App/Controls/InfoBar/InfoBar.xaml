<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Nexus.App.Controls.InfoBar">

    <Style TargetType="{x:Type controls:InfoBar}">
        <Setter Property="Background" Value="{DynamicResource NexusInfoBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusInfoStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBar}">
                    <Border x:Name="InfoBarRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Severity Icon -->
                            <Border x:Name="IconContainer" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SeverityIcon"
                                           FontFamily="{DynamicResource NexusTypographyIconFontFamily}"
                                           FontSize="16"
                                           Text="&#xE946;"
                                           Foreground="{DynamicResource NexusInfoForeground}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Content area (Title + Message + Content) -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleBlock"
                                               Text="{TemplateBinding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MessageBlock"
                                               Text="{TemplateBinding Message}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </WrapPanel>
                                <ContentPresenter Grid.Row="1" Margin="0,4,0,0"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Grid>

                            <!-- Close Button -->
                            <Button x:Name="CloseButton"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{TemplateBinding CloseCommand}"
                                    Width="22" Height="22"
                                    Cursor="Hand"
                                    ToolTip="Tutup">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="4">
                                            <TextBlock Text="&#xE8BB;"
                                                       FontFamily="{DynamicResource NexusTypographyIconFontFamily}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsOpen visibility trigger -->
                        <Trigger Property="IsOpen" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsOpen" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- IsClosable trigger -->
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Title empty trigger -->
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Message empty trigger -->
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="MessageBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="MessageBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Severity: Informational -->
                        <Trigger Property="Severity" Value="Informational">
                            <Setter Property="Background" Value="{DynamicResource NexusInfoBackground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource NexusInfoStroke}"/>
                            <Setter TargetName="SeverityIcon" Property="Text" Value="&#xE946;"/>
                            <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource NexusInfoForeground}"/>
                        </Trigger>

                        <!-- Severity: Success -->
                        <Trigger Property="Severity" Value="Success">
                            <Setter Property="Background" Value="{DynamicResource NexusSuccessBackground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource NexusSuccessStroke}"/>
                            <Setter TargetName="SeverityIcon" Property="Text" Value="&#xE73E;"/>
                            <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource NexusSuccessForeground}"/>
                        </Trigger>

                        <!-- Severity: Warning -->
                        <Trigger Property="Severity" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource NexusWarningBackground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource NexusWarningStroke}"/>
                            <Setter TargetName="SeverityIcon" Property="Text" Value="&#xE7BA;"/>
                            <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource NexusWarningForeground}"/>
                        </Trigger>

                        <!-- Severity: Error -->
                        <Trigger Property="Severity" Value="Error">
                            <Setter Property="Background" Value="{DynamicResource NexusErrorBackground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource NexusErrorStroke}"/>
                            <Setter TargetName="SeverityIcon" Property="Text" Value="&#xEA39;"/>
                            <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource NexusErrorForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
