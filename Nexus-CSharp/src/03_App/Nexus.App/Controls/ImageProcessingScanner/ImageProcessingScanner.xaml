<UserControl x:Class="Nexus.App.Controls.ImageProcessingScanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Background="Transparent"
             IsHitTestVisible="False"
             Visibility="Collapsed"
             Opacity="0">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- VERTICAL SWEEP BAND (RemoveBackground & AiCheck) - 52px Soft Luminance Field -->
        <Grid x:Name="VerticalBand" Height="52" VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="VerticalTranslate" Y="0"/>
            </Grid.RenderTransform>

            <!-- 1. Primary: Soft Luminance Field (52px diffuse white gradient, 5.5% peak lift) -->
            <Rectangle Height="52" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#04FFFFFF" Offset="0.2"/>
                        <GradientStop Color="#0AFFFFFF" Offset="0.4"/>
                        <GradientStop Color="#0EFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#0AFFFFFF" Offset="0.6"/>
                        <GradientStop Color="#04FFFFFF" Offset="0.8"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 2. Secondary: Minimal Accent Tint (38px, subtle NEXUS identity, effective peak ~4.2%) -->
            <Rectangle Height="38" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                       Fill="{DynamicResource AccentPrimaryBrush}" Opacity="0.12" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#15000000" Offset="0.25"/>
                        <GradientStop Color="#55000000" Offset="0.5"/>
                        <GradientStop Color="#15000000" Offset="0.75"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- 3. Tertiary: Thin Optical Beam (2px center indicator) -->
            <Rectangle Height="2" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                       Fill="{DynamicResource AccentPrimaryBrush}" Opacity="0.40" IsHitTestVisible="False"/>

            <!-- 4. Quaternary: Specular Center Core (1px white highlight) -->
            <Rectangle Height="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                       Fill="White" Opacity="0.20" IsHitTestVisible="False"/>
        </Grid>

        <!-- HORIZONTAL SWEEP BAND (Upscale & ObjectRemoval) - 52px Soft Luminance Field -->
        <Grid x:Name="HorizontalBand" Width="52" HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="Collapsed" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HorizontalTranslate" X="0"/>
            </Grid.RenderTransform>

            <!-- 1. Primary: Soft Luminance Field (52px diffuse white gradient, 5.5% peak lift) -->
            <Rectangle Width="52" HorizontalAlignment="Center" VerticalAlignment="Stretch" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#04FFFFFF" Offset="0.2"/>
                        <GradientStop Color="#0AFFFFFF" Offset="0.4"/>
                        <GradientStop Color="#0EFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#0AFFFFFF" Offset="0.6"/>
                        <GradientStop Color="#04FFFFFF" Offset="0.8"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 2. Secondary: Minimal Accent Tint (38px, subtle NEXUS identity, effective peak ~4.2%) -->
            <Rectangle Width="38" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                       Fill="{DynamicResource AccentPrimaryBrush}" Opacity="0.12" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#15000000" Offset="0.25"/>
                        <GradientStop Color="#55000000" Offset="0.5"/>
                        <GradientStop Color="#15000000" Offset="0.75"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- 3. Tertiary: Thin Optical Beam (2px center indicator) -->
            <Rectangle Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                       Fill="{DynamicResource AccentPrimaryBrush}" Opacity="0.40" IsHitTestVisible="False"/>

            <!-- 4. Quaternary: Specular Center Core (1px white highlight) -->
            <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                       Fill="White" Opacity="0.20" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</UserControl>
