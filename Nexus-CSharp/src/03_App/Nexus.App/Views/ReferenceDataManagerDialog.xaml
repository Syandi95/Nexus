<Window x:Class="Nexus.App.Views.ReferenceDataManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:Nexus.App.Services"
        mc:Ignorable="d"
        Title="Database Referensi Resmi &amp; Kamus - NEXUS"
        Height="660" Width="920"
        MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NexusSurfaceBase}"
        Foreground="{DynamicResource NexusForegroundPrimary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- 2-Option Context Menu for Row (Edit & Delete) -->
        <ContextMenu x:Key="EntryRowContextMenu" Style="{DynamicResource NexusContextMenuStyle}">
            <MenuItem Header="Edit" Click="MenuEdit_Click">
                <MenuItem.Icon>
                    <TextBlock services:NexusIcon.Glyph="Edit" FontSize="14" HorizontalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Margin="0,3"/>
            <MenuItem Header="Hapus" Click="MenuDelete_Click">
                <MenuItem.Icon>
                    <TextBlock services:NexusIcon.Glyph="Delete" FontSize="14" Foreground="#EF4444" HorizontalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header: Modern & Focused -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Database Referensi Resmi &amp; Kamus"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource NexusForegroundPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource NexusSurfaceRaised}"
                                BorderBrush="{DynamicResource NexusStrokeDefault}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AI Check Layer 3" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NexusAccentRest}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Entitas resmi (desa, faskes, kecamatan, pejabat) dan kata baku KBBI diverifikasi otomatis saat pemeriksaan desain berjalan."
                               FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource NexusForegroundSecondary}"/>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleImport" Height="34" Padding="14,0"
                            Style="{DynamicResource NexusSecondaryButtonStyle}"
                            Click="BtnToggleImport_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock services:NexusIcon.Glyph="FolderOpen" FontSize="13" Margin="0,0,6,0"
                                       Foreground="{DynamicResource NexusAccentRest}"/>
                            <TextBlock x:Name="TxtToggleImportButton" Text="Impor CSV / KBBI" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content (2 Columns: Datasets Sidebar + Detail Table) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Datasets Sidebar -->
            <Border Grid.Column="0" Margin="0,0,14,0"
                    Background="{DynamicResource NexusSurfaceRaised}"
                    BorderBrush="{DynamicResource NexusStrokeDefault}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock Text="KOLEKSI DATASET" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource NexusForegroundSecondary}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnQuickNew" Height="26" Padding="8,0" HorizontalAlignment="Right"
                                Style="{DynamicResource NexusSecondaryButtonStyle}"
                                Click="BtnShowImport_Click" Cursor="Hand" ToolTip="Buat Dataset Baru">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock services:NexusIcon.Glyph="Add" FontSize="11" Margin="0,0,4,0"
                                           Foreground="{DynamicResource NexusAccentRest}"/>
                                <TextBlock Text="Baru" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Dataset TreeView: Hierarchical Dataset & Category Navigation (WPF UI Gallery Style) -->
                    <TreeView x:Name="DatasetTreeView" Grid.Row="1"
                              Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="DatasetTreeView_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <!-- ExpandCollapse ToggleButton Style with Vector Path Chevron -->
                            <Style x:Key="WpfUiExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Width="16" Height="16" Background="Transparent">
                                                <Path x:Name="ChevronPath"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 1 1 L 5 5 L 1 9"
                                                      Stroke="#64748B" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ChevronPath" Property="Data" Value="M 1 2 L 5 6 L 9 2"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ChevronPath" Property="Stroke" Value="{DynamicResource NexusForegroundPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Clean Modern TreeViewItem Style (WPF UI Gallery Benchmark) -->
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="2,4"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid Background="Transparent">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="ItemBorder"
                                                        Grid.Row="0"
                                                        Background="Transparent"
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- WinUI 3 Selection indicator bar on the left -->
                                                        <Rectangle x:Name="ActiveRectangle"
                                                                   Grid.Column="0"
                                                                   Width="3" Height="16"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                   Fill="{DynamicResource NexusAccentRest}"
                                                                   RadiusX="1.5" RadiusY="1.5"
                                                                   Visibility="Collapsed"/>

                                                        <!-- Chevron Expander Toggle -->
                                                        <ToggleButton x:Name="Expander"
                                                                      Grid.Column="0"
                                                                      Margin="2,0,4,0"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      ClickMode="Press"
                                                                      Style="{StaticResource WpfUiExpandCollapseToggleStyle}"/>

                                                        <ContentPresenter x:Name="PART_Header"
                                                                          Grid.Column="1"
                                                                          ContentSource="Header"
                                                                          VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ItemsPresenter x:Name="ItemsHost"
                                                                    Grid.Column="1"
                                                                    Visibility="Collapsed"/>
                                                </Grid>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                                    <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,1">
                                    <TextBlock Text="{Binding Header}" FontSize="12"
                                               FontWeight="{Binding FontWeight}"
                                               Foreground="{DynamicResource NexusForegroundPrimary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CountDisplay}" FontSize="11"
                                               Foreground="#94A3B8" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Sidebar Footer: Delete Dataset Action -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,8,0,0"
                            BorderBrush="{DynamicResource NexusStrokeDefault}" BorderThickness="0,1,0,0">
                        <Button x:Name="BtnDeleteDataset" Height="32"
                                IsEnabled="False"
                                Style="{DynamicResource NexusDangerButtonStyle}"
                                Click="BtnDeleteDataset_Click" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock services:NexusIcon.Glyph="Delete" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Hapus Dataset Terpilih" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Detail Panel / Import Drawer -->
            <Border Grid.Column="1"
                    Background="{DynamicResource NexusSurfaceRaised}"
                    BorderBrush="{DynamicResource NexusStrokeDefault}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <!-- VIEW 1: Clean Crisp Data Table (Latar Putih Polos Murni) -->
                    <Grid x:Name="PanelEntriesView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header of Selected Dataset with Breadcrumb -->
                        <Grid Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <!-- Breadcrumb Navigation -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBreadcrumbDataset" Text="Koleksi Dataset"
                                               FontWeight="SemiBold" FontSize="16"
                                               Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                    <TextBlock x:Name="TxtBreadcrumbSep1" Text=" › "
                                               FontWeight="SemiBold" FontSize="14"
                                               Foreground="#94A3B8" Margin="4,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="TxtBreadcrumbChild" Text=""
                                               FontWeight="Bold" FontSize="15"
                                               Foreground="{DynamicResource NexusAccentRest}" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSelectedDatasetSubtitle"
                                           Text="Entitas resmi (desa, faskes, kecamatan) diverifikasi otomatis saat pemeriksaan desain berjalan."
                                           FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FFFFFF"
                                    BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtEntriesBadge" Text="0 entri"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#0F172A"/>
                            </Border>
                        </Grid>

                        <!-- Controls Bar: Search Filter & Inline Quick Add -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Filter (White background, crisp border) -->
                            <Grid Grid.Column="0">
                                <TextBox x:Name="TxtSearchEntries" Height="32" Padding="28,0,8,0" VerticalContentAlignment="Center"
                                         Background="#FFFFFF"
                                         Foreground="#0F172A"
                                         BorderBrush="#CBD5E1"
                                         FontSize="12"
                                         TextChanged="TxtSearchEntries_TextChanged"/>
                                <TextBlock services:NexusIcon.Glyph="Search" FontSize="12"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock x:Name="TxtSearchPlaceholder" Text="Cari entri..."
                                           IsHitTestVisible="False" Margin="30,0,0,0" VerticalAlignment="Center"
                                           Foreground="#94A3B8" FontStyle="Italic" FontSize="11"/>
                            </Grid>

                            <!-- Quick Add Entry Input (White background, crisp) -->
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewEntry" Height="32" Padding="8,0" VerticalContentAlignment="Center"
                                         Background="#FFFFFF"
                                         Foreground="#0F172A"
                                         BorderBrush="#CBD5E1"
                                         FontSize="12"
                                         KeyDown="TxtNewEntry_KeyDown"
                                         TextChanged="TxtNewEntry_TextChanged"/>
                                <TextBlock x:Name="TxtNewEntryPlaceholder" Text="+ Tambah nama entri baru (tekan Enter)..."
                                           IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="#94A3B8" FontStyle="Italic" FontSize="11"/>
                                <Button x:Name="BtnAddEntry" Grid.Column="1" Height="32" Padding="14,0" Margin="6,0,0,0"
                                        Style="{DynamicResource NexusPrimaryButtonStyle}"
                                        Click="BtnAddEntry_Click" Cursor="Hand" ToolTip="Tambah entri ke dataset ini">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock services:NexusIcon.Glyph="Add" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock Text="Tambah" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- TABLE CONTAINER: LATAR PUTIH POLOS (Crisp White Data Table) -->
                        <Border Grid.Row="2" Background="#FFFFFF"
                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header: #F8FAFC, Soft border, exactly 3 columns (NO., NAMA ENTITAS RESMI, AKSI) -->
                                <Border Grid.Row="0" Background="#F8FAFC"
                                        BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="NO." FontSize="10" FontWeight="Bold"
                                                   Foreground="#64748B"
                                                   FontFamily="Consolas, Segoe UI"/>
                                        <TextBlock Grid.Column="1" Text="NAMA ENTITAS RESMI" FontSize="10" FontWeight="Bold"
                                                   Foreground="#64748B"/>
                                        <TextBlock Grid.Column="2" Text="AKSI" FontSize="10" FontWeight="Bold"
                                                   Foreground="#64748B"
                                                   HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                    </Grid>
                                </Border>

                                <!-- Table Rows: Pure White (#FFFFFF) with Hairline Dividers (#F1F5F9), 100% Stretch -->
                                <ListBox x:Name="EntriesListBox" Grid.Row="1"
                                         Background="#FFFFFF" BorderThickness="0" Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Single"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="MinHeight" Value="32"/>
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="ContextMenu" Value="{StaticResource EntryRowContextMenu}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Stretch">
                                                <!-- NORMAL DISPLAY MODE (Compact 32px height, 100% full width) -->
                                                <Border Visibility="{Binding IsNotEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Padding="12,0" Height="32"
                                                        BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Row Number -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Index}"
                                                                   FontSize="11" Foreground="#94A3B8"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Consolas, Segoe UI"/>

                                                        <!-- Clean Text (High Contrast Dark Slate, No Icons!) -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                   FontSize="12" FontWeight="Medium"
                                                                   Foreground="#0F172A"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                        <!-- Row Action Button [...] with 2-Option ContextMenu -->
                                                        <Button Grid.Column="2"
                                                                Style="{DynamicResource NexusSubtleButtonStyle}"
                                                                Width="28" Height="26" Padding="0" Cursor="Hand"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                ToolTip="Opsi Entri"
                                                                Click="BtnRowMoreOptions_Click"
                                                                Tag="{Binding}">
                                                            <TextBlock services:NexusIcon.Glyph="More" FontSize="14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="#64748B"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- INLINE EDIT MODE -->
                                                <Border Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Padding="12,2" MinHeight="32"
                                                        BorderBrush="{DynamicResource NexusAccentRest}" BorderThickness="0,0,0,1"
                                                        Background="#F8FAFC"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Index}"
                                                                   FontSize="11" Foreground="{DynamicResource NexusAccentRest}"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Consolas, Segoe UI"/>

                                                        <TextBox Grid.Column="1" Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 KeyDown="TxtEditEntry_KeyDown"
                                                                 Tag="{Binding}"
                                                                 Background="#FFFFFF"
                                                                 Foreground="#0F172A"
                                                                 BorderBrush="{DynamicResource NexusAccentRest}"
                                                                 Height="26" Padding="6,0" VerticalContentAlignment="Center"
                                                                 Margin="0,0,8,0"
                                                                 FontSize="12"/>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Click="BtnSaveEditEntry_Click"
                                                                    Tag="{Binding}"
                                                                    Height="24" Padding="8,0" Margin="0,0,4,0"
                                                                    Style="{DynamicResource NexusPrimaryButtonStyle}"
                                                                    FontSize="11" Content="Simpan"/>
                                                            <Button Click="BtnCancelEditEntry_Click"
                                                                    Tag="{Binding}"
                                                                    Height="24" Padding="8,0"
                                                                    Style="{DynamicResource NexusSecondaryButtonStyle}"
                                                                    FontSize="11" Content="Batal"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Empty State -->
                                <StackPanel x:Name="TxtEmptyEntriesState" Grid.Row="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                    <TextBlock services:NexusIcon.Glyph="Info" FontSize="22"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtEmptyEntriesText"
                                               Text="Pilih dataset di sebelah kiri untuk mengelola data."
                                               FontSize="12" FontStyle="Italic"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Footer Info -->
                        <Grid Grid.Row="3" Margin="2,8,2,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="Semua dataset aktif otomatis digabung saat AI Check memeriksa desain"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtEntriesCount" Text="Total: 0 entri"
                                       FontSize="11" Foreground="{DynamicResource NexusForegroundSecondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- VIEW 2: Base Language Lexicon Info Card (Read-Only 20K System Asset) -->
                    <Grid x:Name="PanelBaseLexiconView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kamus Dasar Bahasa Indonesia"
                                           FontWeight="SemiBold" FontSize="16"
                                           Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                <TextBlock Text="Aset leksikal sistem bawaan Nexus • Read-Only"
                                           FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#ECFDF5"
                                    BorderBrush="#A7F3D0" BorderThickness="1"
                                    CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                                    <TextBlock Text="Aktif Otomatis" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Informative Card Body -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="24">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock services:NexusIcon.Glyph="Info" FontSize="26" Foreground="{DynamicResource NexusAccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Kamus Dasar Bahasa Indonesia" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Jumlah Kosakata Sistem:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBaseLexiconWordCount" Text="Memuat..." Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Kamus dasar ini dimuat langsung dari aset sistem dan berfungsi sebagai acuan leksikal (lexical evidence) serta kolam target koreksi ejaan otomatis di AI Check."
                                           FontSize="12" TextWrapping="Wrap" Foreground="#475569" TextAlignment="Center" Margin="0,0,0,14" LineHeight="18"/>

                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="💡 Prinsip Kerja Acuan Leksikal:" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Kata ada di kamus dasar BUKAN berarti pasti benar (misal: 'BIAYA MAKAM' vs 'MAKAN')." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Text="• Kata tidak ada di kamus dasar BUKAN berarti typo (nama orang, akronim, istilah daerah)." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Text="• Tambahkan istilah khusus atau singkatan ke Kamus Pengguna agar dikenali sistem." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Footer -->
                        <Grid Grid.Row="2" Margin="2,8,2,0">
                            <TextBlock Text="Aset sistem read-only dilindungi untuk menjamin stabilitas evaluasi kualitas pra-cetak."
                                       FontSize="11" Foreground="{DynamicResource NexusForegroundSecondary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- VIEW 3: Dataset Smart Importer / Bulk Add View -->
                    <Grid x:Name="PanelImportView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header of Smart Importer -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Impor Data &amp; Entri Massal"
                                           FontWeight="Bold" FontSize="15"
                                           Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                
                                <!-- Contextual Target Banner -->
                                <Border Margin="0,8,0,0" Padding="12,8" Background="#F1F5F9"
                                        BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Target Impor:" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtImportTargetDisplay" Text="Wilayah OKU"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource NexusForegroundPrimary}" VerticalAlignment="Center"/>
                                            <Border x:Name="BadgeImportCategory" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                    CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtBadgeImportCategory" Text="Kategori: Otomatis"
                                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NexusAccentPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{DynamicResource NexusSubtleButtonStyle}"
                                                Height="24" Padding="8,0" Cursor="Hand" Click="BtnToggleTargetOverride_Click">
                                            <TextBlock x:Name="TxtBtnTargetOverride" Text="Ubah Target..." FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource NexusAccentRest}"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Target Override Panel (Collapsible) -->
                                <Border x:Name="PanelTargetOverride" Margin="0,8,0,0" Padding="12"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="8" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="PILIH TARGET LAIN ATAU KETIK DATASET BARU" FontWeight="SemiBold" FontSize="10"
                                                   Foreground="#64748B" Margin="0,0,0,8"/>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nama Dataset:" FontSize="11" FontWeight="Medium" Margin="0,0,0,4" Foreground="#475569"/>
                                                <TextBox x:Name="TxtDatasetName" Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" FontSize="11"
                                                         TextChanged="TxtOverride_TextChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Kategori:" FontSize="11" FontWeight="Medium" Margin="0,0,0,4" Foreground="#475569"/>
                                                <TextBox x:Name="TxtCategory" Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" FontSize="11"
                                                         TextChanged="TxtOverride_TextChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Kecamatan Induk (Opsional):" FontSize="11" FontWeight="Medium" Margin="0,0,0,4" Foreground="#475569"/>
                                                <TextBox x:Name="TxtParentOverride" Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" FontSize="11"
                                                         TextChanged="TxtOverride_TextChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Height="28" Padding="10,0"
                                    Style="{DynamicResource NexusSecondaryButtonStyle}"
                                    Click="BtnBackToEntries_Click" Cursor="Hand">
                                <TextBlock Text="Kembali ke Daftar" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>

                        <!-- Form / Content Area -->
                        <Grid Grid.Row="1" Margin="0,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Tempel Entri (1 baris per nama atau tabel CSV/Excel):"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NexusForegroundSecondary}" Margin="0,0,0,4"/>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <TextBox x:Name="TxtInputContent" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Padding="8,6"
                                         FontFamily="Consolas, Segoe UI" FontSize="11"
                                         Background="#FFFFFF"
                                         Foreground="#0F172A"
                                         BorderBrush="#CBD5E1"
                                         TextChanged="TxtInputContent_TextChanged"/>
                                <TextBlock x:Name="TxtInputPlaceholder" IsHitTestVisible="False" Margin="10,8,0,0"
                                           Foreground="#94A3B8" FontStyle="Italic" FontSize="11"
                                           Text="Tempel daftar nama (1 baris per nama):&#x0a;Air Paoh&#x0a;Kemalaraja&#x0a;Sekarjaya&#x0a;&#x0a;Atau tempel tabel CSV dari Excel dengan kolom: Nama, Kategori, Induk"/>
                            </Grid>

                            <!-- Smart Detection Status Indicator -->
                            <Border x:Name="PanelSmartDetection" Grid.Row="2" Padding="10,6" Background="#F0FDF4"
                                    BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✓ " FontSize="12" FontWeight="Bold" Foreground="#16A34A"/>
                                    <TextBlock x:Name="TxtSmartDetectionMessage" Text="Format terdeteksi..."
                                               FontSize="11" FontWeight="Medium" Foreground="#15803D"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Actions Bar -->
                        <Border Grid.Row="2" Padding="0,10,0,0" BorderBrush="{DynamicResource NexusStrokeDefault}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Button x:Name="BtnImportFile" Height="32" Padding="12,0" HorizontalAlignment="Left"
                                        Style="{DynamicResource NexusSecondaryButtonStyle}"
                                        Click="BtnImportFile_Click" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock services:NexusIcon.Glyph="FolderOpen" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Pilih Berkas CSV..." FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Height="32" Padding="14,0" Margin="0,0,6,0"
                                            Style="{DynamicResource NexusSecondaryButtonStyle}"
                                            Click="BtnBackToEntries_Click" Cursor="Hand">
                                        <TextBlock Text="Batal" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="BtnSaveDataset" Height="32" Padding="16,0"
                                            Style="{DynamicResource NexusPrimaryButtonStyle}"
                                            Click="BtnSaveDataset_Click" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock services:NexusIcon.Glyph="Save" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Simpan &amp; Gabungkan" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Window Footer -->
        <Border Grid.Row="2" Padding="0,6,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="100" Height="32"
                        Style="{DynamicResource NexusSecondaryButtonStyle}"
                        Click="BtnClose_Click" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock services:NexusIcon.Glyph="Close" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Tutup" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
