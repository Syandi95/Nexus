<UserControl x:Class="Nexus.App.Views.ImageSubsystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Nexus.App.Services"
             xmlns:controls="clr-namespace:Nexus.App.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100" Foreground="White"
             AllowDrop="True" Drop="View_Drop" DragOver="View_DragOver"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             PreviewKeyUp="UserControl_PreviewKeyUp"
             LostKeyboardFocus="UserControl_LostKeyboardFocus">
    <UserControl.Resources>
        <DrawingBrush x:Key="RemoveBackgroundCheckerboardBrush"
                      TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute"
                      Viewbox="0,0,18,18" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#18FFFFFF" Geometry="M0,0 H18 V18 H0 Z"/>
                    <GeometryDrawing Brush="#14000000"
                                     Geometry="M0,0 H9 V9 H0 Z M9,9 H18 V18 H9 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>


        <Style x:Key="CropCornerThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="White" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.75"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CropSideThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="White" BorderBrush="#333333" BorderThickness="1" CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.75"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Microsoft Photos-Style Navigation Host (Hit Area & Multiple-Image Gate) -->
        <Style x:Key="PhotosNavigationHostStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMultipleSiblingImages}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Mode Switcher -->
        <Grid x:Name="RemoveBackgroundHeader" Grid.Row="0" Margin="28,20,28,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnImageToolsRemoveBackground" Content="Remove Background"
                        MinWidth="154" Margin="0,0,8,0" Tag="RemoveBG"
                        ToolTip="Gunakan mode Remove Background"
                        Command="{Binding SelectModeCommand}" CommandParameter="RemoveBG">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundModernButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRemoveBgMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentRest}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnImageToolsUpscale" Content="AI Upscale"
                        MinWidth="132" Tag="Upscale"
                        ToolTip="Gunakan mode AI Upscale"
                        Command="{Binding SelectModeCommand}" CommandParameter="Upscale">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundModernButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpscaleMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentRest}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnImageToolsInpaint" Content="Object Removal"
                        MinWidth="142" Margin="8,0,0,0" Tag="Inpaint"
                        ToolTip="Gunakan mode Object Removal (Hapus Objek)"
                        Command="{Binding SelectModeCommand}" CommandParameter="Inpaint">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundModernButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInpaintMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentRest}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="28,0,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="440"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Preview Column -->
            <Border Grid.Column="0" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- DropZone (Empty State) -->
                    <Border x:Name="RemoveBackgroundDropZone" Grid.Row="0"
                            Background="{DynamicResource RemoveBackgroundCheckerboardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="2"
                            CornerRadius="12" Padding="30" AllowDrop="True" Drop="DropZone_Drop" DragOver="View_DragOver">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImageLoaded}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock services:NexusIcon.Glyph="ImageTools" FontSize="52" HorizontalAlignment="Center" Foreground="{DynamicResource NexusAccentPrimary}"/>
                            <TextBlock Text="{Binding DropZoneTitle}" Margin="0,16,0,4"
                                       FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding DropZoneSubtitle}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button x:Name="SelectImageButton" Content="Pilih Gambar"
                                    Margin="0,18,0,0" Padding="20,10"
                                    Command="{Binding SelectImageCommand}"
                                    Style="{StaticResource NexusPrimaryButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Image Preview Stage -->
                    <Grid x:Name="RemoveBackgroundPreview" Grid.Row="0"
                          Focusable="True" FocusVisualStyle="{x:Null}"
                          ClipToBounds="True" Background="{DynamicResource SurfaceSecondaryBrush}"
                          MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                          MouseMove="Preview_MouseMove"
                          MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                          MouseDown="Preview_MouseDown"
                          MouseUp="Preview_MouseUp"
                          LostMouseCapture="Preview_LostMouseCapture"
                          PreviewMouseWheel="Preview_PreviewMouseWheel"
                          SizeChanged="Preview_SizeChanged">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSingleImageMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border x:Name="RemoveBackgroundAfterSurface"
                                Background="{StaticResource RemoveBackgroundCheckerboardBrush}"/>
                        <Grid x:Name="RemoveBackgroundImageStage" Margin="4" ClipToBounds="False" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="{Binding RotationAngle}"/>
                                    <ScaleTransform ScaleX="{Binding ScaleX}" ScaleY="{Binding ScaleY}"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Image x:Name="ImgRemoveBackgroundAfter" Source="{Binding ResultImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="ImgRemoveBackgroundBefore"
                                   Source="{Binding BeforeImageSource, NotifyOnTargetUpdated=True}"
                                   Binding.TargetUpdated="ImgRemoveBackgroundBefore_TargetUpdated"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry x:Name="RemoveBackgroundBeforeClip" Rect="0,0,0,0"/>
                                </Image.Clip>
                            </Image>
                            <!-- Microsoft Photos MaskLayerVisualizationShader Parity Overlay Layer -->
                            <Image x:Name="RemoveBgRefineOverlay" Source="{Binding RemoveBgRefineOverlaySource}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IsRemoveBgRefining, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- Auto-Select Mask Overlay Layer -->
                            <Image x:Name="InpaintAutoMaskOverlay" Source="{Binding AutoMaskOverlaySource}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IsInpaintCanvasVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- Inpaint Mask Drawing Layer -->
                            <InkCanvas x:Name="InpaintMaskCanvas" Background="Transparent"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsMaskCanvasVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       PreviewMouseLeftButtonDown="InpaintMaskCanvas_PreviewMouseLeftButtonDown"
                                       PreviewMouseMove="InpaintMaskCanvas_PreviewMouseMove"
                                       MouseEnter="InpaintMaskCanvas_MouseEnter"
                                       MouseLeave="InpaintMaskCanvas_MouseLeave"
                                       StrokeCollected="InpaintMaskCanvas_StrokeCollected"
                                       StrokeErased="InpaintMaskCanvas_StrokeErased"/>
                            <!-- Visual Brush Cursor Ring (Zoom-consistent parity with Microsoft Photos) -->
                            <Canvas x:Name="BrushCursorCanvas" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="BrushCursorRing" IsHitTestVisible="False"
                                         Stroke="White" StrokeThickness="1.5"
                                         Visibility="Collapsed">
                                     <Ellipse.Effect>
                                         <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.85"/>
                                     </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                            <!-- Native WPF Image Processing Scanner (Apple-Inspired Motion) -->
                            <controls:ImageProcessingScanner x:Name="ImageScanner"
                                                             Panel.ZIndex="100"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             IsActive="{Binding IsProcessing}"
                                                             ScannerMode="{Binding ActiveScannerMode}"/>

                            <!-- In-Stage OCR Overlay Boxes & Word Quads (Interactive word selection matching Microsoft Photos) -->
                            <Viewbox x:Name="OcrOverlayViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsHitTestVisible="{Binding HasOverlayBoxes}"
                                     Visibility="{Binding HasOverlayBoxes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Canvas x:Name="OcrOverlayCanvas" Width="{Binding OriginalImageWidth}" Height="{Binding OriginalImageHeight}"
                                        Background="Transparent"
                                        Focusable="True"
                                        MouseMove="OcrOverlayCanvas_MouseMove"
                                        MouseLeftButtonDown="OcrOverlayCanvas_MouseLeftButtonDown"
                                        MouseLeftButtonUp="OcrOverlayCanvas_MouseLeftButtonUp"
                                        MouseLeave="OcrOverlayCanvas_MouseLeave"
                                        KeyDown="OcrOverlayCanvas_KeyDown">
                                    <!-- Compositor parity: even-odd dark scrim cutout mask (outer image rect - inner OCR word quads) -->
                                    <Path Fill="#75000000" Data="{Binding OcrMaskGeometry}" IsHitTestVisible="False"/>

                                    <!-- Photos-style Unified Contiguous Selection Highlight Layer -->
                                    <Path Data="{Binding OcrSelectionGeometry}"
                                          Fill="#800078D4"
                                          Stroke="#D00078D4"
                                          StrokeThickness="1.2"
                                          IsHitTestVisible="False"/>

                                    <!-- OneOCR True Word Quad Highlights -->
                                    <ItemsControl ItemsSource="{Binding OcrWords}"
                                                  Width="{Binding OriginalImageWidth}" Height="{Binding OriginalImageHeight}"
                                                  IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="{Binding OriginalImageWidth}" Height="{Binding OriginalImageHeight}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Path Data="{Binding PolygonGeometry}"
                                                      Fill="{Binding HoverBackgroundBrush}"
                                                      Stroke="{Binding HoverBorderBrush}"
                                                      StrokeThickness="1.0"
                                                      Visibility="{Binding IsHoverOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      ToolTip="{Binding TooltipText}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <!-- Microsoft Photos Style Crop Overlay Layer (Viewport-Aligned) -->
                        <Canvas x:Name="CropCanvas"
                                Panel.ZIndex="150"
                                Visibility="{Binding IsCropActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ClipToBounds="True">
                            <!-- 4 Dark Scrim Borders -->
                            <Border x:Name="CropScrimTop" Background="#80000000"/>
                            <Border x:Name="CropScrimBottom" Background="#80000000"/>
                            <Border x:Name="CropScrimLeft" Background="#80000000"/>
                            <Border x:Name="CropScrimRight" Background="#80000000"/>

                            <!-- Active Crop Selection Rectangle -->
                            <Border x:Name="CropSelectionFrame"
                                    BorderBrush="White" BorderThickness="1"
                                    Background="#01000000">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.8"/>
                                </Border.Effect>
                                <!-- Rule of Thirds Grid Lines -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#50FFFFFF" BorderThickness="1,0,1,0"/>
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#50FFFFFF" BorderThickness="0,1,0,1"/>
                                </Grid>
                            </Border>

                            <!-- 8 Drag Thumbs -->
                            <Thumb x:Name="ThumbCropTop" Style="{StaticResource CropSideThumbStyle}" Cursor="SizeNS" DragDelta="CropThumb_DragDelta"/>
                            <Thumb x:Name="ThumbCropBottom" Style="{StaticResource CropSideThumbStyle}" Cursor="SizeNS" DragDelta="CropThumb_DragDelta"/>
                            <Thumb x:Name="ThumbCropLeft" Style="{StaticResource CropSideThumbStyle}" Cursor="SizeWE" DragDelta="CropThumb_DragDelta"/>
                            <Thumb x:Name="ThumbCropRight" Style="{StaticResource CropSideThumbStyle}" Cursor="SizeWE" DragDelta="CropThumb_DragDelta"/>
                            <Thumb x:Name="ThumbCropUpperLeft" Style="{StaticResource CropCornerThumbStyle}" Cursor="SizeNWSE" DragDelta="CropThumb_DragDelta"/>
                            <Thumb x:Name="ThumbCropUpperRight" Style="{StaticResource CropCornerThumbStyle}" Cursor="SizeNESW" DragDelta="CropThumb_DragDelta"/>
                            <Thumb x:Name="ThumbCropLowerLeft" Style="{StaticResource CropCornerThumbStyle}" Cursor="SizeNESW" DragDelta="CropThumb_DragDelta"/>
                            <Thumb x:Name="ThumbCropLowerRight" Style="{StaticResource CropCornerThumbStyle}" Cursor="SizeNWSE" DragDelta="CropThumb_DragDelta"/>
                        </Canvas>

                        <!-- Floating AI Processing Status Pill (Exact parity with AiCheck) -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                                Panel.ZIndex="200"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="18" Padding="14,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.25"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Control Template="{StaticResource NexusModernRingSpinnerTemplate}" Width="16" Height="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Floating OCR Action Toolbar (Microsoft Photos Scan Text Parity) -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                                Panel.ZIndex="250"
                                Visibility="{Binding HasOverlayBoxes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="18" Padding="10,6"
                                Effect="{StaticResource RemoveBackgroundToolbarShadow}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock services:NexusIcon.Glyph="ScanText" FontSize="14" Foreground="{DynamicResource NexusAccentPrimary}"
                                           VerticalAlignment="Center" Margin="6,0,10,0"/>

                                 <!-- Copy Selected Button -->
                                <Button Style="{StaticResource NexusButtonStyle}"
                                        Command="{Binding CopySelectedOcrTextCommand}"
                                        IsEnabled="{Binding HasSelectedOcrBoxes}"
                                        ToolTip="Salin Teks dari Area Terpilih" Height="30" Padding="10,0" Margin="2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock services:NexusIcon.Glyph="Copy" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Salin Terpilih" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Copy All Button (Adobe Express Mode) -->
                                <Button Style="{StaticResource NexusButtonStyle}"
                                        Command="{Binding CopyAllOcrTextCommand}"
                                        ToolTip="Salin Seluruh Teks Terdeteksi" Height="30" Padding="10,0" Margin="2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock services:NexusIcon.Glyph="Copy" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Salin Semua" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Border Width="1" Height="16" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}"/>

                                <!-- Close OCR Overlay -->
                                <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                        Command="{Binding CloseOcrCommand}"
                                        ToolTip="Tutup Pemindaian Teks" Width="28" Height="28">
                                    <TextBlock services:NexusIcon.Glyph="Close" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Top Floating Editing Toolbar (Mask Refinement & Crop Entry with Microsoft Photos Transforms) -->
                        <Border x:Name="TopFloatingEditingToolbar"
                                Panel.ZIndex="300"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                                Padding="8,6" CornerRadius="16"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Effect="{StaticResource RemoveBackgroundToolbarShadow}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSingleImageMode}" Value="True"/>
                                                <Condition Binding="{Binding IsInpaintMode}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 1. Toggle Refine Brush Button (Available in RemoveBg mode with result, hidden when Crop active) -->
                                <Button x:Name="BtnToggleRefine"
                                        ToolTip="Perbaiki Mask (Kuas Refinement)"
                                        Command="{Binding ToggleRemoveBgRefiningCommand}">
                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                        <TextBlock services:NexusIcon.Glyph="Brush" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Perbaiki Mask" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NexusButtonStyle}">
                                            <Setter Property="Height" Value="34"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRemoveBgMode}" Value="True"/>
                                                        <Condition Binding="{Binding HasResult}" Value="True"/>
                                                        <Condition Binding="{Binding IsCropActive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsRemoveBgRefining}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentRest}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Extended Refinement Tools Panel (Only Visible When Refining) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsRemoveBgRefining, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}"/>

                                    <!-- Add Mask Mode -->
                                    <Button x:Name="BtnRemoveBgAddMask" ToolTip="Tambah Mask (Pulihkan Bagian Gambar)"
                                            Command="{Binding SetRemoveBgAddModeCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+" FontSize="15" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundToolbarButtonStyle}">
                                                <Setter Property="Width" Value="58"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRemoveBgAddMode}" Value="True">
                                                        <Setter Property="Background" Value="#2510B981"/>
                                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Remove Mask Mode -->
                                    <Button x:Name="BtnRemoveBgRemoveMask" ToolTip="Hapus Mask (Hapus Bagian Gambar)"
                                            Command="{Binding SetRemoveBgRemoveModeCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="-" FontSize="16" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                            <TextBlock Text="Erase" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundToolbarButtonStyle}">
                                                <Setter Property="Width" Value="62"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRemoveBgAddMode}" Value="False">
                                                        <Setter Property="Background" Value="#25EF4444"/>
                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Divider -->
                                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}"/>

                                    <!-- Brush Size Slider -->
                                    <TextBlock Text="Size" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <Slider Width="75" Minimum="5" Maximum="200" Value="{Binding BrushSize, Mode=TwoWay}"
                                            TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                            Style="{StaticResource NexusSliderStyle}"
                                            ToolTip="Ukuran Kuas (Image Pixels)"/>
                                    <Border MinWidth="40" Height="24" Margin="3,0,3,0" Padding="4,0"
                                            CornerRadius="12" Background="{DynamicResource SurfaceSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding BrushSize, StringFormat={}{0:0}px}"
                                                   VerticalAlignment="Center" TextAlignment="Center" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>

                                    <!-- Brush Softness Slider (Microsoft Photos Parity) -->
                                    <TextBlock Text="Softness" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <Slider Width="70" Minimum="0" Maximum="1" Value="{Binding BrushSoftness, Mode=TwoWay}"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                            Style="{StaticResource NexusSliderStyle}"
                                            ToolTip="Kelembutan Kuas (0% = Tajam, 100% = Halus)"/>
                                    <Border MinWidth="36" Height="24" Margin="3,0,3,0" Padding="3,0"
                                            CornerRadius="12" Background="{DynamicResource SurfaceSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding BrushSoftness, StringFormat={}{0:P0}}"
                                                   VerticalAlignment="Center" TextAlignment="Center" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>

                                    <!-- Divider -->
                                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}"/>

                                    <!-- Undo -->
                                    <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Command="{Binding UndoRemoveBgRefinementCommand}" ToolTip="Urungkan Refinement">
                                        <TextBlock services:NexusIcon.Glyph="Undo" FontSize="15"/>
                                    </Button>

                                    <!-- Redo -->
                                    <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Command="{Binding RedoRemoveBgRefinementCommand}" ToolTip="Ulangi Refinement">
                                        <TextBlock services:NexusIcon.Glyph="Redo" FontSize="15"/>
                                    </Button>

                                    <!-- Reset to AI Baseline -->
                                    <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Command="{Binding ResetRemoveBgRefinementCommand}" ToolTip="Reset ke Mask AI Asli (Tanpa Inference Ulang)">
                                        <TextBlock services:NexusIcon.Glyph="Refresh" FontSize="15" Foreground="#F59E0B"/>
                                    </Button>
                                </StackPanel>

                                <!-- Divider between Refine and Crop when both are idle -->
                                <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRemoveBgMode}" Value="True"/>
                                                        <Condition Binding="{Binding HasResult}" Value="True"/>
                                                        <Condition Binding="{Binding IsRemoveBgRefining}" Value="False"/>
                                                        <Condition Binding="{Binding IsCropActive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- 2. Toggle Crop Entry Button (Hidden when Mask Refining is active) -->
                                <Button x:Name="BtnToggleCrop"
                                        ToolTip="Crop &amp; Orientasi"
                                        Command="{Binding ToggleCropCommand}">
                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                        <TextBlock services:NexusIcon.Glyph="Cut" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Crop" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NexusButtonStyle}">
                                            <Setter Property="Height" Value="34"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoveBgRefining}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCropActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentRest}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Transform & Crop Controls Panel (Revealed When Crop Entry Active) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsCropActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}"/>

                                    <!-- Rotate Left 90° -->
                                    <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Command="{Binding RotateLeftCommand}" ToolTip="Putar Kiri 90°">
                                        <TextBlock Text="&#x21BA;" FontSize="15" FontWeight="Bold"/>
                                    </Button>

                                    <!-- Rotate Right 90° -->
                                    <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Command="{Binding RotateRightCommand}" ToolTip="Putar Kanan 90°">
                                        <TextBlock Text="&#x21BB;" FontSize="15" FontWeight="Bold"/>
                                    </Button>

                                    <!-- Flip Horizontal -->
                                    <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Command="{Binding FlipHorizontalCommand}" ToolTip="Balik Horizontal">
                                        <TextBlock Text="&#x21F9;" FontSize="15" FontWeight="Bold"/>
                                    </Button>

                                    <!-- Flip Vertical -->
                                    <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Command="{Binding FlipVerticalCommand}" ToolTip="Balik Vertikal">
                                        <TextBlock Text="&#x21F3;" FontSize="15" FontWeight="Bold"/>
                                    </Button>

                                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}"/>

                                    <!-- Aspect Ratio Buttons -->
                                    <Button x:Name="BtnAspectFree" Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Click="BtnAspect_Click" Tag="Free" ToolTip="Rasio Bebas">
                                        <TextBlock Text="Bebas" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="BtnAspect1x1" Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Click="BtnAspect_Click" Tag="1:1" ToolTip="Rasio 1:1 (Persegi)">
                                        <TextBlock Text="1:1" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="BtnAspect4x3" Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Click="BtnAspect_Click" Tag="4:3" ToolTip="Rasio 4:3">
                                        <TextBlock Text="4:3" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="BtnAspect16x9" Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Click="BtnAspect_Click" Tag="16:9" ToolTip="Rasio 16:9">
                                        <TextBlock Text="16:9" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>

                                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}"/>

                                    <!-- Reset Crop Area -->
                                    <Button x:Name="BtnResetCropArea" Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Click="BtnResetCropArea_Click" ToolTip="Reset Area Potong">
                                        <TextBlock services:NexusIcon.Glyph="Reset" FontSize="13" Foreground="#F59E0B"/>
                                    </Button>

                                    <!-- Apply Crop Button -->
                                    <Button x:Name="BtnApplyCrop" Style="{StaticResource NexusPrimaryButtonStyle}"
                                            Click="BtnApplyCrop_Click" ToolTip="Terapkan Potong Gambar" Margin="4,0,2,0"
                                            Height="32" Padding="8,0">
                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                            <TextBlock services:NexusIcon.Glyph="Check" FontSize="13" Foreground="{DynamicResource NexusForegroundOnAccent}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Terapkan" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource NexusForegroundOnAccent}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Cancel Crop Button -->
                                    <Button x:Name="BtnCancelCrop" Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                            Click="BtnCancelCrop_Click" ToolTip="Batal Potong" Margin="2,0,0,0">
                                        <TextBlock services:NexusIcon.Glyph="Close" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Floating Inpaint Toolbar -->
                        <Border x:Name="InpaintFloatingToolbar"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                                Padding="8,6" CornerRadius="16"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Effect="{StaticResource RemoveBackgroundToolbarShadow}"
                                Visibility="{Binding IsInpaintCanvasVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Auto-Select Button (MobileSAM) -->
                                <Button x:Name="BtnInpaintAutoSelect" ToolTip="Auto-Select Objek (Klik Objek untuk Memilih Otomatis)"
                                        Command="{Binding SetAutoSelectModeCommand}"
                                        Visibility="{Binding IsAutoSelectAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock services:NexusIcon.Glyph="AutoSelect" FontSize="15"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundToolbarButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoSelectMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Brush Button -->
                                <Button x:Name="BtnInpaintBrush" ToolTip="Kuas (Gambar Mask)"
                                        Command="{Binding SetBrushModeCommand}">
                                    <TextBlock services:NexusIcon.Glyph="Brush" FontSize="15"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundToolbarButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBrushMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Eraser Button -->
                                <Button x:Name="BtnInpaintEraser" ToolTip="Penghapus Coretan"
                                        Command="{Binding SetEraserModeCommand}">
                                    <TextBlock services:NexusIcon.Glyph="Eraser" FontSize="15"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundToolbarButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEraserMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Divider -->
                                <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}"/>

                                <!-- Brush Size Slider -->
                                <TextBlock services:NexusIcon.Glyph="Size" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="4,0,2,0"/>
                                <Slider Width="90" Minimum="5" Maximum="150" Value="{Binding BrushSize, Mode=TwoWay}"
                                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                        Style="{StaticResource NexusSliderStyle}"
                                        ToolTip="Ukuran Kuas"/>
                                <Border MinWidth="44" Height="26" Margin="6,0,4,0" Padding="6,0"
                                        CornerRadius="13" Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding BrushSize, StringFormat={}{0:0}px}"
                                               VerticalAlignment="Center" TextAlignment="Center" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>

                                <!-- Divider -->
                                <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource BorderSubtleBrush}"/>

                                <!-- Undo -->
                                <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                        Command="{Binding UndoMaskCommand}" ToolTip="Urungkan Coretan">
                                    <TextBlock services:NexusIcon.Glyph="Undo" FontSize="15"/>
                                </Button>

                                <!-- Redo -->
                                <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                        Command="{Binding RedoMaskCommand}" ToolTip="Ulangi Coretan">
                                    <TextBlock services:NexusIcon.Glyph="Redo" FontSize="15"/>
                                </Button>

                                <!-- Clear All Strokes -->
                                <Button Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                        Command="{Binding ClearMaskCommand}" ToolTip="Hapus Semua Coretan">
                                    <TextBlock services:NexusIcon.Glyph="Delete" FontSize="15" Foreground="#EF4444"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Before/After Split Comparison Thumb -->
                        <Thumb x:Name="ThumbRemoveBackgroundCompare" Width="24" HorizontalAlignment="Left"
                               VerticalAlignment="Stretch" Cursor="SizeWE" DragDelta="ThumbCompare_DragDelta"
                               Visibility="{Binding IsCompareActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid Background="Transparent" ClipToBounds="False">
                                        <Border Width="1" Background="{DynamicResource NexusComparisonDivider}" HorizontalAlignment="Center"/>
                                        <Border Width="20" Height="28" CornerRadius="10"
                                                Background="{DynamicResource NexusComparisonHandle}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock services:NexusIcon.Glyph="ChevronLeft"
                                                           FontSize="8" Foreground="{DynamicResource NexusComparisonGlyph}" HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                <TextBlock services:NexusIcon.Glyph="ChevronRight"
                                                           FontSize="8" Foreground="{DynamicResource NexusComparisonGlyph}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            </Grid>
                                        </Border>
                                        <Canvas x:Name="RemoveBackgroundCompareBadges" ClipToBounds="False" IsHitTestVisible="False">
                                            <Border Canvas.Left="-58" Canvas.Top="12" Padding="10,5" CornerRadius="11"
                                                    Background="{DynamicResource SurfacePrimaryBrush}" Opacity="0.92"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                <TextBlock Text="BEFORE" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <Border Canvas.Left="30" Canvas.Top="12" Padding="10,5" CornerRadius="11"
                                                    Background="{DynamicResource SurfacePrimaryBrush}" Opacity="0.92"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                <TextBlock Text="AFTER" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <!-- Microsoft Photos-Style Previous / Next Navigation Overlay Buttons -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="16,0,0,0" Panel.ZIndex="120"
                                Style="{StaticResource PhotosNavigationHostStyle}">
                            <Button Style="{StaticResource PhotosNavigationButtonStyle}"
                                    Command="{Binding NavigatePreviousImageCommand}"
                                    ToolTip="Foto Sebelumnya">
                                <TextBlock services:NexusIcon.Glyph="ChevronLeft"
                                           FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,16,0" Panel.ZIndex="120"
                                Style="{StaticResource PhotosNavigationHostStyle}">
                            <Button Style="{StaticResource PhotosNavigationButtonStyle}"
                                    Command="{Binding NavigateNextImageCommand}"
                                    ToolTip="Foto Berikutnya">
                                <TextBlock services:NexusIcon.Glyph="ChevronRight"
                                           FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Border>

                    </Grid>

                    <!-- Multi-Image Batch Cards Grid -->
                    <ScrollViewer x:Name="BatchScrollViewer" Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" BorderThickness="0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInpaintMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <WrapPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding BatchItems}" BorderThickness="0" Background="Transparent">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="190" Height="230" Margin="0,0,16,16"
                                                Style="{StaticResource NexusCardStyle}" Padding="0" CornerRadius="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="145"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Thumbnail Area with True Aspect Ratio (Stretch="Uniform") -->
                                                <Border Grid.Row="0" CornerRadius="14,14,0,0" ClipToBounds="True"
                                                        Background="{StaticResource RemoveBackgroundCheckerboardBrush}">
                                                    <Grid>
                                                        <Image Source="{Binding DisplayImage}" Stretch="Uniform"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>

                                                        <!-- Processing Spinner Overlay -->
                                                        <Border Background="#A0000000"
                                                                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Control Template="{StaticResource NexusModernRingSpinnerTemplate}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Memproses AI..." FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Completed Badge -->
                                                        <Border Background="#D010B981" CornerRadius="10" Padding="6,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                                Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock services:NexusIcon.Glyph="Check" FontSize="11" Foreground="White" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Selesai" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Failed Badge -->
                                                        <Border Background="#D0EF4444" CornerRadius="10" Padding="6,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                                Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock services:NexusIcon.Glyph="Error" FontSize="11" Foreground="White" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Gagal" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Soft Delete Button Overlay (Top Right) -->
                                                        <Button Style="{StaticResource NexusSoftDeleteIconButtonStyle}"
                                                                Command="{Binding DataContext.RemoveBatchItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}"
                                                                Width="32" Height="32" Padding="0"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                                ToolTip="Hapus dari antrean"
                                                                Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock services:NexusIcon.Glyph="Delete" FontSize="13"
                                                                       Foreground="{DynamicResource NexusSoftDeleteForeground}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- File Metadata & Status -->
                                                <StackPanel Grid.Row="1" Margin="12,8,12,10" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding SizeText}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusForeground}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add More Button (+) -->
                            <Button ToolTip="Tambah Gambar (Maks 10)"
                                    Command="{Binding AddMoreBatchImagesCommand}"
                                    Width="48" Height="48" Margin="0,0,0,16"
                                    Style="{StaticResource NexusToolbarButtonStyle}"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding CanAddBatchImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock services:NexusIcon.Glyph="Add" FontSize="20"
                                           Foreground="{DynamicResource NexusAccentPrimary}"/>
                            </Button>
                        </WrapPanel>
                    </ScrollViewer>

                    <!-- 3-Zone Bottom Floating Bar (Adobe Express Inspired) -->
                    <Grid x:Name="PreviewToolbar" Grid.Row="1" Margin="0,12,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoImages}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Zone 1 (Left): Filmstrip & OCR -->
                        <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Padding="6,5" CornerRadius="22"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Effect="{StaticResource RemoveBackgroundToolbarShadow}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Filmstrip Toggle -->
                                <Button x:Name="BtnToggleFilmstrip" ToolTip="Tampilkan/Sembunyikan Filmstrip Folder"
                                        Command="{Binding ToggleFilmstripCommand}">
                                    <TextBlock services:NexusIcon.Glyph="Filmstrip" FontSize="15"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundToolbarButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilmstripVisible}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentRest}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- OCR Copy Text -->
                                <Button x:Name="BtnCopyTextOcr" ToolTip="Salin Teks Gambar (OCR)"
                                        Command="{Binding CopyTextOcrCommand}"
                                        Style="{StaticResource RemoveBackgroundToolbarButtonStyle}">
                                    <TextBlock services:NexusIcon.Glyph="ScanText" FontSize="15"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Zone 2 (Center): Zoom, Compare, Primary Action, RESET -->
                        <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Padding="8,6" CornerRadius="24"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Effect="{StaticResource RemoveBackgroundToolbarShadow}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ZoomOutButton" IsEnabled="{Binding IsSingleImageMode}"
                                        Command="{Binding ZoomOutCommand}"
                                        Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                        ToolTip="Perkecil">
                                    <TextBlock services:NexusIcon.Glyph="ZoomOut" FontSize="15"/>
                                </Button>
                                <Slider x:Name="ZoomSlider" Width="100" Minimum="50" Maximum="1000" Value="{Binding ZoomLevel, Mode=TwoWay}"
                                        TickFrequency="25" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"
                                        IsEnabled="{Binding IsSingleImageMode}"
                                        ToolTip="Zoom 50%–1000%"
                                        Margin="6,0"
                                        Style="{StaticResource NexusSliderStyle}"/>
                                <Button x:Name="ZoomInButton" IsEnabled="{Binding IsSingleImageMode}"
                                        Command="{Binding ZoomInCommand}"
                                        Style="{StaticResource RemoveBackgroundToolbarButtonStyle}"
                                        ToolTip="Perbesar">
                                    <TextBlock services:NexusIcon.Glyph="Zoom" FontSize="15"/>
                                </Button>
                                <Border MinWidth="48" Height="28" Margin="4,0,8,0" Padding="6,0"
                                        CornerRadius="14" Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <TextBlock x:Name="ZoomLevelTextBlock" Text="{Binding ZoomText}"
                                               VerticalAlignment="Center" TextAlignment="Center" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>

                                <Border Width="1" Height="20" Margin="0,0,6,0"
                                        Background="{DynamicResource BorderSubtleBrush}"/>

                                <Button x:Name="CompareButton" IsEnabled="{Binding IsSingleImageMode}"
                                        Command="{Binding ToggleCompareCommand}"
                                        ToolTip="Bandingkan Sebelum dan Sesudah">
                                    <TextBlock services:NexusIcon.Glyph="Compare" FontSize="15"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RemoveBackgroundToolbarButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompareActive}" Value="True">
                                                    <Setter Property="Tag" Value="Active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Border Width="1" Height="20" Margin="6,0"
                                        Background="{DynamicResource BorderSubtleBrush}"/>

                                <!-- Primary Action Button -->
                                <Button x:Name="PrimaryActionButton"
                                        Command="{Binding ExecutePrimaryActionCommand}"
                                        ToolTip="{Binding PrimaryActionToolTip}"
                                        Style="{StaticResource NexusPrimaryButtonStyle}"
                                        Height="34" Padding="12,0" Margin="2,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock services:NexusIcon.Glyph="{Binding PrimaryActionIcon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PrimaryActionButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- CLEAR Button -->
                                <Button x:Name="ClearImageButton"
                                        Command="{Binding ClearImageCommand}"
                                        ToolTip="Clear Gambar dari Workspace"
                                        Style="{StaticResource NexusSecondaryButtonStyle}"
                                        Height="34" Padding="10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock services:NexusIcon.Glyph="Delete" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        <TextBlock Text="CLEAR" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Zone 3 (Right): Preferences Pill -->
                        <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Padding="6,5" CornerRadius="22"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Effect="{StaticResource RemoveBackgroundToolbarShadow}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="CanvasBackgroundComboBox" SelectedIndex="{Binding SelectedPreviewBackgroundIndex, Mode=TwoWay}" IsEnabled="{Binding IsImageLoaded}"
                                          Margin="2,0,4,0" ToolTip="Latar Preview" SelectionChanged="CanvasBackgroundComboBox_SelectionChanged"
                                          Style="{StaticResource NexusBackgroundComboBoxStyle}">
                                    <ComboBoxItem Content="Checkerboard"/>
                                    <ComboBoxItem Content="Putih"/>
                                    <ComboBoxItem Content="Hitam"/>
                                </ComboBox>
                                <Button x:Name="OpenOutputFolderButton"
                                        Command="{Binding OpenOutputFolderCommand}"
                                        IsEnabled="{Binding IsOpenFolderEnabled}"
                                        Style="{StaticResource NexusSoftFolderIconButtonStyle}"
                                        Width="36" Height="36" Margin="2,0"
                                        ToolTip="Buka Folder Output">
                                    <TextBlock services:NexusIcon.Glyph="FolderOpen" FontSize="15"
                                               Foreground="{DynamicResource NexusSoftFolderForeground}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Column Settings Panel -->
            <Border x:Name="ImageToolsSettingsPanel" Grid.Column="2" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="20" Effect="{StaticResource RemoveBackgroundToolbarShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource SurfaceSecondaryBrush}">
                                <TextBlock services:NexusIcon.Glyph="Settings" FontSize="15" Foreground="{DynamicResource NexusAccentPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pengaturan" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="11,0,0,0"/>
                        </StackPanel>

                        <!-- Remove Background Settings -->
                        <StackPanel x:Name="PanelImageToolsRemoveBackgroundSettings" Visibility="{Binding IsRemoveBgMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Format Output" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border Margin="0,7,0,17" Padding="12,10" CornerRadius="11"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <TextBlock Text="PNG (Transparan)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>

                            <TextBlock Text="Preset Kualitas" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="OutputQualityComboBox" Margin="0,7,0,17" SelectedIndex="{Binding SelectedQualityIndex, Mode=TwoWay}"
                                      Style="{StaticResource NexusComboBoxStyle}">
                                <ComboBoxItem Content="Lite"/>
                                <ComboBoxItem Content="Balanced"/>
                                <ComboBoxItem Content="High Quality"/>
                            </ComboBox>

                            <TextBlock Text="Resolusi" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border Margin="0,7,0,17" Padding="12,10" CornerRadius="11"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <TextBlock Text="Resolusi Asli" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- AI Upscale Settings -->
                        <StackPanel x:Name="PanelImageToolsUpscaleSettings" Visibility="{Binding IsUpscaleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Model AI" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border Margin="0,7,0,17" Padding="12,10" CornerRadius="11"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <TextBlock Text="RealESRGAN General WDN x4 v3"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>

                            <TextBlock Text="{Binding UpscaleScale, StringFormat=Skala Gambar ({0:0}×)}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border Margin="0,7,0,17" Padding="10,2" CornerRadius="11"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <Slider Minimum="1" Maximum="10" Value="{Binding UpscaleScale, Mode=TwoWay}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                        Margin="8,0"
                                        Style="{StaticResource NexusSliderStyle}"/>
                            </Border>

                            <!-- Color Space -->
                            <TextBlock Text="Ruang Warna" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,17">
                                <RadioButton x:Name="RadioColorSpaceRgb" Style="{StaticResource NexusRadioButtonStyle}"
                                             GroupName="ColorSpace" IsChecked="{Binding IsRgbColorSpace, Mode=TwoWay}"
                                             FontSize="12" Margin="0,0,16,0"
                                             Foreground="{DynamicResource NexusBrushTextPrimary}">
                                    <TextBlock Text="RGB" VerticalAlignment="Center"/>
                                </RadioButton>
                                <RadioButton x:Name="RadioColorSpaceCmyk" Style="{StaticResource NexusRadioButtonStyle}"
                                             GroupName="ColorSpace" IsChecked="{Binding IsCmykColorSpace, Mode=TwoWay}"
                                             FontSize="12"
                                             Foreground="{DynamicResource NexusBrushTextPrimary}">
                                    <TextBlock Text="CMYK" VerticalAlignment="Center"/>
                                </RadioButton>
                            </StackPanel>

                            <!-- Format Output -->
                            <TextBlock Text="Format Output" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableOutputFormats}"
                                      SelectedItem="{Binding OutputFormat, Mode=TwoWay}"
                                      Margin="0,7,0,17"
                                      Style="{StaticResource NexusComboBoxStyle}"/>

                            <!-- CMYK Info Box (visible only when CMYK selected) -->
                            <Border x:Name="CmykInfoBox" Margin="0,0,0,17" Padding="12,10" CornerRadius="11"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource NexusBrushStatusInfo}" BorderThickness="1"
                                    Visibility="{Binding IsCmykColorSpace, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveCmykProfileText}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource NexusBrushTextPrimary}"/>
                                    <TextBlock Text="TIFF dengan profil ICC tertanam · Ubah profil di Settings" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Object Removal / Inpaint Settings -->
                        <StackPanel x:Name="PanelImageToolsInpaintSettings" Visibility="{Binding IsInpaintMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Model Inpainting" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border Margin="0,7,0,17" Padding="12,10" CornerRadius="11"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding SelectedInpaintModelDisplayName}"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>

                            <TextBlock Text="Kualitas Rekonstruksi" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border Margin="0,7,0,17" Padding="14,12" CornerRadius="11"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel>
                                    <CheckBox Content="Mode Detail Tinggi"
                                              IsChecked="{Binding IsHighDetailMode, Mode=TwoWay}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Gunakan dual-pass blending (65% crop lokal + 35% global) untuk menjaga detail tekstur tajam pada resolusi tinggi."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="22,6,0,0" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <!-- Format Output -->
                            <TextBlock Text="Format Output" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableOutputFormats}"
                                      SelectedItem="{Binding OutputFormat, Mode=TwoWay}"
                                      Margin="0,7,0,17"
                                      Style="{StaticResource NexusComboBoxStyle}"/>
                        </StackPanel>

                        <!-- Output Folder Selection -->
                        <TextBlock Text="Folder Output" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid Margin="0,7,0,17">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputPath, Mode=TwoWay}" IsReadOnly="True"
                                     Style="{StaticResource NexusTextBoxStyle}"/>
                            <Button Grid.Column="1" Margin="8,0,0,0"
                                    Command="{Binding BrowseOutputFolderCommand}" ToolTip="Pilih Folder Output"
                                    Style="{StaticResource NexusToolbarButtonStyle}">
                                <TextBlock services:NexusIcon.Glyph="Folder" FontSize="16"/>
                            </Button>
                        </Grid>

                        <!-- Advanced Settings Expander -->
                        <Expander Header="Pengaturan Lanjutan" IsExpanded="False"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel Visibility="{Binding IsRemoveBgMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Lite Model Slot" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SlotLitePath, Mode=TwoWay}" IsReadOnly="True"
                                                 Style="{StaticResource NexusTextBoxStyle}"/>
                                        <Button Grid.Column="1" Margin="6,0,0,0"
                                                Command="{Binding BrowseSlotLiteCommand}" ToolTip="Cari folder model untuk slot Lite"
                                                Style="{StaticResource NexusToolbarButtonStyle}">
                                            <TextBlock services:NexusIcon.Glyph="Folder" FontSize="16"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="Balanced Model Slot" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SlotBalancedPath, Mode=TwoWay}" IsReadOnly="True"
                                                 Style="{StaticResource NexusTextBoxStyle}"/>
                                        <Button Grid.Column="1" Margin="6,0,0,0"
                                                Command="{Binding BrowseSlotBalancedCommand}" ToolTip="Cari folder model untuk slot Balanced"
                                                Style="{StaticResource NexusToolbarButtonStyle}">
                                            <TextBlock services:NexusIcon.Glyph="Folder" FontSize="16"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="High Quality Model Slot" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SlotHighQualityPath, Mode=TwoWay}" IsReadOnly="True"
                                                 Style="{StaticResource NexusTextBoxStyle}"/>
                                        <Button Grid.Column="1" Margin="6,0,0,0"
                                                Command="{Binding BrowseSlotHighQualityCommand}" ToolTip="Cari folder model untuk slot High Quality"
                                                Style="{StaticResource NexusToolbarButtonStyle}">
                                            <TextBlock services:NexusIcon.Glyph="Folder" FontSize="16"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsUpscaleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Model AI aktif" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Border Margin="0,7,0,6" Padding="12,10" CornerRadius="11"
                                            Background="{DynamicResource SurfaceSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <TextBlock Text="RealESRGAN General WDN x4 v3"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsInpaintMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Model Inpainting" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding AvailableInpaintModels}"
                                                  SelectedItem="{Binding SelectedInpaintModel, Mode=TwoWay}"
                                                  Style="{StaticResource NexusComboBoxStyle}"/>
                                        <Button Grid.Column="1" Margin="6,0,0,0"
                                                Command="{Binding BrowseInpaintModelCommand}" ToolTip="Cari folder model inpainting eksternal"
                                                Style="{StaticResource NexusToolbarButtonStyle}">
                                            <TextBlock services:NexusIcon.Glyph="Folder" FontSize="16"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Folder Filmstrip Bar (Row 2, Height: 92px, Items: 108x72 - 3:2 Ratio) -->
        <Border x:Name="FolderFilmstripBar" Grid.Row="2" Margin="28,0,28,16" Padding="12,6" Height="92"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14"
                Effect="{StaticResource RemoveBackgroundToolbarShadow}"
                Visibility="{Binding IsFilmstripVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock services:NexusIcon.Glyph="Filmstrip" FontSize="16" Foreground="{DynamicResource NexusAccentPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="Folder" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <ListBox Grid.Column="1"
                         ItemsSource="{Binding SiblingImages}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4,0" Padding="0" Width="108" Height="72"
                                    Command="{Binding DataContext.SelectSiblingImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Name}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NexusToolbarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentRest}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" Margin="4"/>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </Border>

        <!-- Mode Switch Overlay Modal -->
        <Grid x:Name="ImageToolsModeSwitchOverlay" Grid.RowSpan="3" Panel.ZIndex="100"
              Visibility="{Binding IsModeSwitchOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="Black" Opacity="0.46"/>
            <Border Width="430" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="18" Effect="{StaticResource RemoveBackgroundToolbarShadow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource SurfaceSecondaryBrush}">
                            <TextBlock services:NexusIcon.Glyph="Warning" FontSize="17" Foreground="{DynamicResource NexusAccentPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ganti Mode" Margin="12,0,0,0" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Workspace saat ini masih berisi gambar."
                               Margin="0,20,0,0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Jika berpindah ke mode lain,&#x0a;gambar dan hasil AI akan dihapus."
                               Margin="0,8,0,0" FontSize="13" LineHeight="20"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Batal" MinWidth="94" Margin="0,0,10,0"
                                Command="{Binding CancelModeSwitchCommand}"
                                Style="{StaticResource NexusSecondaryButtonStyle}"/>
                        <Button Content="Pindah" MinWidth="104"
                                Command="{Binding ConfirmModeSwitchCommand}"
                                Style="{StaticResource NexusPrimaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
