<UserControl x:Class="Nexus.App.Views.AiCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:Nexus.App.Services"
             xmlns:viewmodels="clr-namespace:Nexus.App.ViewModels"
             xmlns:controls="clr-namespace:Nexus.App.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100"
             AllowDrop="True" Drop="View_Drop" DragOver="View_DragOver"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <DropShadowEffect x:Key="AiCheckPillShadow"
                          BlurRadius="12" ShadowDepth="2" Opacity="0.16" Color="Black"/>

        <Style x:Key="AiCheckToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NexusIconButtonStyle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action & Dataset Bar (Visible only when HasContent) -->
        <Border Grid.Row="0" Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1" Padding="16,8"
                Visibility="{Binding HasContent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: File Selector & Info Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SelectFileCommand}"
                            Style="{StaticResource NexusSecondaryButtonStyle}"
                            Height="36" Padding="14,0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock services:NexusIcon.Glyph="FolderOpen" FontSize="15" Margin="0,0,8,0"
                                       Foreground="{DynamicResource NexusAccentPrimary}"/>
                            <TextBlock Text="Pilih Desain..." FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- File Info Pill (Shown when file loaded) -->
                    <Border Visibility="{Binding HasUploadedFile, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock services:NexusIcon.Glyph="Document" FontSize="14" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding DimensionFormatted}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Text Info Pill (Shown when text pasted) -->
                    <Border Visibility="{Binding HasTextContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock services:NexusIcon.Glyph="Document" FontSize="14" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Automatic Reference Knowledge Base Indicator & Manage Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource NexusSurfaceRaised}"
                            BorderBrush="{DynamicResource NexusStrokeDefault}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,0" Height="34" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip="Semua data referensi resmi dan kamus kata baku diverifikasi otomatis tanpa perlu memilih manual.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ActiveReferenceSummaryText, FallbackValue='Referensi: Otomatis Aktif'}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NexusForegroundPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Height="34" Padding="12,0"
                            Click="BtnManageRefData_Click"
                            Style="{StaticResource NexusSecondaryButtonStyle}"
                            FontSize="11" ToolTip="Kelola database referensi resmi dan kata baku">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock services:NexusIcon.Glyph="Settings" FontSize="12" Margin="0,0,5,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Kelola Data..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Center Canvas + Right Sidebar) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Center Canvas Area -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceSecondaryBrush}" ClipToBounds="True">
                <Grid>
                    <!-- Empty State: Clean & Minimal (Visible only when HasNoContent) -->
                    <Grid Visibility="{Binding HasNoContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Tambahkan materi untuk diperiksa"
                                       FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,24"
                                       Foreground="{DynamicResource NexusForegroundPrimary}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Button 1: Tempel Teks / Gambar (Pill, Width=210, Height=40) -->
                                <Button Command="{Binding PasteContentCommand}"
                                        Width="210" Height="40" Margin="0,0,16,0"
                                        Style="{StaticResource NexusSecondaryButtonStyle}">
                                    <Button.Resources>
                                        <CornerRadius x:Key="NexusRadiusMedium">20</CornerRadius>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock services:NexusIcon.Glyph="Paste" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Tempel Teks / Gambar" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Button 2: Unggah Dokumen (Pill, Width=210, Height=40) -->
                                <Button Command="{Binding SelectFileCommand}"
                                        Width="210" Height="40"
                                        Style="{StaticResource NexusPrimaryButtonStyle}">
                                    <Button.Resources>
                                        <CornerRadius x:Key="NexusRadiusMedium">20</CornerRadius>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock services:NexusIcon.Glyph="FolderOpen" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="White"/>
                                        <TextBlock Text="Unggah Dokumen" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Minimal Text Content Preview Stage (Visible when HasTextContent) -->
                    <Border Visibility="{Binding HasTextContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            Padding="32" Margin="32" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600">
                            <TextBox Text="{Binding TextContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     FontFamily="Segoe UI Variable, Segoe UI"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Interactive Image & Bounding Box Canvas Stage -->
                    <Grid x:Name="CanvasPreviewStage"
                          Visibility="{Binding HasUploadedFile, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Background="Transparent" ClipToBounds="True"
                          MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                          MouseMove="Preview_MouseMove"
                          MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                          MouseDown="Preview_MouseDown"
                          MouseUp="Preview_MouseUp"
                          LostMouseCapture="Preview_LostMouseCapture"
                          PreviewMouseWheel="Preview_PreviewMouseWheel"
                          SizeChanged="Preview_SizeChanged">

                        <!-- Canvas Transform Stage (Uniform Fitted Size with Pan/Zoom Transform) -->
                        <Grid x:Name="CanvasTransformStage" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Rendered Image -->
                            <Image x:Name="ImgPreview" Source="{Binding PreviewImage}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Native Bounding Box Overlay Layer perfectly scaled to Image bounds -->
                            <Viewbox x:Name="OverlayViewbox" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="{Binding OriginalPixelWidth}" Height="{Binding OriginalPixelHeight}">
                                    <ItemsControl ItemsSource="{Binding OverlayBoxes}"
                                                  Width="{Binding OriginalPixelWidth}"
                                                  Height="{Binding OriginalPixelHeight}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="{Binding OriginalPixelWidth}" Height="{Binding OriginalPixelHeight}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X1}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y1}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                        BorderBrush="{Binding StrokeBrush}"
                                                        BorderThickness="{Binding BorderThickness}"
                                                        Background="{Binding FillBrush}"
                                                        CornerRadius="2"
                                                        ToolTip="{Binding TooltipText}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect Color="#FFD54F" BlurRadius="18" ShadowDepth="0" Opacity="0.95"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="FlashAnim">
                                                                            <Storyboard RepeatBehavior="3x">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="1.0" To="0.35" Duration="0:0:0.25"
                                                                                                 AutoReverse="True"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="FlashAnim"/>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border Background="{Binding StrokeBrush}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            CornerRadius="0,0,3,0" Padding="4,1">
                                                        <TextBlock Text="{Binding Id}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>

                            <!-- Native WPF Image Processing Scanner (Apple-Inspired Motion) -->
                            <controls:ImageProcessingScanner x:Name="AiCheckScanner"
                                                             Panel.ZIndex="100"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             IsActive="{Binding IsAnalyzing}"
                                                             ScannerMode="AiCheck"/>
                        </Grid>
                    </Grid>

                    <!-- Floating Unified Pill Toolbar (Zoom Controls + PERIKSA DESAIN + RESET) -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                            Visibility="{Binding HasContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="24" Padding="10,5"
                            Effect="{StaticResource AiCheckPillShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Zoom Out -->
                            <Button Command="{Binding ZoomOutCommand}"
                                    IsEnabled="{Binding HasUploadedFile}"
                                    Style="{StaticResource AiCheckToolbarButtonStyle}"
                                    ToolTip="Perkecil">
                                <TextBlock services:NexusIcon.Glyph="ZoomOut" FontSize="15"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>

                            <!-- Zoom Slider -->
                            <Slider Width="120" Minimum="0.2" Maximum="3.0" Value="{Binding ZoomLevel, Mode=TwoWay}"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"
                                    IsEnabled="{Binding HasUploadedFile}" Margin="6,0" VerticalAlignment="Center"
                                    Style="{StaticResource NexusSliderStyle}"/>

                            <!-- Zoom In -->
                            <Button Command="{Binding ZoomInCommand}"
                                    IsEnabled="{Binding HasUploadedFile}"
                                    Style="{StaticResource AiCheckToolbarButtonStyle}"
                                    ToolTip="Perbesar">
                                <TextBlock services:NexusIcon.Glyph="Zoom" FontSize="15"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>

                            <!-- Zoom Percentage Display -->
                            <Border MinWidth="48" Height="28" Padding="6,0" Margin="4,0" CornerRadius="14"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ZoomText}" TextAlignment="Center"
                                           VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>

                            <!-- Fit to Canvas Toggle -->
                            <Button Command="{Binding ToggleProofZoomCommand}"
                                    IsEnabled="{Binding HasUploadedFile}"
                                    Style="{StaticResource NexusSubtleButtonStyle}"
                                    Height="28" Padding="8,0" Margin="2,0"
                                    ToolTip="Toggle Pas Layar / 100%">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock services:NexusIcon.Glyph="FullScreen" FontSize="13" Margin="0,0,4,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Fit" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>

                            <!-- Separator -->
                            <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource BorderSubtleBrush}"/>

                            <!-- PERIKSA DESAIN (Scan/Search Icon) -->
                            <Button Command="{Binding RunCheckCommand}"
                                    IsEnabled="{Binding CanRunCheck}"
                                    Style="{StaticResource NexusPrimaryButtonStyle}"
                                    Height="32" Padding="14,0" Margin="2,0"
                                    ToolTip="Periksa materi untuk mendeteksi typo, salah baca OCR, dan anomali">
                                <Button.Resources>
                                    <CornerRadius x:Key="NexusRadiusMedium">16</CornerRadius>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock services:NexusIcon.Glyph="Search" FontSize="14" Margin="0,0,6,0"
                                               Foreground="White"/>
                                    <TextBlock Text="PERIKSA DESAIN" FontWeight="Bold" FontSize="11"
                                               VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>

                            <!-- RESET -->
                            <Button Command="{Binding ResetCommand}"
                                    IsEnabled="{Binding HasContent}"
                                    Style="{StaticResource NexusSecondaryButtonStyle}"
                                    Height="32" Padding="12,0" Margin="4,0,2,0"
                                    ToolTip="Reset materi dan hasil pemeriksaan">
                                <Button.Resources>
                                    <CornerRadius x:Key="NexusRadiusMedium">16</CornerRadius>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock services:NexusIcon.Glyph="Refresh" FontSize="13" Margin="0,0,6,0"
                                               Foreground="{DynamicResource NexusAccentPrimary}"/>
                                    <TextBlock Text="RESET" FontWeight="SemiBold" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Analyzing Status Indicator (Sleek non-modal floating pill outside image transform) -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="18" Padding="14,8"
                            Effect="{StaticResource AiCheckPillShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Control Template="{StaticResource NexusModernRingSpinnerTemplate}" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding AnalysisStageText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Sidebar: Inspection Findings Panel (Width 380, Visible only when IsResultsPanelVisible) -->
            <Border Grid.Column="1" Width="380"
                    Visibility="{Binding IsResultsPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header & Summary Badges -->
                    <Border Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Temuan Pemeriksaan" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Background="#28F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                                        CornerRadius="12" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AttentionCount, StringFormat='{}{0} Temuan'}"
                                               FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding SummaryText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 1: Scrollable Findings Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <Grid>
                            <!-- Empty Findings Placeholder (When inspection completed with 0 findings) -->
                            <Border Visibility="{Binding HasNoFindings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="24,32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock services:NexusIcon.Glyph="Check" FontSize="32"
                                               HorizontalAlignment="Center" Margin="0,0,0,12"
                                               Foreground="#10B981"/>
                                    <TextBlock Text="Tidak Ada Anomali" FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Dokumen diperiksa dan siap digunakan."
                                               FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="14,12"
                                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="12"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="FindingCard_MouseLeftButtonUp"
                                                ToolTip="Klik untuk melompat dan memusatkan posisi di kanvas">
                                            <StackPanel>
                                                <!-- Card Header: Box Badge & Severity Badge -->
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                                CornerRadius="8" Padding="7,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding DisplayBoxNumber}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </Border>
                                                        <Border Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeForeground}" BorderThickness="1"
                                                                CornerRadius="8" Padding="7,2">
                                                            <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding StatusBadgeForeground}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Subtle Expand / Collapse Chevron Indicator -->
                                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="services:NexusIcon.Glyph" Value="ChevronDown"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="services:NexusIcon.Glyph" Value="ChevronUp"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Compact Original -> Recommendation Text -->
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
                                                    <Run Text="{Binding OriginalText}" FontWeight="Medium" FontSize="12"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Run Text="  →  " FontSize="11" FontWeight="Bold"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <Run Text="{Binding RecommendedText}" FontWeight="Bold" FontSize="12"
                                                         Foreground="{DynamicResource NexusAccentPrimary}"/>
                                                </TextBlock>

                                                <!-- Progressive Disclosure Section: Reason & Action Buttons -->
                                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                                                    <!-- Reason -->
                                                    <TextBlock Text="{Binding Reason}" FontSize="11" FontStyle="Italic"
                                                               TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                                                    <!-- Action Buttons: Abaikan & Salin -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Height="28" Padding="12,0" Margin="0,0,8,0"
                                                                Command="{Binding DataContext.DismissFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource NexusSecondaryButtonStyle}"
                                                                FontSize="11">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock services:NexusIcon.Glyph="Delete" FontSize="12" Margin="0,0,5,0"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="Abaikan" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <Button Height="28" Padding="14,0"
                                                                Command="{Binding DataContext.CopyCorrectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource NexusPrimaryButtonStyle}"
                                                                FontSize="11">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock FontSize="12" Margin="0,0,5,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="services:NexusIcon.Glyph" Value="Copy"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                                    <Setter Property="services:NexusIcon.Glyph" Value="Check"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Salin"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                                    <Setter Property="Text" Value="Tersalin"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- Row 2: Stable Snapshot Statistics Bar (Immutable when findings are dismissed) -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            Background="{DynamicResource SurfacePrimaryBrush}" Padding="0,12,0,0" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- BOX -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="BOX" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SnapshotBoxCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- TEMUAN -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="TEMUAN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SnapshotFindingCount}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- KOREKSI -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="KOREKSI" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SnapshotCorrectionCount}" FontSize="13" FontWeight="Bold" Foreground="#FF5252" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- REVIEW -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="REVIEW" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SnapshotReviewCount}" FontSize="13" FontWeight="Bold" Foreground="#FFA726" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- OCR -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="OCR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SnapshotOcrErrorCount}" FontSize="13" FontWeight="Bold" Foreground="#42A5F5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
