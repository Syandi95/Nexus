<UserControl x:Class="Nexus.App.Views.PdfUtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nexus.App.Views"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:services="clr-namespace:Nexus.App.Services"
             xmlns:controls="clr-namespace:Nexus.App.Controls.InfoBar"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100" Foreground="{DynamicResource NexusForegroundPrimary}"
             AllowDrop="True" Drop="View_Drop" DragOver="View_DragOver" PreviewKeyDown="View_PreviewKeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nexus.App;component/Controls/InfoBar/InfoBar.xaml"/>
                <ResourceDictionary Source="/Nexus.App;component/Themes/Components/PdfWorkspace.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DocumentImageModeCardStyle" TargetType="RadioButton" BasedOn="{StaticResource NexusRadioButtonStyle}">
                <Setter Property="MinHeight" Value="64"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource NexusFocusVisualStyle}"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource NexusSurfaceBase}" BorderBrush="{DynamicResource NexusContentBorder}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Border x:Name="SelectionWash" Background="{DynamicResource NexusAccentPrimary}" Opacity="0.08" CornerRadius="7" Visibility="Collapsed"/>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center" Width="20" Height="20">
                                        <Ellipse x:Name="RadioRing" Stroke="{DynamicResource NexusContentBorder}" StrokeThickness="1.5"/>
                                        <Ellipse x:Name="RadioDot" Width="12" Height="12" Fill="{DynamicResource NexusSuccessForeground}" Visibility="Collapsed"/>
                                    </Grid>
                                    <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionWash" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource NexusAccentPrimary}"/>
                                <Setter TargetName="RadioRing" Property="Stroke" Value="{DynamicResource NexusSuccessForeground}"/>
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource NexusAccentPrimary}"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource NexusAccentPrimary}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            <DataTemplate DataType="{x:Type vm:PdfChoiceSetting}"><StackPanel Margin="0,0,0,14" IsEnabled="{Binding IsEnabled}" Visibility="{Binding IsVisible,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" Style="{StaticResource NexusComboBoxStyle}"/></StackPanel></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PdfToggleSetting}"><CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" Margin="0,0,0,14" IsEnabled="{Binding IsEnabled}" Visibility="{Binding IsVisible,Converter={StaticResource BooleanToVisibilityConverter}}"/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PdfTextSetting}"><StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding Label}" Margin="0,0,0,6"/><TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}" Style="{StaticResource NexusTextBoxStyle}"/></StackPanel></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PdfNumberSetting}"><StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding Label}" Margin="0,0,0,6"/><TextBox Text="{Binding Value,UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsEnabled}" Style="{StaticResource NexusTextBoxStyle}"/></StackPanel></DataTemplate>
            <Style x:Key="DocumentToolCategoryHeaderStyle" TargetType="ToggleButton">
             <Setter Property="Foreground" Value="{DynamicResource NexusForegroundSecondary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="6,0"/><Setter Property="FocusVisualStyle" Value="{DynamicResource NexusFocusVisualStyle}"/>
             <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="HeaderChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"><Grid>
               <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
               <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}"/>
               <TextBlock x:Name="CategoryChevron" Grid.Column="1" services:NexusIcon.Glyph="ChevronDown" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
              </Grid></Border>
              <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="False"><Setter TargetName="CategoryChevron" Property="services:NexusIcon.Glyph" Value="ChevronRight"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/></Trigger></ControlTemplate.Triggers>
             </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="DocumentToolCategoryStyle" TargetType="Expander">
             <Setter Property="Margin" Value="0,12,0,0"/>
             <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
              <ToggleButton x:Name="CategoryHeader" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Style="{StaticResource DocumentToolCategoryHeaderStyle}"/>
              <ContentPresenter x:Name="CategoryContent" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
             </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="CategoryContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
             <Style.Triggers><DataTrigger Binding="{Binding ToolsExpanded}" Value="False"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><ContentPresenter Content="{TemplateBinding Content}"/></ControlTemplate></Setter.Value></Setter></DataTrigger></Style.Triggers>
            </Style>
            <DataTemplate x:Key="PdfToolEntry">
             <Button Style="{StaticResource NexusSubtleButtonStyle}" Command="{Binding DataContext.SelectToolCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding UnavailableReason}" HorizontalContentAlignment="Stretch" Padding="6,5" Margin="0,2" Background="Transparent" BorderThickness="0">
              <Grid MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
               <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid Visibility="{Binding IsConversionTool,Converter={StaticResource BooleanToVisibilityConverter}}">
                 <Border Width="17" Height="19" CornerRadius="2.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0" Background="{DynamicResource NexusSurfaceBase}" BorderBrush="{Binding AccentBrush}" BorderThickness="1.35">
                  <Path Data="M 2,3 H 8 M 2,6 H 10 M 2,9 H 7" Stroke="{Binding AccentBrush}" StrokeThickness="1.2" Stretch="Uniform" Width="9" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                 </Border>
                 <Border MinWidth="15" Height="13" CornerRadius="2.5" Padding="2.5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" Background="{Binding AccentBrush}">
                  <TextBlock Text="{Binding Badge}" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource NexusForegroundOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                 </Border>
                </Grid>
                <Border Width="26" Height="26" CornerRadius="5.5" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{Binding AccentBrush}" Visibility="{Binding IsEditTool,Converter={StaticResource BooleanToVisibilityConverter}}">
                 <Path Data="{Binding IconGeometry}" Fill="{DynamicResource NexusForegroundOnAccent}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
               </Grid>
               <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource NexusForegroundPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.ToolsExpanded,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
              </Grid>
             </Button>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="PdfWorkspaceRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="32,0">

            <!-- Inline Notification InfoBar (Windows 11 Fluent) -->
            <controls:InfoBar IsOpen="{Binding IsInfoBarOpen}"
                              Title="{Binding InfoBarTitle}"
                              Message="{Binding InfoBarMessage}"
                              Severity="{Binding InfoBarSeverity}"
                              Margin="0,12,0,0"/>
        </StackPanel>
                            
        <!-- MAIN CONTENT -->
        <Grid x:Name="PdfContentGrid" Grid.Row="1">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="28,24,28,16"/><Style.Triggers><DataTrigger Binding="{Binding IsReaderWorkspace}" Value="True"><Setter Property="Margin" Value="28,24,28,24"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding RightPanelWidth}"/>
            </Grid.ColumnDefinitions>
                                    
            <!-- LEFT: Drop Area / Multi-file Cards -->
            <Border x:Name="PdfDocumentArea" Grid.Column="0"
                    Style="{StaticResource NexusCardStyle}" Padding="12">
                <Grid>
                    <!-- Drop Zone (shown when no files) -->
                    <Border x:Name="DropAreaBorder"
                            Visibility="{Binding HasNoFiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                            CornerRadius="12" Padding="30"
                            BorderThickness="2" BorderBrush="{DynamicResource NexusStrokeDefault}"
                            AllowDrop="True"
                            Drop="DropArea_Drop"
                            DragEnter="DropArea_DragEnter"
                            DragOver="DropArea_DragOver"
                            Cursor="Hand">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock services:NexusIcon.Glyph="PDFPage" FontSize="64"
                                           Foreground="{DynamicResource NexusAccentPrimary}"
                                           HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                <TextBlock Text="Tambahkan file"
                                           Style="{StaticResource NexusTypographyTitle}"
                                           Foreground="{DynamicResource NexusForegroundPrimary}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Seret PDF atau pilih file. File tetap lokal; sumber tidak diubah."
                                           Style="{StaticResource NexusTypographyBody}"
                                           Foreground="{DynamicResource NexusForegroundSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Row="1" Style="{StaticResource NexusButtonStyle}"
                                    Command="{Binding SelectFileCommand}"
                                    Width="160" HorizontalAlignment="Center" Margin="0,20,0,10" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock services:NexusIcon.Glyph="Add" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tambahkan file" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                        
                    <views:PdfReaderView x:Name="PdfReaderWorkspace" DataContext="{Binding Reader}">
                     <views:PdfReaderView.Style><Style TargetType="views:PdfReaderView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.HasFiles,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/><Condition Binding="{Binding DataContext.IsDocumentView,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></views:PdfReaderView.Style>
                    </views:PdfReaderView>
                    <Button x:Name="PdfShowDocumentButton" Content="Lihat dokumen" HorizontalAlignment="Left" VerticalAlignment="Bottom" Command="{Binding ToggleDocumentViewCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NexusButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasFiles}" Value="True"/><Condition Binding="{Binding IsDocumentView}" Value="False"/><Condition Binding="{Binding IsReaderWorkspace}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <!-- Multi-file Cards (shown when files exist) -->
                    <ScrollViewer x:Name="PdfFileScrollViewer"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" BorderThickness="0">
                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Margin" Value="0,0,72,0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsReaderWorkspace}" Value="True"><Setter Property="Margin" Value="0,0,0,48"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasFiles}" Value="True"/><Condition Binding="{Binding IsDocumentView}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding PdfFiles}" BorderThickness="0" Background="Transparent">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="PdfFileCardBorder" Width="188" Margin="0,0,16,16"
                                            Style="{StaticResource NexusCardStyle}"
                                            Background="{DynamicResource NexusSurfaceBase}"
                                            BorderBrush="{DynamicResource NexusContentBorder}"
                                            BorderThickness="1"
                                            Padding="0" CornerRadius="12" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="148"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Preview area (subtle outer border + elevated paper shadow inside thumbnail) -->
                                            <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True"
                                                    Background="Transparent" Padding="18,16,18,8" MouseLeftButtonUp="Card_OpenDocument">
                                                <Grid>
                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="White" CornerRadius="2"
                                                            Visibility="{Binding PreviewAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.20"/>
                                                        </Border.Effect>
                                                        <Image x:Name="PdfCardPreviewImage" Source="{Binding PreviewImage}" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                    <TextBlock services:NexusIcon.Glyph="PDFPage" FontSize="40"
                                                               Foreground="{DynamicResource NexusForegroundSecondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasPreviewFailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Action buttons overlay (visible only on card hover) -->
                                            <StackPanel x:Name="PdfCardHoverActions" Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" Margin="6" Panel.ZIndex="10">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=PdfFileCardBorder}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource NexusOverlayIconButtonStyle}"
                                                        Command="{Binding DataContext.ShowFullScreenCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Width="30" Height="30" Padding="0"
                                                        Margin="0,0,4,0" ToolTip="Lihat preview">
                                                    <TextBlock services:NexusIcon.Glyph="FullScreen" FontSize="13"
                                                               Foreground="{DynamicResource NexusForegroundPrimary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Style="{StaticResource NexusSoftDeleteIconButtonStyle}"
                                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Width="30" Height="30" Padding="0"
                                                        ToolTip="Hapus file">
                                                    <TextBlock services:NexusIcon.Glyph="Delete" FontSize="13"
                                                               Foreground="{DynamicResource NexusSoftDeleteForeground}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- File info + Physical Size in cm -->
                                            <StackPanel Grid.Row="1" Margin="14,2,14,12" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NexusForegroundPrimary}"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource NexusForegroundSecondary}"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding SizeText}"/><Run Text=" - "/><Run Text="{Binding PageCountText}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DimensionsCmText}" FontSize="11"
                                                           Foreground="{DynamicResource NexusForegroundSecondary}"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           Visibility="{Binding HasDimensionsCm, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="{Binding StatusForeground}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </WrapPanel>
                </ScrollViewer>

                </Grid>
            </Border>
                                    
            <!-- RIGHT: Settings Panel -->
            <Border x:Name="PdfSettingsPanel" Grid.Column="1" Margin="18,0,0,0"
                    CornerRadius="18" Padding="20"
                    >
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource NexusCardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasSelectedTool}" Value="True"/><Condition Binding="{Binding IsSettingsVisible}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
                <DockPanel>
                        <!-- Convert Button -->
                        <Button x:Name="PdfProcessButton" DockPanel.Dock="Bottom" Margin="0,14,0,0" Content="{Binding ConvertButtonText}"
                                Command="{Binding ConvertCommand}"
                                IsEnabled="{Binding CanConvert}"
                                Style="{StaticResource NexusPrimaryButtonStyle}"
                                Height="44" FontSize="14" FontWeight="SemiBold" Cursor="Hand"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
                    <StackPanel>

                        <TextBlock Text="{Binding SelectedTool.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource NexusForegroundPrimary}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsImageToolSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <!-- Settings Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="34" Height="34" CornerRadius="11"
                                    Background="{DynamicResource NexusSurfaceSecondary}">
                                <TextBlock services:NexusIcon.Glyph="Settings" FontSize="15"
                                           Foreground="{DynamicResource NexusAccentPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pengaturan" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NexusForegroundPrimary}"
                                       VerticalAlignment="Center" Margin="11,0,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="PdfImageModePanel" Visibility="{Binding IsImageToolSelected,Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                            <RadioButton x:Name="PdfPageExportMode" IsChecked="{Binding RenderPdfPages,Mode=TwoWay}"
                                         Style="{StaticResource DocumentImageModeCardStyle}" Margin="0,0,0,8" AutomationProperties.Name="Konversi halaman PDF menjadi JPG atau PNG">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock services:NexusIcon.Glyph="Document" FontSize="18" Foreground="{DynamicResource NexusAccentPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Konversi halaman" FontWeight="SemiBold" Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                        <TextBlock Text="Setiap halaman menjadi JPG atau PNG." TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource NexusForegroundSecondary}"/></StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="PdfExtractImagesMode" IsChecked="{Binding ExtractEmbeddedImages,Mode=TwoWay}"
                                         Style="{StaticResource DocumentImageModeCardStyle}" AutomationProperties.Name="Extract Images, ekstrak gambar tertanam sebagai PNG">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock services:NexusIcon.Glyph="Image" FontSize="18" Foreground="{DynamicResource NexusForegroundSecondary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Extract Images" FontWeight="SemiBold" Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                        <TextBlock Text="Ekstrak gambar tertanam sebagai PNG." TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource NexusForegroundSecondary}"/></StackPanel>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsPageImageMode,Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- Format Output -->
                        <TextBlock Text="Format Output" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                        <ComboBox SelectedIndex="{Binding SelectedFormatIndex, Mode=TwoWay}"
                                  Margin="0,7,0,17"
                                  Style="{StaticResource NexusComboBoxStyle}">
                            <ComboBoxItem Content="JPEG"/>
                            <ComboBoxItem Content="PNG"/>
                        </ComboBox>

                        <!-- Resolusi -->
                        <TextBlock Text="Resolusi" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                        <ComboBox ItemsSource="{Binding DpiItems}"
                                  SelectedIndex="{Binding SelectedDpiIndex, Mode=TwoWay}"
                                  Margin="0,7,0,17"
                                  Style="{StaticResource NexusComboBoxStyle}"/>

                        <!-- Custom DPI TextBox -->
                        <TextBox Text="{Binding CustomDpiText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NexusTextBoxStyle}"
                                 Visibility="{Binding IsCustomDpiVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,-10,0,17"
                                 KeyDown="TxtCustomDpi_KeyDown"/>

                        <!-- Halaman -->
                        <TextBlock Text="Halaman" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                        <Border Margin="0,7,0,7" Padding="3" CornerRadius="10"
                                Background="{DynamicResource NexusSurfaceSecondary}"
                                BorderBrush="{DynamicResource NexusStrokeDefault}" BorderThickness="1">
                            <UniformGrid Columns="2">
                                <RadioButton Content="Semua" GroupName="PdfPageSelection"
                                             IsChecked="{Binding ConvertAllPages, Mode=TwoWay}"
                                             Style="{StaticResource NexusSegmentedRadioButtonStyle}"/>
                                <RadioButton Content="Tertentu" GroupName="PdfPageSelection"
                                             IsChecked="{Binding ConvertSpecificPages, Mode=TwoWay}"
                                             IsEnabled="{Binding CanSelectSpecificPages}"
                                             Style="{StaticResource NexusSegmentedRadioButtonStyle}"/>
                            </UniformGrid>
                        </Border>
                        <TextBox Text="{Binding PageRangeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NexusTextBoxStyle}"
                                 Visibility="{Binding ConvertSpecificPages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,0,0,7" ToolTip="Contoh: 1-3,5,8"/>
                        <TextBlock Text="Pilihan halaman tertentu hanya tersedia untuk satu file PDF."
                                   Visibility="{Binding HasMultipleFiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="0,0,0,17" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource NexusForegroundSecondary}"/>

                        <StackPanel x:Name="PdfJpegQualityPanel"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedFormatIndex}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <!-- Kualitas JPEG -->
                        <Grid Margin="0,7,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Kualitas JPEG"
                                       Foreground="{DynamicResource NexusForegroundSecondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding QualityText}"
                                       FontWeight="Bold" Foreground="{DynamicResource NexusAccentPrimary}"/>
                        </Grid>
                        <Slider Minimum="10" Maximum="100" Value="{Binding QualityValue, Mode=TwoWay}"
                                TickFrequency="10" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                Style="{StaticResource NexusSliderStyle}"
                                Margin="0,0,0,17"/>

                        </StackPanel>
                        </StackPanel>
                        <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsImageToolSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding SelectedToolSettings.Fields}"/>
                        <TextBlock Text="{Binding SelectedToolSettings.Note}" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                        <TextBlock Text="{Binding SelectedTool.UnavailableReason}" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                        </StackPanel>
                        <!-- Folder Output -->
                        <TextBlock Text="Folder Output" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                        <Grid Margin="0,7,0,17">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputDirPath, Mode=TwoWay}" ToolTip="{Binding OutputDirPath}" IsReadOnly="True"
                                     Style="{StaticResource NexusTextBoxStyle}"/>
                            <Button Grid.Column="1" Margin="8,0,0,0"
                                    Command="{Binding BrowseOutputDirCommand}"
                                    ToolTip="Pilih Folder Output"
                                    Style="{StaticResource NexusToolbarButtonStyle}">
                                <TextBlock services:NexusIcon.Glyph="Folder" FontSize="16"/>
                            </Button>
                        </Grid>

                        <StackPanel Visibility="{Binding IsPageImageMode,Converter={StaticResource BooleanToVisibilityConverter}}">                        <!-- Penamaan File -->
                        <TextBlock Text="Penamaan File" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                        <ComboBox SelectedIndex="{Binding NamingIndex, Mode=TwoWay}"
                                  Margin="0,7,0,24"
                                  Style="{StaticResource NexusComboBoxStyle}">
                            <ComboBoxItem Content="Nama Asli + Nomor Halaman"/>
                            <ComboBoxItem Content="Nama Asli Saja"/>
                            <ComboBoxItem Content="Nomor Halaman Saja"/>
                            <ComboBoxItem Content="Prefix + Nama Asli + Nomor"/>
                        </ComboBox>

</StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>
            <Border x:Name="PdfToolsPanel" Grid.Column="1" Margin="18,0,0,0" Padding="12" CornerRadius="18" Background="{DynamicResource NexusSurfaceBase}" BorderBrush="{DynamicResource NexusContentBorder}" BorderThickness="1">
             <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedTool}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
             <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
               <Button x:Name="PdfToolsToggleButton" Style="{StaticResource NexusOverlayIconButtonStyle}" Width="28" Height="28" Padding="0" Command="{Binding ToggleSettingsCommand}" ToolTip="{Binding SettingsToggleText}" AutomationProperties.Name="{Binding SettingsToggleText}"><TextBlock FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="services:NexusIcon.Glyph" Value="ChevronRight"/><Style.Triggers><DataTrigger Binding="{Binding ToolsExpanded}" Value="False"><Setter Property="services:NexusIcon.Glyph" Value="ChevronLeft"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button>
               <TextBlock Grid.Column="1" Text="Tools" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource NexusForegroundPrimary}" Visibility="{Binding ToolsExpanded,Converter={StaticResource BooleanToVisibilityConverter}}"/>
              </Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
               <Expander Header="Convert from PDF" IsExpanded="{Binding IsConvertFromExpanded,Mode=TwoWay}" Style="{StaticResource DocumentToolCategoryStyle}"><ItemsControl ItemsSource="{Binding ConvertFromTools}" ItemTemplate="{StaticResource PdfToolEntry}"/></Expander>
               <Expander Header="Edit PDF" IsExpanded="{Binding IsEditExpanded,Mode=TwoWay}" Style="{StaticResource DocumentToolCategoryStyle}"><ItemsControl ItemsSource="{Binding EditTools}" ItemTemplate="{StaticResource PdfToolEntry}"/></Expander>
               <Expander Header="Convert to PDF" IsExpanded="{Binding IsConvertToExpanded,Mode=TwoWay}" Style="{StaticResource DocumentToolCategoryStyle}"><ItemsControl ItemsSource="{Binding ConvertToTools}" ItemTemplate="{StaticResource PdfToolEntry}"/></Expander>
               <TextBlock Text="Tool tanpa engine dapat dipelajari; proses belum tersedia. Import saat ini mendukung PDF." TextWrapping="Wrap" Margin="6,16,6,0" Foreground="{DynamicResource NexusForegroundSecondary}" Visibility="{Binding ToolsExpanded,Converter={StaticResource BooleanToVisibilityConverter}}"/>
              </StackPanel></ScrollViewer>
             </DockPanel>
            </Border>
            <StackPanel Visibility="{Binding HasSelectedTool,Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="PdfWorkspaceToolbar" Grid.Column="0" Width="48" Margin="0,12,12,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="20">
                <Button x:Name="TogglePdfSettingsButton" Width="36" Height="36" Padding="0" Margin="0,0,0,6"
                        HorizontalAlignment="Center" Style="{StaticResource NexusOverlayIconButtonStyle}"
                        Command="{Binding ToggleSettingsCommand}" ToolTip="{Binding SettingsToggleText}"
                        AutomationProperties.Name="{Binding SettingsToggleText}">
                    <Viewbox Width="20" Height="20">
                        <Grid Width="20" Height="20">
                            <Rectangle Margin="1" RadiusX="3" RadiusY="3" Stroke="{DynamicResource NexusAccentPrimary}" StrokeThickness="1.5"/>
                            <Path Data="M 12,2 L 12,18" Stroke="{DynamicResource NexusAccentPrimary}" StrokeThickness="1.5" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Viewbox>
                </Button>
                <Grid Width="48" Height="48" Visibility="{Binding HasFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button x:Name="AddMorePdfFilesButton" Width="48" Height="48" Padding="0"
                            Command="{Binding SelectFileCommand}" ToolTip="Tambah file PDF" AutomationProperties.Name="Tambah file PDF"
                            Style="{StaticResource NexusPdfAddFilesButtonStyle}">

                        <TextBlock services:NexusIcon.Glyph="Add" FontSize="24"/>
                    </Button>
                    <Border MinWidth="20" Height="20" Padding="4,0" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="-11,0,0,0" Background="{DynamicResource NexusForegroundPrimary}" IsHitTestVisible="False">
                        <TextBlock Text="{Binding PdfFiles.Count}" Foreground="{DynamicResource NexusSurfaceBase}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border x:Name="PdfConversionFooter" Visibility="{Binding HasSelectedTool,Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Row="2" Style="{StaticResource NexusCardStyle}" Margin="28,0,28,24" Padding="18,14" CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Icon (stable position, switches by state) -->
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12"
                        Background="{DynamicResource NexusSurfaceSecondary}" Margin="0,0,12,0">
                    <Grid>
                        <!-- Default idle: Info -->
                        <TextBlock services:NexusIcon.Glyph="Info" FontSize="16"
                                   Foreground="{DynamicResource NexusAccentPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIconGlyph}" Value="Sync">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusIconGlyph}" Value="Check">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusIconGlyph}" Value="Error">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Converting: NexusModernRingSpinnerTemplate (parity with Image Tool) -->
                        <Control Template="{StaticResource NexusModernRingSpinnerTemplate}"
                                 Width="38" Height="38"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding IsStatusIconSpinning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Success: Check -->
                        <TextBlock services:NexusIcon.Glyph="Check" FontSize="16"
                                   Foreground="{DynamicResource NexusAccentPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIconGlyph}" Value="Check">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Error: Error -->
                        <TextBlock services:NexusIcon.Glyph="Error" FontSize="16"
                                   Foreground="{DynamicResource NexusAccentPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIconGlyph}" Value="Error">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                    
                <!-- Status Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusForegroundPrimary}"/>
                    <TextBlock Text="{Binding CombinedStatusText}"
                               Margin="0,3,0,0" FontSize="11"
                               Foreground="{DynamicResource NexusForegroundSecondary}"
                               TextTrimming="CharacterEllipsis"/>
                    <Expander Header="Hasil per file" Margin="0,6,0,0" Visibility="{Binding ShouldShowJobResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                     <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding JobResults}"><ItemsControl.ItemTemplate><DataTemplate>
                      <StackPanel Margin="0,4,12,8">
                       <TextBlock FontWeight="SemiBold"><Run Text="{Binding Name}"/><Run Text=" — "/><Run Text="{Binding Status}"/></TextBlock>
                       <TextBlock Text="{Binding OutputDirectory}" TextWrapping="Wrap" FontSize="11"/>
                       <ItemsControl ItemsSource="{Binding Outputs}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" HorizontalContentAlignment="Left" ToolTip="Buka hasil sebagai file baru" Command="{Binding DataContext.OpenResultCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      </StackPanel>
                     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </Expander>
                </StackPanel>

                <!-- Determinate Progress Bar (only when converting AND multi-page) -->
                <ProgressBar Grid.Column="2" Margin="12,0" VerticalAlignment="Center"
                             Value="{Binding ProgressValue}" Minimum="0" Maximum="100">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource NexusProgressBarStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConverting}" Value="True"/>
                                        <Condition Binding="{Binding IsProgressIndeterminate}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                    
                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Batalkan" Command="{Binding CancelConversionCommand}" Margin="0,0,8,0" Style="{StaticResource NexusButtonStyle}" Visibility="{Binding IsConverting,Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="Buka Folder" Margin="0,0,0,0"
                            Command="{Binding OpenOutputDirCommand}"
                            IsEnabled="{Binding HasConverted}"
                            ToolTip="Buka folder hasil"
                            Style="{StaticResource NexusButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="PdfPreviewOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100"
              Visibility="{Binding IsFullScreenVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              IsVisibleChanged="PreviewOverlay_IsVisibleChanged" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{DynamicResource NexusBackdropOverlay}" MouseDown="OverlayBackdrop_MouseDown"/>
            <Grid Margin="20" IsHitTestVisible="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.05*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.05*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.05*"/><RowDefinition Height="0.9*"/><RowDefinition Height="0.05*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="PdfPreviewViewport" Grid.Column="1" Grid.Row="1">
                        <Viewbox Stretch="Uniform">
                            <Border Background="{DynamicResource NexusPdfPageBackground}">
                                <Image x:Name="PdfFullscreenPreviewImage" Source="{Binding FullScreenPreviewImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Viewbox>
                    </Grid>
                </Grid>
                <TextBlock Text="{Binding PreviewStatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" Foreground="{DynamicResource NexusForegroundPrimary}"
                           Background="{DynamicResource NexusSurfaceRaised}" Padding="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="ClosePdfPreviewButton" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseFullScreenCommand}" Style="{StaticResource NexusOverlayIconButtonStyle}"
                        ToolTip="Tutup preview (Esc)" AutomationProperties.Name="Tutup preview">
                    <TextBlock services:NexusIcon.Glyph="Close" FontSize="16"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
