                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontFamily="{StaticResource NexusTypographyIconFontFamily}"
                                                           FontSize="27" Foreground="{DynamicResource NexusForegroundSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                                    <TextBlock services:NexusIcon.Glyph="File" FontSize="13"
                                                               Foreground="{DynamicResource NexusForegroundSecondary}"
                                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="{StaticResource NexusTypographyBodySmallSize}"
                                                               Foreground="{DynamicResource NexusForegroundPrimary}"
                                                               MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="2" Text="{Binding CharacterCount, StringFormat={}{0:N0} karakter}"
                                                           FontSize="10" Foreground="{DynamicResource NexusForegroundSecondary}"
                                                           TextTrimming="CharacterEllipsis" Margin="18,2,0,0"/>
                                            </Grid>
                                        </Button>
                                        <TextBlock Text="Gagal" FontSize="10" Foreground="{DynamicResource NexusErrorStroke}"
                                                   Margin="8,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{StaticResource NexusIconButtonStyle}" Width="20" Height="20"
                                                Background="{DynamicResource NexusSurfaceRaised}"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,6,6,0" ToolTip="Hapus lampiran">
                                            <TextBlock services:NexusIcon.Glyph="Close" FontSize="10"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Normal Composer (Rows 3 & 4) - Permanent 2-Tier Layout (Harness Parity) -->
                    <Grid x:Name="AIComposerLayout" Grid.Row="3" Grid.RowSpan="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChoiceActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tier 1: Multiline Text Input (Permanent Row 0, Full Width) -->
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,8">
                            <TextBox x:Name='TxtAIInput' Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Background='Transparent' BorderThickness='0' Padding='2,4'
                                     TextWrapping='Wrap' AcceptsReturn='True' AcceptsTab='False'
                                     PreviewKeyDown="TxtAIInput_PreviewKeyDown" TextChanged="TxtAIInput_TextChanged"
                                     VerticalScrollBarVisibility='Auto' MaxHeight='180'>
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource AIWorkspaceInputStyle}">
                                        <Setter Property="MinHeight" Value="36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInitialState}" Value="True">
                                                <Setter Property="MinHeight" Value="52"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock x:Name='TxtAIInputPlaceholder' Text='Tanyakan sesuatu...' Foreground='{DynamicResource NexusForegroundSecondary}'
                                       Margin='4,6,0,0' VerticalAlignment='Top'
                                       IsHitTestVisible='False'>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AIWorkspaceBodyStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInputText}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Tier 2: Action Row (Permanent Row 1) -->
                        <!-- Attachment Add Menu Button with 28x28 Circular Selector and + Glyph -->
                        <Button x:Name='BtnAIAddAttachment' Click="BtnAIAddAttachment_Click"
                                Grid.Row="1" Grid.Column="0"
                                Style="{StaticResource DshRoundSelectorButtonStyle}"
                                ToolTip='Tools dan lampiran' VerticalAlignment='Center'
                                AutomationProperties.Name="Tools dan lampiran">
                            <Path Data="{StaticResource DshIconPlus}" Width="12" Height="12"
                                  Stroke="{DynamicResource DshTextPrimaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource GeminiAttachmentContextMenuStyle}">
                                    <MenuItem Header='Lampirkan File' Command="{Binding AttachFileCommand}" Style="{StaticResource GeminiAttachmentMenuItemStyle}">
                                        <MenuItem.Icon>
                                            <TextBlock services:NexusIcon.Glyph="Attach" FontSize="18" Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header='Lampirkan Folder' Command="{Binding AttachFolderCommand}" Style="{StaticResource GeminiAttachmentMenuItemStyle}">
                                        <MenuItem.Icon>
                                            <TextBlock services:NexusIcon.Glyph="Folder" FontSize="18" Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header='Pengaturan run' Command="{Binding ToggleRunSettingsCommand}" IsCheckable="True" IsChecked="{Binding IsRunSettingsOpen, Mode=OneWay}" Style="{StaticResource GeminiAttachmentMenuItemStyle}">
                                        <MenuItem.Icon><TextBlock services:NexusIcon.Glyph="Settings" FontSize="18"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header='Chat sementara' Command="{Binding ToggleTemporaryChatCommand}" IsCheckable="True" IsChecked="{Binding IsTemporaryChat, Mode=OneWay}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource GeminiAttachmentMenuItemStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAiCheckModeActive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                        <MenuItem.Icon><TextBlock services:NexusIcon.Glyph="Chat" FontSize="18"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Mode Selector ComboBox (Tanya / Edit kode - Modern WPF ComboBox) -->
                        <ComboBox x:Name="ModeComboBox"
                                  Grid.Row="1" Grid.Column="1"
                                  SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}"
                                  Visibility="Collapsed"
                                  Height="28" Padding="10,0" Margin="8,0,0,0"
                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Style="{StaticResource DshModeComboBoxStyle}"
                                  AutomationProperties.Name="Mode interaksi">
                            <ComboBoxItem Content="Tanya" ToolTip="Tanya dan diskusikan kode atau topik umum"/>
                            <ComboBoxItem Content="Edit kode" ToolTip="Edit kode dengan preview diff dan persetujuan eksplisit"/>
                        </ComboBox>

                        <!-- Composer Top Bar: Thinking Control (Permanent Row 1, Column 2) -->
                        <StackPanel x:Name='ComposerTopBar' Grid.Row="1" Grid.Column="2" Orientation='Horizontal' Margin='0,0,8,0' Visibility='Visible' VerticalAlignment='Center' HorizontalAlignment='Right'>
                            <StackPanel.Resources>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource NexusComboBoxStyle}">
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="FontSize" Value="{StaticResource NexusTypographyCaptionSize}"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                                <Style x:Key="AIWorkspaceToolbarChipStyle" TargetType="ToggleButton">
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Background" Value="{DynamicResource AIWorkspaceDeepThinkOffBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AIWorkspaceDeepThinkOffBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AIWorkspaceDeepThinkOffForegroundBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border CornerRadius="16"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      ContentSource="Content"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AIWorkspaceDeepThinkOnBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AIWorkspaceDeepThinkOnBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AIWorkspaceDeepThinkOnBorderBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AIWorkspaceDeepThinkOnForegroundBrush}"/>
                                            <Setter Property="ToolTip" Value="Pikir Mendalam Aktif"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Resources>
                            <ToggleButton x:Name="BtnDeepThink"
                                    Style="{StaticResource AIWorkspaceToolbarChipStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Margin="0"
                                    Command="{Binding ToggleDeepThinkCommand}"
                                    IsChecked="{Binding IsDeepThinkEnabled, Mode=OneWay}"
                                    ToolTip="Pikir Mendalam (R1)"
                                    AutomationProperties.Name="Pikir Mendalam">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource DshIconThink}" Width="14" Height="14"
                                          Fill="{DynamicResource DshAccentPrimaryBrush}"
                                          Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Pikir Mendalam" VerticalAlignment="Center"
                                                Foreground="{DynamicResource DshTextPrimaryBrush}"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <!-- Send / Cancel Button (Permanent Row 1, Column 3) -->
                        <Border x:Name='BtnAISendBorder' Grid.Row="1" Grid.Column="3" Width='34' Height='34' CornerRadius='17' VerticalAlignment='Center' SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DshSendButtonActiveBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource DshSendButtonBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSending}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DshSendButtonActiveBgBrush}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSending}" Value="False"/>
                                                <Condition Binding="{Binding IsWorkspaceSendEnabled}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource DshSendButtonDisabledBgBrush}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Button x:Name='BtnAISend' Command="{Binding SendWorkspaceCommand}" IsEnabled="{Binding IsWorkspaceSendEnabled}" Width="34" Height="34"
                                        ToolTip="Kirim pesan"
                                        AutomationProperties.Name="Kirim pesan">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DshSendButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSending}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path x:Name="DshSendArrowPath" Data="{StaticResource DshIconArrowUp}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,1">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource DshSendButtonActiveIconBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorkspaceSendEnabled}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource DshSendButtonDisabledIconBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                                <Button x:Name='BtnAICancel' Command="{Binding CancelGenerationCommand}" Width="34" Height="34"
                                        ToolTip="Hentikan pembuatan"
                                        AutomationProperties.Name="Hentikan pembuatan">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DshSendButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSending}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path Data="{StaticResource DshIconStop}" Width="12" Height="12" Fill="{DynamicResource DshSendButtonActiveIconBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Choice Surface (Active when IsChoiceActive == True) -->
                    <Grid x:Name="ChoiceSurfaceGrid" Grid.Row="3" Grid.RowSpan="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChoiceActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Choice Question Header -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding ActiveChoice.Question, FallbackValue='Pilih salah satu opsi berikut:'}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource NexusTypographyBodySize}"
                                   Foreground="{DynamicResource NexusForegroundPrimary}"
                                   Margin="2,2,2,8"/>

                        <!-- Options ListBox (Single Selection, MaxHeight=240, Auto Scroll) -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ActiveChoice.Options}"
                                 SelectedItem="{Binding SelectedChoiceOption, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 MaxHeight="240"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{DynamicResource NexusFocusVisualStyle}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="ItemChrome"
                                                        CornerRadius="8"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource NexusStrokeDefault}"
                                                        BorderThickness="1"
                                                        Padding="12,8"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource NexusSurfaceSecondary}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                        <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource NexusTypographyBodyCompactSize}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Action Row: [ Skip ] and [ Submit ] -->
                        <Grid Grid.Row="2" Margin="0,8,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnChoiceSkip"
                                    Grid.Column="0"
                                    Content="Skip"
                                    Command="{Binding SkipChoiceCommand}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource NexusStrokeDefault}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource NexusForegroundSecondary}"
                                    FontSize="{StaticResource NexusTypographyBodyCompactSize}"
                                    FontWeight="Medium"
                                    Padding="18,6"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="16"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnChoiceSubmit"
                                    Grid.Column="2"
                                    Content="Submit"
                                    Command="{Binding SubmitChoiceCommand}"
                                    Style="{StaticResource AIWorkspacePrimaryPillButtonStyle}"
                                    FontSize="{StaticResource NexusTypographyBodyCompactSize}"
                                    Height="32"
                                    Padding="20,0"
                                    Cursor="Hand"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 2: Symmetrical Counter-Balance Spacer (ensures Composer is the vertical anchor at screen center in Initial State) -->
            <Border Grid.Row="2" Focusable="False" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInitialState}" Value="True">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            </Grid>

            <!-- AI Check Mode View (Grid.Row 1 & 2, Panel.ZIndex 10 covers chat when active) -->
            <views:AiCheckView x:Name="AiCheckHostPanel"
                               Grid.Row="1"
                               Grid.RowSpan="2"
                               Panel.ZIndex="10"
                               DataContext="{Binding AiCheck}"
                               Visibility="{Binding DataContext.IsAiCheckModeActive, RelativeSource={RelativeSource AncestorType={x:Type views:ConversationView}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>


        <!-- Floating Run Settings panel with compact native controls. -->
        <Border x:Name="RunSettingsPanel" Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="800" HorizontalAlignment="Right" VerticalAlignment="Top" Width="316" MaxHeight="610" Margin="0,8,24,0" Padding="16"
                Background="{DynamicResource NexusSurfaceBase}" BorderBrush="{DynamicResource NexusStrokeDefault}"
                BorderThickness="1" CornerRadius="18" TextElement.Foreground="{DynamicResource NexusForegroundPrimary}"
                Visibility="{Binding IsRunSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.16"/></Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Command="{Binding ToggleRunSettingsCommand}" Style="{StaticResource NexusIconButtonStyle}" Width="28" Height="28" ToolTip="Tutup Run Settings"><TextBlock services:NexusIcon.Glyph="Close" FontSize="12"/></Button><TextBlock Text="Run settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <Button Content="Kelola Akun, Cloud AI &amp; Memori..." Command="{Binding OpenAccountSettingsModalCommand}" Style="{StaticResource AIWorkspacePillButtonStyle}" Height="32" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Command="{Binding ToggleSystemPromptExpandedCommand}" HorizontalContentAlignment="Left"
                            Style="{StaticResource NexusIconButtonStyle}" Width="Auto" Height="30" Padding="0">
                        <TextBlock Text="System Prompt" FontSize="12" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding EditSystemPromptCommand}" Style="{StaticResource NexusIconButtonStyle}"
                            Width="28" Height="28" ToolTip="Edit System Prompt" AutomationProperties.Name="Edit System Prompt">
                        <TextBlock services:NexusIcon.Glyph="Edit" FontSize="12"/>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding ToggleSystemPromptExpandedCommand}" Style="{StaticResource NexusIconButtonStyle}"
                            Width="28" Height="28" ToolTip="Buka atau tutup System Prompt" AutomationProperties.Name="Buka atau tutup System Prompt">
                        <TextBlock FontSize="10">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="services:NexusIcon.Glyph" Value="ChevronRight"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsSystemPromptExpanded}" Value="True">
                                    <Setter Property="services:NexusIcon.Glyph" Value="ChevronDown"/>
                                </DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>
                <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource NexusStrokeDefault}" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding IsSystemPromptExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer Height="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding SystemPrompt}" FontSize="12" TextWrapping="Wrap" LineHeight="19"/>
                    </ScrollViewer>
                </Border>
                <Border Height="1" Background="{DynamicResource NexusStrokeDefault}" Margin="0,0,0,14"/>
                <TextBlock Text="Sampling" FontSize="12" Foreground="{DynamicResource NexusForegroundSecondary}" Margin="0,0,0,12"/>
                <DockPanel><TextBlock Text="Temperature"/><TextBlock HorizontalAlignment="Right" Text="{Binding Temperature, StringFormat=F2}"/></DockPanel>
                <Slider Style="{StaticResource NexusSliderStyle}" Height="28" Minimum="0" Maximum="2" Value="{Binding Temperature, Mode=TwoWay}" Margin="0,2,0,10" AutomationProperties.Name="Temperature"/>
                <DockPanel><TextBlock Text="Top P"/><TextBlock HorizontalAlignment="Right" Text="{Binding TopP, StringFormat=F2}"/></DockPanel>
                <Slider Style="{StaticResource NexusSliderStyle}" Height="28" Minimum="0" Maximum="1" Value="{Binding TopP, Mode=TwoWay}" Margin="0,2,0,10" AutomationProperties.Name="Top P"/>
                <DockPanel><TextBlock Text="Top K"/><TextBlock HorizontalAlignment="Right" Text="{Binding TopK}"/></DockPanel>
                <Slider Style="{StaticResource NexusSliderStyle}" Height="28" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TopK, Mode=TwoWay}" Margin="0,2,0,10" AutomationProperties.Name="Top K"/>
                <DockPanel><TextBlock Text="Min P"/><TextBlock HorizontalAlignment="Right" Text="{Binding MinP, StringFormat=F2}"/></DockPanel>
                <Slider Style="{StaticResource NexusSliderStyle}" Height="28" Minimum="0" Maximum="1" Value="{Binding MinP, Mode=TwoWay}" Margin="0,2,0,14" AutomationProperties.Name="Min P"/>
                <StackPanel Visibility="{Binding IsChatModeActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Height="1" Background="{DynamicResource NexusStrokeDefault}" Margin="0,0,0,14"/>
                    <TextBlock Text="Generation" FontSize="12" Foreground="{DynamicResource NexusForegroundSecondary}" Margin="0,0,0,12"/>
                    <DockPanel><TextBlock Text="Max tokens"/><TextBlock HorizontalAlignment="Right" Text="{Binding MaxTokens}"/></DockPanel>
                    <Slider Style="{StaticResource NexusSliderStyle}" Height="28" Minimum="128" Maximum="32768" TickFrequency="128" IsSnapToTickEnabled="True" Value="{Binding MaxTokens, Mode=TwoWay}" Margin="0,2,0,10" AutomationProperties.Name="Max tokens"/>
                    <CheckBox Content="Pikir mendalam" Style="{StaticResource NexusToggleSwitchStyle}" Foreground="{DynamicResource NexusForegroundPrimary}" IsChecked="{Binding IsDeepThinkEnabled, Mode=TwoWay}" IsEnabled="{Binding IsThinkingSupported}" Margin="0,0,0,14"/>
                </StackPanel>
