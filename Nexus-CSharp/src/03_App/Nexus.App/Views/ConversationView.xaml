                                            <StackPanel>
                                                <TextBlock Text="browser.navigate &amp; search" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="Opens Web &amp; Google Scholar in Right Panel WebView2; retrieves DOI, authors, year &amp; PDF links." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="10" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="14,12" Margin="6,0,0,10" Background="{DynamicResource NexusSurfaceBase}">
                                            <StackPanel>
                                                <TextBlock Text="browser.get_snapshot &amp; extract" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="Stamps SnapshotId [ref=e1..eN] on visible elements and extracts clean semantic content." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="10" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="14,12" Margin="0,0,6,10" Background="{DynamicResource NexusSurfaceBase}">
                                            <StackPanel>
                                                <TextBlock Text="browser.click / fill / select" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="Interacts with validated SnapshotId refs; separates fill from submit and blocks password fields." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="10" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="14,12" Margin="6,0,0,10" Background="{DynamicResource NexusSurfaceBase}">
                                            <StackPanel>
                                                <TextBlock Text="browser.download &amp; workspace.add_file" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="Downloads PDF/docs, verifies %PDF- header &amp; SHA-256 deduplication, and registers in Workspace Files." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="10" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="14,12" Margin="0,0,6,10" Background="{DynamicResource NexusSurfaceBase}">
                                            <StackPanel>
                                                <TextBlock Text="tool-fs-search (Everything 1.5)" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="Zero-latency RAM filesystem discovery with typo recovery and partial name matching." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="10" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="14,12" Margin="6,0,0,10" Background="{DynamicResource NexusSurfaceBase}">
                                            <StackPanel>
                                                <TextBlock Text="skill-filesystem (Hermes)" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="Self-learning USER.md, MEMORY.md, and portable SKILL.md provider in nexus_data/skills." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Text="Recent Browser Agent Activity Log" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,10" Background="{DynamicResource NexusSurfaceSunken}" Height="90">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding BrowserAgentActivityLogs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource NexusForegroundSecondary}" Margin="0,0,0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="7" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Background="{DynamicResource NexusSurfaceBase}" Margin="0,0,8,0">
                                            <Button Content="Open Downloads Folder" Command="{Binding OpenAgentDownloadsFolderCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Background="Transparent" BorderThickness="0" Height="30" Padding="12,0" FontSize="12"/>
                                        </Border>
                                        <Border CornerRadius="7" Background="{DynamicResource NexusForegroundPrimary}">
                                            <Button Content="Open Skills &amp; Memory Folder" Command="{Binding OpenMemoryFolderCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource NexusSurfaceBase}" Height="30" Padding="14,0" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!--PANE 5: AGENT PRESETS (Fixed Non-Overlapping Badges & Taller Memory Boxes)-->
                                <StackPanel Visibility="{Binding IsSettingsTabMemory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Agent presets" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Choose the agent's runtime limits and tool configuration. Each preset directly updates MaxActions, MaxContextTokens, and CPU Work-Hours settings."
                                               FontSize="12" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <TextBlock Text="BUILT-IN RUNTIME PRESETS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource NexusForegroundSecondary}" Margin="0,0,0,8"/>

                                    <UniformGrid Columns="2" Margin="0,0,0,14">
                                        <!-- Card 1: Standard Mode -->
                                        <Border CornerRadius="10" Padding="12,10" Margin="0,0,6,10" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL1Brush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL2Brush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsPresetStandardActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource NexusForegroundPrimary}"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Command="{Binding ActivatePresetStandardCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                                <StackPanel Width="192">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock DockPanel.Dock="Right" Text="standard" FontSize="11" Foreground="{DynamicResource NexusForegroundSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Standard" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="5" Background="{DynamicResource NexusForegroundPrimary}" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="Default" FontSize="10" Foreground="{DynamicResource NexusSurfaceBase}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Text="Max 8 steps, 5 pages, 650 context tokens. Balanced web research &amp; citations." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>

                                        <!-- Card 2: Academic & PTC Mode -->
                                        <Border CornerRadius="10" Padding="12,10" Margin="6,0,0,10" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL1Brush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL2Brush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsPresetPtcActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource NexusForegroundPrimary}"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Command="{Binding ActivatePresetPtcCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                                <StackPanel Width="192">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock DockPanel.Dock="Right" Text="scholar" FontSize="11" Foreground="{DynamicResource NexusForegroundSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Academic &amp; PTC" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="5" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="Built-in" FontSize="10"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Text="Max 10 steps, Scholar &amp; OpenAlex DOI search + verified PDF provenance." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>

                                        <!-- Card 3: Minimal Work-Hours Mode -->
                                        <Border CornerRadius="10" Padding="12,10" Margin="0,0,6,10" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL1Brush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL2Brush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsPresetMinimalActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource NexusForegroundPrimary}"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Command="{Binding ActivatePresetMinimalCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                                <StackPanel Width="192">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock DockPanel.Dock="Right" Text="minimal" FontSize="11" Foreground="{DynamicResource NexusForegroundSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Work-Hours" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="5" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="4-Thread Safe" FontSize="10"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Text="Max 5 steps, 450 context tokens, keeps CPU free for CorelDRAW &amp; Photoshop." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>

                                        <!-- Card 4: Deep Research Mode -->
                                        <Border CornerRadius="10" Padding="12,10" Margin="6,0,0,10" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL1Brush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL2Brush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsPresetCreatorActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource NexusForegroundPrimary}"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Command="{Binding ActivatePresetCreatorCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                                <StackPanel Width="192">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock DockPanel.Dock="Right" Text="cordis" FontSize="11" Foreground="{DynamicResource NexusForegroundSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Deep Research" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="5" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="900 Tokens" FontSize="10"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Text="Max 12 steps, 8 pages, 900 context tokens, multi-source academic synthesis." FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Text="HERMES PERSISTENT MEMORY (USER.md &amp; MEMORY.md)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource NexusForegroundSecondary}" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource NexusSurfaceBase}">
                                        <TextBox Text="{Binding HermesUserMdDraft, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Height="82" BorderThickness="0" Background="Transparent" FontSize="11.5"
                                                 Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                    </Border>
                                    <Border CornerRadius="8" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Padding="8" Margin="0,0,0,12" Background="{DynamicResource NexusSurfaceBase}">
                                        <TextBox Text="{Binding HermesMemoryMdDraft, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Height="92" BorderThickness="0" Background="Transparent" FontSize="11.5"
                                                 Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                    </Border>

                                    <Grid>
                                        <Border CornerRadius="7" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="1" Background="{DynamicResource NexusSurfaceBase}" HorizontalAlignment="Left">
                                            <Button Content="+ Let the agent help me create a preset" Command="{Binding CreateCustomAgentPresetCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Background="Transparent" BorderThickness="0" Height="30" Padding="12,0" FontSize="12"/>
                                        </Border>
                                        <Border CornerRadius="7" Background="{DynamicResource NexusForegroundPrimary}" HorizontalAlignment="Right">
                                            <Button Content="Save Memory &amp; Preset" Command="{Binding SaveHermesMemoryCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource NexusSurfaceBase}" Height="30" Padding="16,0" FontSize="12" FontWeight="Medium"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        

        <Grid x:Name="SystemPromptEditorOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="1100"
              Background="{DynamicResource NexusModalBackdrop}" KeyboardNavigation.TabNavigation="Cycle" IsVisibleChanged="SystemPromptEditor_IsVisibleChanged"
              Visibility="{Binding IsSystemPromptEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="768" MaxHeight="590" Margin="32" Padding="28" CornerRadius="22"
                    Background="{DynamicResource NexusSurfaceBase}" VerticalAlignment="Center"
                    TextElement.Foreground="{DynamicResource NexusForegroundPrimary}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding CancelSystemPromptEditCommand}" Style="{StaticResource NexusIconButtonStyle}"
                                Width="28" Height="28" ToolTip="Tutup" AutomationProperties.Name="Tutup editor prompt">
                            <TextBlock services:NexusIcon.Glyph="Close" FontSize="12"/>
                        </Button>
                        <TextBlock Text="Edit System Prompt" FontSize="18" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,22">
                        <TextBlock Text="{Binding ActivePromptModuleLabel, StringFormat=Instruksi model untuk modul {0}.}" Foreground="{DynamicResource NexusForegroundSecondary}"/>
                        <TextBlock Text="Perubahan digunakan pada permintaan berikutnya setelah Anda menyimpan." Foreground="{DynamicResource NexusForegroundSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Prompt editor" Margin="0,24,0,0" FontSize="12"/>
                    </StackPanel>
                    <Border Grid.Row="2" CornerRadius="12" BorderBrush="{DynamicResource NexusStrokeDefault}" BorderThickness="1" Padding="12">
                        <TextBox x:Name="SystemPromptDraftEditor" Text="{Binding SystemPromptDraft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 MinHeight="180" Height="300" BorderThickness="0" Background="Transparent" FontSize="14"
                                 Foreground="{DynamicResource NexusForegroundPrimary}"
                                 CaretBrush="{DynamicResource NexusForegroundPrimary}"
                                 AutomationProperties.Name="Prompt editor"/>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,22,0,0">
                        <Button Content="Pulihkan default" Command="{Binding ResetSystemPromptDraftCommand}" HorizontalAlignment="Left"
                                Style="{StaticResource AIWorkspacePillButtonStyle}" Padding="12,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Batal" Command="{Binding CancelSystemPromptEditCommand}" Style="{StaticResource AIWorkspacePillButtonStyle}" Margin="0,0,10,0" Padding="16,6"/>
                            <Button Content="Simpan" Command="{Binding SaveSystemPromptEditCommand}" Style="{StaticResource AIWorkspacePrimaryPillButtonStyle}" Padding="16,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- Native WPF attachment viewer, aligned with the Unsloth Desktop preview layout. -->
        <Grid x:Name="AttachmentPreviewOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="1000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAttachmentPreviewOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource AIWorkspaceModalBackdropBrush}"
                    MouseDown="AttachmentPreviewBackdrop_MouseDown"/>

            <Grid MaxWidth="1200" Margin="24,18"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border CornerRadius="24"
                        Background="{DynamicResource NexusSurfaceRaised}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="5" Direction="270" Opacity="0.20" Color="#000000"/>
                    </Border.Effect>
                </Border>

                <Border Background="{DynamicResource NexusSurfaceRaised}"
                        BorderBrush="{DynamicResource NexusContentBorder}"
                        BorderThickness="1"
                        CornerRadius="24"
                        TextOptions.TextFormattingMode="Display"
                        TextOptions.TextRenderingMode="ClearType"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="24,14,16,14"
                                BorderBrush="{DynamicResource NexusContentBorder}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PreviewAttachmentTitle}"
                                               FontFamily="{StaticResource NexusTypographyFontFamily}"
                                               FontSize="15" FontWeight="Medium"
                                               Foreground="{DynamicResource NexusForegroundPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PreviewAttachmentSubtitle}"
                                               FontSize="12" Foreground="{DynamicResource NexusForegroundSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,12,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox Width="86" Height="36" Margin="0,0,8,0"
                                              Style="{StaticResource NexusComboBoxStyle}"
                                              ItemsSource="{Binding PreviewZoomOptions}"
                                              SelectedItem="{Binding PreviewZoomPercent, Mode=TwoWay}"
                                              ItemStringFormat="{}{0}%" ToolTip="Ukuran pratinjau"/>
                                    <Button Style="{StaticResource NexusIconButtonStyle}" Width="36" Height="36"
                                            Command="{Binding CloseAttachmentPreviewCommand}" ToolTip="Tutup pratinjau">
                                        <TextBlock services:NexusIcon.Glyph="Close" FontSize="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="24,0,24,24">
                            <TextBox Text="{Binding PreviewAttachmentContent, Mode=OneWay}"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     Padding="0,18,0,0" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource NexusTypographyCodeFontFamily}"
                                     FontSize="{Binding PreviewFontSize}"
                                     Foreground="{DynamicResource NexusForegroundPrimary}"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar IsIndeterminate="True" Width="140" Height="4" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding ExtractionProgressText}"
                                           FontSize="{StaticResource NexusTypographyBodyCompactSize}"
                                           Foreground="{DynamicResource NexusForegroundSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
