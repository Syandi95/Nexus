<UserControl x:Class="Nexus.App.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Nexus.App.Services"
             xmlns:rendering="clr-namespace:Nexus.App.AIWorkspace.Rendering"
             xmlns:views="clr-namespace:Nexus.App.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             PreviewKeyDown="ConversationView_PreviewKeyDown"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid x:Name='ModuleAIWorkspace' Visibility='Visible'>
        <Grid.Resources>
            <!-- Typography Scale Styles (Frozen specifications) -->
            <Style x:Key="AIWorkspaceHeadingStyle">
                <Setter Property="TextBlock.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="TextBlock.FontSize" Value="{StaticResource NexusTypographyBodySize}"/>
                <Setter Property="TextBlock.FontWeight" Value="{StaticResource NexusTypographyStrongWeight}"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                <Setter Property="Control.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="Control.FontSize" Value="{StaticResource NexusTypographyBodySize}"/>
                <Setter Property="Control.FontWeight" Value="{StaticResource NexusTypographyStrongWeight}"/>
                <Setter Property="Control.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
            </Style>
            <Style x:Key="AIWorkspaceBodyStyle">
                <Setter Property="TextBlock.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="TextBlock.FontSize" Value="{StaticResource NexusTypographyBodyCompactSize}"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                <Setter Property="Control.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="Control.FontSize" Value="{StaticResource NexusTypographyBodyCompactSize}"/>
                <Setter Property="Control.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
            </Style>
            <Style x:Key="AIWorkspaceWelcomeTitleStyle">
                <Setter Property="TextBlock.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="TextBlock.FontSize" Value="{StaticResource NexusTypographyWelcomeSize}"/>
                <Setter Property="TextBlock.FontWeight" Value="{StaticResource NexusTypographyStrongWeight}"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                <Setter Property="Control.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="Control.FontSize" Value="{StaticResource NexusTypographyWelcomeSize}"/>
                <Setter Property="Control.FontWeight" Value="{StaticResource NexusTypographyStrongWeight}"/>
                <Setter Property="Control.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
            </Style>
            <Style x:Key="AIWorkspaceSecondaryStyle">
                <Setter Property="TextBlock.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="TextBlock.FontSize" Value="{StaticResource NexusTypographyBodySmallSize}"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource NexusForegroundSecondary}"/>
                <Setter Property="Control.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="Control.FontSize" Value="{StaticResource NexusTypographyBodySmallSize}"/>
                <Setter Property="Control.Foreground" Value="{DynamicResource NexusForegroundSecondary}"/>
            </Style>
            <Style x:Key="AIWorkspaceInputStyle">
                <Setter Property="TextBlock.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="TextBlock.FontSize" Value="{StaticResource NexusTypographyBodyCompactSize}"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                <Setter Property="Control.FontFamily" Value="{StaticResource NexusTypographyFontFamily}"/>
                <Setter Property="Control.FontSize" Value="{StaticResource NexusTypographyBodyCompactSize}"/>
                <Setter Property="Control.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
            </Style>
            <Style x:Key="AIWorkspaceCodeStyle">
                <Setter Property="TextBlock.FontFamily" Value="{StaticResource NexusTypographyCodeFontFamily}"/>
                <Setter Property="TextBlock.FontSize" Value="{StaticResource NexusTypographyCodeSize}"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                <Setter Property="Control.FontFamily" Value="{StaticResource NexusTypographyCodeFontFamily}"/>
                <Setter Property="Control.FontSize" Value="{StaticResource NexusTypographyCodeSize}"/>
                <Setter Property="Control.Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
            </Style>
            <DataTemplate x:Key="SentAttachmentChipTemplate">
                <Border Background="{DynamicResource NexusSurfaceRaised}"
                        BorderBrush="{DynamicResource NexusContentBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,9"
                        Margin="0,0,0,6"
                        Cursor="Hand"
                        ToolTip="{Binding StatusTooltip}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick"
                                      Command="{Binding DataContext.ViewAttachmentContentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                    </Border.InputBindings>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="8"
                                Background="{DynamicResource NexusSurfaceSunken}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding IconGlyph}"
                                       FontFamily="{StaticResource NexusTypographyIconFontFamily}"
                                       FontSize="18"
                                       Foreground="{DynamicResource NexusAccentPrimary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}"
                                       Style="{StaticResource AIWorkspaceHeadingStyle}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       MaxWidth="340"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DisplaySubtitle}"
                                       Style="{StaticResource AIWorkspaceSecondaryStyle}"
                                       FontSize="11"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2"
                                Background="{DynamicResource NexusWarningSurface}"
                                CornerRadius="4"
                                Padding="5,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTruncated}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Terpotong"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource NexusWarningStroke}"/>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
            <Style TargetType="ToolTip" BasedOn="{StaticResource NexusToolTipStyle}">
                <Setter Property="Padding" Value="8,5"/>
            </Style>

            <!-- Gemini-styled Attachment Context Menu (Rounded 16, Soft Drop Shadow, Outlined Icons on Left, Generous Spacing) -->
            <Style x:Key="GeminiAttachmentMenuItemStyle" TargetType="{x:Type MenuItem}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="ItemBorder"
                                    Background="Transparent"
                                    CornerRadius="10"
                                    Margin="2,1"
                                    Padding="{TemplateBinding Padding}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="IconPresenter"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding Icon}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GeminiAttachmentContextMenuStyle" TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border Background="Transparent" Padding="10" SnapsToDevicePixels="True">
                                <Border Background="{DynamicResource NexusSurfaceOverlay}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="16"
                                        Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Mode Switcher Pill RadioButton Style -->
            <Style x:Key="NexusWorkspaceModePillRadioButtonStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="84"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundSecondary}"/>
                <Setter Property="FontFamily" Value="{StaticResource NexusContentFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource NexusTypographyCaptionSize}"/>
                <Setter Property="FontWeight" Value="{StaticResource NexusTypographyMediumWeight}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border x:Name="Segment"
                                    Margin="0"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="15"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Segment" Property="Background" Value="{DynamicResource CaptionButtonHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Segment" Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
                                    <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter TargetName="Segment" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="Segment" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="1" Opacity="0.08"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                                    <Setter Property="FontWeight" Value="{StaticResource NexusTypographyStrongWeight}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Conversation Item Context Menu -->
            <ContextMenu x:Key="ConversationItemContextMenu" Style="{StaticResource NexusContextMenuStyle}">
                <MenuItem Style="{StaticResource NexusMenuItemStyle}"
                          Header="Rename"
                          Click="ConversationRename_Click"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <TextBlock services:NexusIcon.Glyph="Edit" FontSize="13" Foreground="{DynamicResource NexusForegroundSecondary}" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Style="{StaticResource NexusMenuItemStyle}"
                          Header="Delete"
                          Click="ConversationDelete_Click"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <TextBlock services:NexusIcon.Glyph="Delete" FontFamily="{StaticResource NexusTypographyIconFontFamily}" FontSize="13" Foreground="{DynamicResource NexusForegroundSecondary}" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>

            <!-- Conversation List Item Container Style (Compact ListView pattern from Nexus.UI Pack) -->
            <Style x:Key="NexusConversationListItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ContextMenu" Value="{StaticResource ConversationItemContextMenu}"/>
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ConversationItem_PreviewMouseRightButtonDown"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="ItemHost"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Margin="0"
                                    Padding="0"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemHost" Property="Background" Value="{DynamicResource NexusSurfaceSecondary}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemHost" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                    <Setter TargetName="ItemHost" Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact Item Template based on Nexus.UI Pack ListView -->
            <DataTemplate x:Key="ConversationListItemTemplate">
                <Grid Height="32" Margin="0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Indicator Pill (Nexus.UI Pack ActiveRectangle pattern) -->
                    <Border Grid.Column="0"
                            Width="3"
                            Height="16"
                            CornerRadius="1.5"
                            Background="{DynamicResource NexusAccentPrimary}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Title / Rename TextBox -->
                    <Grid Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{StaticResource NexusTypographyCaptionSize}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AIWorkspaceHeadingStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="ConversationRenameTextBox"
                                 Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="ConversationRenameTextBox_PreviewKeyDown"
                                 IsVisibleChanged="ConversationRenameTextBox_IsVisibleChanged"
                                 Padding="4,2"
                                 VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource AIWorkspaceBodyStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Compact Timestamp -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding UpdatedAtFormatted}"
                               Style="{StaticResource AIWorkspaceSecondaryStyle}"
                               FontSize="11"
                               Foreground="{DynamicResource NexusForegroundSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- DeepSeek Harness Left Navigation Sidebar -->
        <views:DshSidebarView x:Name="DshSidebar"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="0"
                              DataContext="{Binding}"/>

        <!-- Conversation Workspace Header -->
        <Grid x:Name="WorkspaceHeaderBar" Grid.Row="0" Grid.Column="1" Margin="20,9,10,9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="2">
                    <ComboBox x:Name="CboAIModel"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                              IsEnabled="{Binding IsModelSelectionEnabled}"
                              Style="{StaticResource NexusComboBoxStyle}"
                              MinWidth="160" MaxWidth="260" Height="36"
                              AutomationProperties.Name="Pilih model">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{DynamicResource NexusForegroundSecondary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource NexusComboBoxItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button Command="{Binding OpenAccountSettingsModalCommand}"
                            Style="{StaticResource AIWorkspacePillButtonStyle}"
                            Height="30" Padding="10,0" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Kelola Akun Cloud AI (GitHub / OpenRouter / Gemini / DeepSeek) &amp; Memori Agen">
                        <TextBlock Text="+ Connect" FontSize="11.5" Foreground="{DynamicResource NexusForegroundSecondary}" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="{Binding ModelPickerStatus}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource NexusForegroundSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelSwitching}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- Mode Switcher Pill [ Chat ] [ AI CHECK ] (True Geometric Center) -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Height="36"
                        Background="{DynamicResource NexusSurfaceSunken}"
                        CornerRadius="18" Padding="2"
                        BorderBrush="{DynamicResource NexusStrokeDefault}"
                        BorderThickness="1">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource NexusWorkspaceModePillRadioButtonStyle}"
                                     Content="Chat"
                                     IsChecked="{Binding IsChatModeActive, Mode=TwoWay}"
                                     Cursor="Hand"/>
                        <RadioButton Style="{StaticResource NexusWorkspaceModePillRadioButtonStyle}"
                                     Content="AI Check"
                                     IsChecked="{Binding IsAiCheckModeActive, Mode=TwoWay}"
                                     Cursor="Hand"/>
                    </UniformGrid>
                </Border>

                <!-- Top Action Bar: Ordered [Chat Sementara] [Pengaturan Run] [OpenPane] (Flat Minimalist Icons, No Round Circles) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnAITemporaryChat"
                            Command="{Binding ToggleTemporaryChatCommand}"
                            Width="28" Height="28" Padding="0"
                            ToolTip="Chat sementara" AutomationProperties.Name="Chat sementara">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NexusIconButtonStyle}">
                                <Setter Property="Margin" Value="0,0,4,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAiCheckModeActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTemporaryChat}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock services:NexusIcon.Glyph="Chat" FontSize="14" Foreground="{DynamicResource DshTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnAIRunSettings"
                            Command="{Binding ToggleRunSettingsCommand}"
                            Width="28" Height="28" Padding="0"
                            ToolTip="Pengaturan run" AutomationProperties.Name="Pengaturan run">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NexusIconButtonStyle}">
                                <Setter Property="Margin" Value="0,0,4,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAiCheckModeActive}" Value="True">
                                        <Setter Property="Margin" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock services:NexusIcon.Glyph="Settings" FontSize="14" Foreground="{DynamicResource DshTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnAIToggleDiffReview"
                            Click="OpenDiffReviewPreview_Click"
                            Width="26" Height="26" Padding="0"
                            ToolTip="Tinjau perubahan &amp; panel kode"
                            AutomationProperties.Name="Tinjau perubahan">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NexusIconButtonStyle}">
                                <Setter Property="Margin" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAiCheckModeActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AgentWorkspace.IsOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Border Width="14" Height="13" CornerRadius="2" BorderBrush="{DynamicResource DshTextSecondaryBrush}" BorderThickness="1.3" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="1.2" HorizontalAlignment="Right" Margin="0,0,3.5,0" Background="{DynamicResource DshTextSecondaryBrush}"/>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>

        <!-- Main Workspace Area -->
        <Grid x:Name="AIWorkspaceMain" Grid.Row="1"
              Grid.Column="1"
              SizeChanged="AIWorkspaceMain_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ContextSplitterColumn" Width="0"/><ColumnDefinition x:Name="ContextReviewColumn" Width="0"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height='Auto'/>
                <RowDefinition Height='*'/>
                <RowDefinition Height='Auto'/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="24,0,24,12" Padding="14,12" Background="{DynamicResource DshCardBgBrush}" BorderBrush="{DynamicResource DshBorderL2Brush}" BorderThickness="1" CornerRadius="{DynamicResource NexusRadiusSmall}" Visibility="{Binding AgentWorkspace.HasActivity, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"><Button Content="Tinjau perubahan" Command="{Binding OpenAgentWorkspaceCommand}" Style="{StaticResource AIWorkspacePillButtonStyle}"/><Button Content="Batalkan tugas" Command="{Binding AgentWorkspace.CancelCommand}" Style="{StaticResource AIWorkspacePillButtonStyle}" Margin="8,0,0,0"/></WrapPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AgentWorkspace.FriendlyStatus}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{Binding AgentWorkspace.RemainingText}" FontSize="11.5" Foreground="{DynamicResource DshTextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding AgentWorkspace.HasReviewFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AgentWorkspace.ChangeTotals}" FontFamily="Consolas" Foreground="{DynamicResource DshTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AgentWorkspace.ChangeSummary}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding AgentWorkspace.ReviewFiles}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding DataContext.AgentWorkspace.SelectReviewFileCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ConversationView}}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}" HorizontalContentAlignment="Stretch" Padding="10,6" Margin="0,0,0,4">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AIWorkspacePillButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeFocus}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Statistics}" FontFamily="Consolas" Foreground="{DynamicResource DshTextSecondaryBrush}" Margin="12,0,0,0"/><TextBlock Text="{Binding Target}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}"/></DockPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name='AIChatPanelBorder'
                    Grid.Row='1'
                    Panel.ZIndex="0"
                    Margin='0,0,0,14'
                    CornerRadius='24'
                    Background='Transparent'
                    BorderBrush='Transparent'
                    BorderThickness='0'
                    Padding='0'>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height='*'/>
                        <RowDefinition Height='Auto'/>
                    </Grid.RowDefinitions>
                    
                    <!-- Chat Scroll & Messages (Nexus Bubble Parity) -->
                    <ScrollViewer x:Name='AIChatScroll' Grid.Row='0' VerticalScrollBarVisibility='Visible'
                                  HorizontalScrollBarVisibility='Disabled' ScrollChanged="AIChatScroll_ScrollChanged">
                        <Border x:Name="AIChatReadingFrame" MaxWidth='{StaticResource NexusAIWorkspaceReadingFrameMaxWidth}'
                                Margin='{DynamicResource AIWorkspaceActiveReadingGutter}'
                                Padding='0,30,0,0'>
                        <ItemsControl x:Name='AIChatItems' ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="UserMessageHoverRoot"
                                          Margin="0,4,0,8"
                                          Background="Transparent">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    <!-- Sent Attachments Cards (Standalone, right-aligned) -->
                                    <ItemsControl Grid.Row="0"
                                                  ItemsSource="{Binding Attachments}"
                                                  ItemTemplate="{StaticResource SentAttachmentChipTemplate}"
                                                  Margin="0,0,0,6">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <!-- Message Content Bubble -->
                                    <Border Grid.Row="1" CornerRadius="{Binding BubbleCornerRadius}" Padding="{Binding BubblePadding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="MaxWidth" Value="680"/>
                                                        <Setter Property="Background" Value="{DynamicResource AIWorkspaceUserBubbleBackgroundBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <StackPanel>
                                            <!-- Thinking / Generating Placeholder Indicator -->
                                            <Border x:Name="ThinkingIndicator"
                                                    Margin="0,4,0,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ProgressBar IsIndeterminate="True"
                                                                 Width="36"
                                                                 Height="3"
                                                                 Margin="0,0,10,0"
                                                                 VerticalAlignment="Center"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 Foreground="{DynamicResource NexusAccentPrimary}"/>
                                                    <TextBlock Text="{Binding ThinkingStatus}"
                                                               FontSize="{StaticResource NexusTypographyBodyCompactSize}"
                                                               Foreground="{DynamicResource NexusForegroundSecondary}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Real Thinking Container (DeepSeek Harness Minimalist Timeline Parity: image_4161ab.png & image_415e88.png) -->
                                            <Border x:Name="RealThinkingContainer"
                                                    Margin="0,2,0,10"
                                                    Padding="0,2,0,8"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource DshBorderL1Brush}"
                                                    BorderThickness="0,0,0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <!-- Minimalist Header: "Completed in Xs v" (No gray box, no blue hover rectangle) -->
                                                    <Button Command="{Binding ToggleThinkingCollapseCommand}"
                                                            Style="{StaticResource NexusSubtleButtonStyle}"
                                                            Height="24"
                                                            MinHeight="24"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="2,1"
                                                            HorizontalAlignment="Left"
                                                            Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ThinkingDurationText}"
                                                                       FontSize="12.5"
                                                                       Foreground="{DynamicResource DshTextSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>
                                                            <Path Width="9" Height="9"
                                                                  Stroke="{DynamicResource DshTextSecondaryBrush}"
                                                                  StrokeThickness="1.3"
                                                                  Stretch="Uniform"
                                                                  VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Data" Value="{StaticResource DshIconChevronUp}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsThinkingCollapsed}" Value="True">
                                                                                <Setter Property="Data" Value="{StaticResource DshIconChevronDown}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Codex / ChatGPT Expandable Step-by-Step Browser Timeline (Gambar 4 image_ddc42a.png 1:1 Typography & Spacing) -->
                                                    <Border Margin="7,4,0,8"
                                                            Padding="14,3,0,3"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource DshBorderL2Brush}"
                                                            BorderThickness="1,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasCodexBrowserSteps}" Value="True"/>
                                                                            <Condition Binding="{Binding IsThinkingCollapsed}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ItemsControl ItemsSource="{Binding CodexBrowserSteps}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,2,0,2">
                                                                        <Button Command="{Binding ToggleStepDetailCommand}"
                                                                                Style="{StaticResource NexusSubtleButtonStyle}"
                                                                                Height="28"
                                                                                MinHeight="28"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Padding="4,3"
                                                                                HorizontalAlignment="Left"
                                                                                Cursor="Hand"
                                                                                ToolTip="Klik untuk melihat detail status browser / elemen fokus pada langkah ini">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Grid Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                                    <Path Width="14" Height="14"
                                                                                          Stretch="Uniform"
                                                                                          Stroke="{DynamicResource DshTextSecondaryBrush}"
                                                                                          StrokeThickness="1.3"
                                                                                          Opacity="0.82"
                                                                                          SnapsToDevicePixels="True"
                                                                                          UseLayoutRounding="True"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          Data="M 2,3 H 14 A 1.5,1.5 0 0 1 15.5,4.5 V 11.5 A 1.5,1.5 0 0 1 14,13 H 9.5 M 2,6 H 15.5 M 2,3 A 1.5,1.5 0 0 0 0.5,4.5 V 11.5 A 1.5,1.5 0 0 0 2,13 H 4.5 M 5.5,10.5 L 9.5,12.5 L 7.5,13.5 L 6.5,15.5 Z">
                                                                                        <Path.Style>
                                                                                            <Style TargetType="Path">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding HasFaviconImageUrl}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Path.Style>
                                                                                    </Path>
                                                                                    <Image Width="16" Height="16"
                                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                                           SnapsToDevicePixels="True"
                                                                                           UseLayoutRounding="True"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           Source="{Binding FaviconImageUrl, TargetNullValue={x:Null}}"
                                                                                           Visibility="{Binding HasFaviconImageUrl, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                </Grid>
                                                                                <TextBlock Text="{Binding StepTitle}"
                                                                                           FontSize="13"
                                                                                           FontWeight="Normal"
                                                                                           Foreground="{DynamicResource DshTextSecondaryBrush}"
                                                                                           Opacity="0.88"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Border Margin="26,2,0,4"
                                                                                Padding="10,6"
                                                                                CornerRadius="8"
                                                                                Background="{DynamicResource DshSidebarBgBrush}"
                                                                                BorderBrush="{DynamicResource DshBorderL1Brush}"
                                                                                BorderThickness="1"
                                                                                Visibility="{Binding IsDetailExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding StepDetailText}"
                                                                                       FontFamily="Consolas"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource DshTextSecondaryBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       LineHeight="16"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>

                                                    <!-- Expanded Timeline Body (Clean left 1.5px border line only, no extra headers) -->
                                                    <Border Margin="6,4,0,2"
                                                            Padding="10,2,0,2"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource DshBorderL2Brush}"
                                                            BorderThickness="1.5,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThinkingCollapsed}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBrowserAgentCollapsibleCard}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ReasoningContent}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource DshTextSecondaryBrush}"
                                                                   LineHeight="19"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <rendering:MessageContentPresenter
                                                Document="{Binding RenderedDocument}"
                                                FallbackText="{Binding Content}"
                                                SizeToContent="{Binding IsUser}"/>

                                            <!-- Batch E.2: Inline Chat Canvas Card ([ Kode | Pratinjau ] & [ Ekspor v ] matching image_41a758.png & image_41235b.png) -->
                                            <Border x:Name="InlineChatCanvasCollapsedChip"
                                                    Margin="0,8,0,4"
                                                    Padding="12,7"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource DshSidebarBgBrush}"
                                                    BorderBrush="{DynamicResource DshBorderL2Brush}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding IsCanvasCollapsedChipVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource NexusAccentPrimary}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="≡" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding CanvasTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource DshTextPrimaryBrush}" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    <Button Content="Buka Canvas" Command="{Binding ToggleCanvasCloseCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Padding="8,2" FontSize="11.5" Cursor="Hand"/>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="InlineChatCanvasCard"
                                                    Margin="0,10,0,6"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource DshCardBgBrush}"
                                                    BorderBrush="{DynamicResource DshBorderL2Brush}"
                                                    BorderThickness="1"
                                                    Visibility="{Binding IsCanvasCardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <!-- Canvas Top Header Bar: [ Icon + Title ] ... [ Kode | Pratinjau ] [ Ekspor v ] [ Maximize ] [ Close ] -->
                                                    <Border Height="42"
                                                            CornerRadius="14,14,0,0"
                                                            Background="{DynamicResource DshSidebarBgBrush}"
                                                            BorderBrush="{DynamicResource DshBorderL1Brush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="14,0,10,0">
                                                        <DockPanel LastChildFill="True">
                                                            <!-- Right Header Action Controls -->
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- [ Kode | Pratinjau ] Segmented Toggle Pill -->
                                                                <Border Height="28"
                                                                        CornerRadius="14"
                                                                        Background="{DynamicResource DshBorderL1Brush}"
                                                                        Padding="2"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Command="{Binding SetCanvasCodeModeCommand}"
                                                                                Style="{StaticResource NexusSubtleButtonStyle}"
                                                                                Height="24"
                                                                                Padding="10,0"
                                                                                FontSize="11.5"
                                                                                Cursor="Hand"
                                                                                Content="Kode">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="SegKodeBd" CornerRadius="12" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCanvasCodeMode}" Value="True">
                                                                                            <Setter TargetName="SegKodeBd" Property="Background" Value="{DynamicResource DshCardBgBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                        <Button Command="{Binding SetCanvasPreviewModeCommand}"
                                                                                Style="{StaticResource NexusSubtleButtonStyle}"
                                                                                Height="24"
                                                                                Padding="10,0"
                                                                                FontSize="11.5"
                                                                                Cursor="Hand"
                                                                                Content="Pratinjau">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="SegPrevBd" CornerRadius="12" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCanvasPreviewMode}" Value="True">
                                                                                            <Setter TargetName="SegPrevBd" Property="Background" Value="{DynamicResource DshCardBgBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- [ Ekspor v ] Pill Dropdown Button + Popup -->
                                                                <Grid VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <Button x:Name="BtnCanvasExportDropdown"
                                                                            Command="{Binding ToggleCanvasExportMenuCommand}"
                                                                            Style="{StaticResource NexusSubtleButtonStyle}"
                                                                            Height="28"
                                                                            Padding="11,0"
                                                                            Cursor="Hand"
                                                                            ToolTip="Ekspor dokumen atau tabel Canvas (.pdf, .xlsx, .md)">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border CornerRadius="14"
                                                                                        Background="{DynamicResource DshBorderL1Brush}"
                                                                                        BorderBrush="{DynamicResource DshBorderL2Brush}"
                                                                                        BorderThickness="1"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock services:NexusIcon.Glyph="Save" FontSize="11.5" Foreground="{DynamicResource DshTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                                        <TextBlock Text="Ekspor" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                                        <Path Data="{StaticResource DshIconChevronDown}" Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.3" VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Popup IsOpen="{Binding IsCanvasExportMenuOpen, Mode=TwoWay}"
                                                                           PlacementTarget="{Binding ElementName=BtnCanvasExportDropdown}"
                                                                           Placement="Bottom"
                                                                           StaysOpen="False"
                                                                           AllowsTransparency="True">
                                                                        <Border Margin="4"
                                                                                Padding="6"
                                                                                CornerRadius="10"
                                                                                Background="{DynamicResource DshCardBgBrush}"
                                                                                BorderBrush="{DynamicResource DshBorderL2Brush}"
                                                                                BorderThickness="1"
                                                                                MinWidth="190">
                                                                            <StackPanel>
                                                                                <Button Command="{Binding ExportCanvasPdfCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Height="30" Padding="10,0" HorizontalContentAlignment="Left" FontSize="12" Content="Ekspor ke PDF (.pdf)" Cursor="Hand"/>
                                                                                <Button Command="{Binding ExportCanvasXlsxCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Height="30" Padding="10,0" HorizontalContentAlignment="Left" FontSize="12" Content="Ekspor ke Excel (.xlsx)" Cursor="Hand"/>
                                                                                <Button Command="{Binding ExportCanvasRawCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Height="30" Padding="10,0" HorizontalContentAlignment="Left" FontSize="12" Content="Simpan Berkas Asli (.md / .cmd)" Cursor="Hand"/>
                                                                                <Border Height="1" Background="{DynamicResource DshBorderL1Brush}" Margin="4,3"/>
                                                                                <Button Command="{Binding CopyCanvasContentCommand}" Style="{StaticResource NexusSubtleButtonStyle}" Height="30" Padding="10,0" HorizontalContentAlignment="Left" FontSize="12" Content="Salin Isi ke Clipboard" Cursor="Hand"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Popup>
                                                                </Grid>

                                                                <!-- [ Maximize ] & [ Close ] Icon Buttons -->
                                                                <Button Command="{Binding ToggleCanvasMaximizeCommand}"
                                                                        Style="{StaticResource NexusIconButtonStyle}"
                                                                        Width="26"
                                                                        Height="26"
                                                                        Margin="0,0,2,0"
                                                                        ToolTip="Perlebar / kembalikan tinggi pratinjau Canvas">
                                                                    <TextBlock services:NexusIcon.Glyph="FullScreen" FontSize="11.5" Foreground="{DynamicResource DshTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                                <Button Command="{Binding ToggleCanvasCloseCommand}"
                                                                        Style="{StaticResource NexusIconButtonStyle}"
                                                                        Width="26"
                                                                        Height="26"
                                                                        ToolTip="Ciutkan kartu Canvas">
                                                                    <Path Data="{StaticResource DshIconClose}" Width="9" Height="9" Stretch="Uniform" Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- Left Header Title with Blue Document Icon + Argon Live Building Indicator -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource NexusAccentPrimary}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="≡" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding CanvasTitle}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource DshTextPrimaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="260"/>
                                                                <TextBlock Text="{Binding CanvasStatusBadgeText}"
                                                                           FontSize="11.5"
                                                                           FontWeight="Medium"
                                                                           Foreground="{DynamicResource NexusAccentPrimary}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="10,0,0,0"
                                                                           Visibility="{Binding HasCanvasStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>

                                                    <!-- Export Status Toast Row (Visible when exported) -->
                                                    <Border Padding="14,6"
                                                            Background="{DynamicResource DshSidebarBgBrush}"
                                                            BorderBrush="{DynamicResource DshBorderL1Brush}"
                                                            BorderThickness="0,0,0,1"
                                                            Visibility="{Binding HasCanvasExportStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding CanvasExportStatusText}"
                                                                   FontSize="11.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource NexusAccentPrimary}"/>
                                                    </Border>

                                                    <!-- Canvas Body Area (Scrollable, supports Pratinjau & Kode modes) -->
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  MaxHeight="{Binding CanvasBodyMaxHeight}"
                                                                  Padding="24,20">
                                                        <Grid>
                                                            <!-- MODE 1: PRATINJAU (Editorial Document / Report View matching image_41a758.png) -->
                                                            <StackPanel Visibility="{Binding IsCanvasPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding CanvasPreviewHeadline}"
                                                                           FontSize="20"
