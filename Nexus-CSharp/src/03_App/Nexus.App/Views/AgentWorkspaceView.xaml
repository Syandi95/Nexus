<UserControl x:Class="Nexus.App.Views.AgentWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:Nexus.App.Services"
 Background="{DynamicResource NexusSurfaceBase}" Foreground="{DynamicResource NexusForegroundPrimary}"
 Loaded="View_Loaded" Unloaded="View_Unloaded" SizeChanged="View_SizeChanged" DataContextChanged="View_DataContextChanged">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  <Style TargetType="Button" BasedOn="{StaticResource NexusSecondaryButtonStyle}"/>
  <Style TargetType="TextBox" BasedOn="{StaticResource NexusTextBoxStyle}"/>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource NexusForegroundSecondary}"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="0,4"/></Style>
  <Style x:Key="AgentDocumentStyle" TargetType="TextBox" BasedOn="{StaticResource NexusTextBoxStyle}">
   <Setter Property="Height" Value="Auto"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="VerticalContentAlignment" Value="Top"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
   <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border x:Name="DocumentChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource NexusRadiusSmall}">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
       HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
       VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DocumentChrome" Property="BorderBrush" Value="{DynamicResource NexusStrokeFocus}"/></Trigger>
      <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="DocumentChrome" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="AgentPaneStyle" TargetType="Border">
   <Setter Property="Padding" Value="16"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeSubtle}"/>
   <Setter Property="CornerRadius" Value="{DynamicResource NexusRadiusSmall}"/>
   <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
  </Style>
  <Style x:Key="ReviewFileButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusSecondaryButtonStyle}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,4"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeFocus}"/><Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="StartGuideCapsuleStyle" TargetType="Border">
   <Setter Property="Width" Value="348"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL2Brush}"/>
   <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
   <Setter Property="Padding" Value="16,12"/>
   <Setter Property="Margin" Value="0,0,0,10"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="{DynamicResource DshSidebarHoverBrush}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource DshBorderL3Brush}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="0" KeyboardNavigation.TabNavigation="Continue">
  <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="0"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TabControl x:Name="CompactTabs" Grid.Row="2" Margin="0" Visibility="Collapsed"
   Style="{StaticResource NexusWorkspaceTabControlStyle}" ItemContainerStyle="{StaticResource NexusWorkspaceTabItemStyle}"
   SelectionChanged="CompactTabs_SelectionChanged" AutomationProperties.Name="Agent Request Review tabs" KeyboardNavigation.TabIndex="0">
   <TabItem Header="Request" AutomationProperties.Name="Agent Request tab"/><TabItem Header="Review" AutomationProperties.Name="Agent Review tab"/>
  </TabControl>
  <Grid x:Name="BodyGrid" Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="RequestColumn" Width="36*" MinWidth="320"/><ColumnDefinition x:Name="SplitterColumn" Width="8"/><ColumnDefinition x:Name="ReviewColumn" Width="64*" MinWidth="400"/></Grid.ColumnDefinitions>
   <Border x:Name="RequestPane" Grid.Column="0" Style="{StaticResource AgentPaneStyle}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Proyek dan permintaan" FontSize="14" FontWeight="SemiBold"/>
        <Button x:Name="SelectWorkspaceButton" Content="Pilih proyek" Click="SelectWorkspace_Click" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Pilih proyek" KeyboardNavigation.TabIndex="1"/>
        <TextBlock x:Name="WorkspaceEmptyState" Text="Anda tetap bisa bertanya. Untuk mengedit kode, pilih proyek yang sudah didukung Nexus." TextWrapping="Wrap" Foreground="{DynamicResource NexusForegroundSecondary}" Margin="0,8">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="{Binding Workspace}" TextWrapping="Wrap" Margin="0,8" FontSize="12"/>
       <StackPanel IsEnabled="{Binding CanEdit}">
        <Label Content="_Coding request" Target="{Binding ElementName=RequestInput}"/>
        <TextBox x:Name="RequestInput" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="82" Padding="12,8" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Coding request" KeyboardNavigation.TabIndex="2"/>
        <TextBlock Text="Literal intent · Product/Alpha.cs" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,4"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><Label Content="Alpha _Old" Target="{Binding ElementName=AlphaOldInput}"/><TextBox x:Name="AlphaOldInput" Text="{Binding AlphaOld, UpdateSourceTrigger=PropertyChanged}" Height="56" Padding="8,4" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="Consolas" AutomationProperties.Name="Alpha Old literal" KeyboardNavigation.TabIndex="3"/></StackPanel>
         <StackPanel Grid.Column="2"><Label Content="Alpha _New" Target="{Binding ElementName=AlphaNewInput}"/><TextBox x:Name="AlphaNewInput" Text="{Binding AlphaNew, UpdateSourceTrigger=PropertyChanged}" Height="56" Padding="8,4" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="Consolas" AutomationProperties.Name="Alpha New literal" KeyboardNavigation.TabIndex="4"/></StackPanel>
        </Grid>
        <TextBlock Text="Literal intent · Product/Beta.cs" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,4"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><Label Content="Beta O_ld" Target="{Binding ElementName=BetaOldInput}"/><TextBox x:Name="BetaOldInput" Text="{Binding BetaOld, UpdateSourceTrigger=PropertyChanged}" Height="56" Padding="8,4" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="Consolas" AutomationProperties.Name="Beta Old literal" KeyboardNavigation.TabIndex="5"/></StackPanel>
         <StackPanel Grid.Column="2"><Label Content="Beta N_ew" Target="{Binding ElementName=BetaNewInput}"/><TextBox x:Name="BetaNewInput" Text="{Binding BetaNew, UpdateSourceTrigger=PropertyChanged}" Height="56" Padding="8,4" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="Consolas" AutomationProperties.Name="Beta New literal" KeyboardNavigation.TabIndex="6"/></StackPanel>
        </Grid>
       </StackPanel>
       <TextBlock Text="Exact user literals · Gamma unchanged · bukan arbitrary-project coding" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource NexusForegroundSecondary}" Margin="0,12,0,8"/>
      </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
       <Button x:Name="RunAgentButton" Content="Jalankan" Command="{Binding RunCommand}" AutomationProperties.Name="Jalankan" Margin="0,0,8,0" KeyboardNavigation.TabIndex="7"/>
       <Button x:Name="CancelAgentButton" Content="Batalkan tugas" Command="{Binding CancelCommand}" AutomationProperties.Name="Batalkan tugas" KeyboardNavigation.TabIndex="8"/>
     </StackPanel>
    </Grid>
   </Border>
   <GridSplitter x:Name="DesktopSplitter" Grid.Column="1" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Focusable="True" KeyboardIncrement="16" DragIncrement="8" Background="{DynamicResource NexusStrokeSubtle}" FocusVisualStyle="{DynamicResource NexusFocusVisualStyle}" AutomationProperties.Name="Resize Agent request and review panes" KeyboardNavigation.TabIndex="9"/>
   <Border x:Name="ReviewPane" Grid.Column="2" Style="{StaticResource AgentPaneStyle}" BorderThickness="0" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="38" MaxHeight="185"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="SecondaryReviewControls" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <!-- Row 1: DeepSeek Harness Slim Single-Row Tab Strip (26px Pill Height, 0-Shift OpenPane Alignment) -->
     <Border BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="0,0,0,1" Padding="10,9,10,9">
      <DockPanel LastChildFill="True">
       <!-- Far-Right Chrome Controls: [Split/View] [Expand] [Collapse] (Exact 26x26 at Right=10, Top=9 matching ConversationView) -->
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
        <Button Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="ToggleMarkdownOrCodeMode_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Beralih tampilan (Pratinjau / Kode)">
         <Border Width="13" Height="12" CornerRadius="2" BorderBrush="{DynamicResource DshTextSecondaryBrush}" BorderThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Width="1.2" HorizontalAlignment="Center" Background="{DynamicResource DshTextSecondaryBrush}"/>
         </Border>
        </Button>
        <Button Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="ToggleExpandReviewWidth_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Perlebar atau kecilkan panel" AutomationProperties.Name="Perlebar panel">
         <TextBlock services:NexusIcon.Glyph="FullScreen" FontSize="12" Foreground="{DynamicResource DshTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button Width="26" Height="26" Padding="0" Command="{Binding HideReviewCommand}" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Sembunyikan panel" AutomationProperties.Name="Tutup tinjauan" KeyboardNavigation.TabIndex="90">
         <Border Width="14" Height="13" CornerRadius="2" BorderBrush="{DynamicResource DshTextSecondaryBrush}" BorderThickness="1.3" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Width="1.2" HorizontalAlignment="Right" Margin="0,0,3.5,0" Background="{DynamicResource DshTextSecondaryBrush}"/>
         </Border>
        </Button>
       </StackPanel>

       <!-- Single-Row Strip: [📁 Files] | [Document Tabs...] [>_ cmd.exe ×] [🌐 Browser ×] [🧭 Start ×] [+] -->
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
        <!-- Permanent "Files" Tab Pill (26px height) -->
        <Border x:Name="FilesTabChip" Height="26" CornerRadius="6" Padding="8,0" Margin="0,0,2,0" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="FilesTabChip_MouseDown" ToolTip="Telusuri berkas workspace (Ctrl+P)">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock services:NexusIcon.Glyph="Folder" FontSize="12.5" Foreground="{DynamicResource NexusWarningForeground}" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <TextBlock x:Name="FilesTabChipText" Text="Files" FontSize="12" Foreground="{DynamicResource DshTextSecondaryBrush}" VerticalAlignment="Center"/>
         </StackPanel>
        </Border>
        <Border x:Name="FilesTabDivider" Width="1" Height="13" VerticalAlignment="Center" Background="{DynamicResource DshBorderL2Brush}" Margin="2,0,4,0"/>

        <!-- Document Review File Tabs (Sleek 26px height matching image_41483f.png & image_41443f.png) -->
        <TabControl x:Name="ReviewFileTabs" ItemsSource="{Binding OpenReviewFiles}" SelectedItem="{Binding SelectedReviewFile, Mode=TwoWay}" Style="{StaticResource NexusWorkspaceTabControlStyle}" Background="Transparent" BorderThickness="0" ClipToBounds="True" AutomationProperties.Name="File perubahan yang dibuka" Margin="0" PreviewMouseLeftButtonDown="ReviewFileTabs_PreviewMouseDown">
         <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
           <Border Background="Transparent" BorderThickness="0" ClipToBounds="True">
            <StackPanel Orientation="Horizontal" IsItemsHost="True" HorizontalAlignment="Left" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Local"/>
           </Border>
          </ControlTemplate>
         </TabControl.Template>
         <TabControl.ItemContainerStyle>
          <Style TargetType="TabItem" BasedOn="{StaticResource NexusWorkspaceTabItemStyle}">
           <Setter Property="Height" Value="26"/>
           <Setter Property="MinHeight" Value="26"/>
           <Setter Property="MaxHeight" Value="26"/>
           <Setter Property="Padding" Value="8,0"/>
           <Setter Property="Margin" Value="0,0,2,0"/>
           <Setter Property="Background" Value="Transparent"/>
           <Setter Property="BorderThickness" Value="0"/>
           <Setter Property="Foreground" Value="{DynamicResource DshTextSecondaryBrush}"/>
           <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
           <Setter Property="Template">
            <Setter.Value>
             <ControlTemplate TargetType="TabItem">
              <Grid Height="26" VerticalAlignment="Center">
               <Border x:Name="TabPill" Height="26" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
               </Border>
               <Border x:Name="TabDivider" Width="1" Height="13" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource DshBorderL2Brush}" Margin="0,0,-1,0"/>
              </Grid>
              <ControlTemplate.Triggers>
               <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource DshSidebarHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DshTextPrimaryBrush}"/>
               </Trigger>
               <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                <Setter TargetName="TabDivider" Property="Visibility" Value="Collapsed"/>
                <Setter Property="Foreground" Value="{DynamicResource DshTextPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
               </Trigger>
              </ControlTemplate.Triggers>
             </ControlTemplate>
            </Setter.Value>
           </Setter>
          </Style>
         </TabControl.ItemContainerStyle>
         <TabControl.ItemTemplate><DataTemplate>
          <StackPanel Orientation="Horizontal" ToolTip="{Binding Target}" VerticalAlignment="Center">
           <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource NexusAccentPrimary}" VerticalAlignment="Center" Margin="0,0,5,0">
            <TextBlock Text="{Binding FileExtensionBadge}" FontFamily="Consolas" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource NexusForegroundOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <TextBlock Text="{Binding FileName}" FontSize="12" MaxWidth="124" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
           <TextBlock Text="{Binding DisplayStatistics}" Visibility="{Binding HasDiffChanges, Converter={StaticResource BooleanToVisibilityConverter}}" FontFamily="Consolas" Foreground="{DynamicResource DshTextSecondaryBrush}" Margin="5,0,2,0" FontSize="10.5" VerticalAlignment="Center"/>
           <Button Width="16" Height="16" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource NexusIconButtonStyle}" Command="{Binding DataContext.CloseReviewFileCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}" PreviewMouseLeftButtonDown="CloseReviewTab_MouseDown" AutomationProperties.Name="{Binding Target, StringFormat='Tutup tab {0}'}">
            <Path Data="{StaticResource DshIconClose}" Width="8" Height="8" Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Button>
          </StackPanel>
         </DataTemplate></TabControl.ItemTemplate>
        </TabControl>

        <!-- ">_ cmd.exe" Tab Chip (matching image_41483f.png) -->
        <Border x:Name="CmdTabChip" Visibility="Collapsed" Height="26" CornerRadius="6" Padding="8,0" Margin="2,0,2,0" Background="{DynamicResource NexusSurfaceSunken}" Cursor="Hand" MouseLeftButtonDown="CmdTabChip_MouseDown">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DshTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock x:Name="CmdTabChipText" Text="cmd.exe" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}" VerticalAlignment="Center"/>
          <Button Width="16" Height="16" Padding="0" Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource NexusIconButtonStyle}" Click="CloseCmdTab_Click" ToolTip="Tutup cmd.exe">
           <Path Data="{StaticResource DshIconClose}" Width="8" Height="8" Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
         </StackPanel>
        </Border>

        <!-- "🌐 Browser" Tab Chip (matching image_41443f.png) -->
        <Border x:Name="BrowserTabChip" Visibility="Collapsed" Height="26" CornerRadius="6" Padding="8,0" Margin="2,0,2,0" Background="{DynamicResource NexusSurfaceSunken}" Cursor="Hand" MouseLeftButtonDown="BrowserTabChip_MouseDown">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="{StaticResource DshIconGlobe}" Width="12" Height="12" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.25" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock x:Name="BrowserTabChipText" Text="Browser" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}" VerticalAlignment="Center"/>
          <Button Width="16" Height="16" Padding="0" Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource NexusIconButtonStyle}" Click="CloseBrowserTab_Click" ToolTip="Tutup Browser">
           <Path Data="{StaticResource DshIconClose}" Width="8" Height="8" Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
         </StackPanel>
        </Border>

        <!-- "🧭 Start" Guide Tab Chip (Visible when Start Guide is open; hides '+' button per sidebar-right.md) -->
        <Border x:Name="StartTabChip" Visibility="Collapsed" Height="26" CornerRadius="6" Padding="8,0" Margin="2,0,2,0" Background="{DynamicResource NexusSurfaceSunken}" Cursor="Hand" MouseLeftButtonDown="StartTabChip_MouseDown">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0">
           <Ellipse Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.3"/>
           <Path Data="M 6.5,2.8 L 8.2,6.5 L 6.5,10.2 L 4.8,6.5 Z" Fill="{DynamicResource DshTextSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><RotateTransform Angle="38"/></Path.RenderTransform>
           </Path>
          </Grid>
          <TextBlock x:Name="StartTabChipText" Text="Start" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}" VerticalAlignment="Center"/>
          <Button Width="16" Height="16" Padding="0" Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource NexusIconButtonStyle}" Click="CloseStartTab_Click" ToolTip="Tutup Start">
           <Path Data="{StaticResource DshIconClose}" Width="8" Height="8" Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
         </StackPanel>
        </Border>

        <!-- "+" Add Tab Control (Visible only while pane has no Start tab per sidebar-right.md) -->
        <Button x:Name="BtnAddStartTab" Width="24" Height="24" Padding="0" Margin="2,0,0,0" Click="OpenStartTab_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Buka tab Start baru">
         <Path Data="{StaticResource DshIconPlus}" Width="11" Height="11" Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
       </StackPanel>
      </DockPanel>
     </Border>

     <!-- Row 2: Slim Document Path & Renderer Bar + Stage C 1-Click Apply Diff Button -->
     <Border x:Name="DocumentPathToolbar" Background="Transparent" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="0,0,0,1" Padding="12,4,10,4">
      <DockPanel LastChildFill="True">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
        <TextBlock x:Name="RendererKindLabel" Text="{Binding SelectedReviewFile.FileLanguageLabel, FallbackValue=Code}" FontSize="12" Foreground="{DynamicResource DshTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="ToggleMarkdownOrCodeMode_Click" ToolTip="Klik untuk mengganti mode tampilan"/>
        <CheckBox x:Name="WrapDiffToggle" ToolTip="Bungkus baris panjang (Word Wrap)" IsChecked="True" Checked="WrapDiff_Changed" Unchecked="WrapDiff_Changed" VerticalAlignment="Center" Margin="0,0,2,0" AutomationProperties.Name="Bungkus baris panjang" KeyboardNavigation.TabIndex="10">
         <CheckBox.Template>
          <ControlTemplate TargetType="CheckBox">
           <Border x:Name="WrapBd" Width="24" Height="22" CornerRadius="5" Background="Transparent" Cursor="Hand">
            <TextBlock Text="&#x21E5;" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DshTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
             <Setter TargetName="WrapBd" Property="Background" Value="{DynamicResource DshSidebarHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
             <Setter TargetName="WrapBd" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
            </Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </CheckBox.Template>
        </CheckBox>
        <Button Width="24" Height="22" Padding="0" Margin="0,0,2,0" Click="ReloadSelectedFile_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Muat ulang berkas">
         <TextBlock services:NexusIcon.Glyph="Refresh" FontSize="11.5" Foreground="{DynamicResource DshTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding SelectedReviewFile.HasDiffChanges, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
         <Button x:Name="PreviousChangeButton" Content="↑" Click="PreviousDiffChange_Click" Padding="3,0" MinWidth="20" MinHeight="20" Style="{StaticResource NexusSubtleButtonStyle}" ToolTip="Blok perubahan sebelumnya" AutomationProperties.Name="Blok perubahan sebelumnya"/>
         <TextBlock x:Name="ChangePositionText" FontFamily="Consolas" Margin="4,0" VerticalAlignment="Center" Foreground="{DynamicResource NexusForegroundSecondary}" FontSize="11"/>
         <Button x:Name="NextChangeButton" Content="↓" Click="NextDiffChange_Click" Padding="3,0" MinWidth="20" MinHeight="20" Style="{StaticResource NexusSubtleButtonStyle}" ToolTip="Blok perubahan berikutnya" AutomationProperties.Name="Blok perubahan berikutnya"/>
         <Button Content="‹" Padding="3,0" MinWidth="20" MinHeight="20" Margin="4,0,0,0" Style="{StaticResource NexusSubtleButtonStyle}" ToolTip="Berkas sebelumnya" Command="{Binding PreviousReviewFileCommand}" AutomationProperties.Name="File sebelumnya"/>
         <Button Content="›" Padding="3,0" MinWidth="20" MinHeight="20" Style="{StaticResource NexusSubtleButtonStyle}" ToolTip="Berkas berikutnya" Command="{Binding NextReviewFileCommand}" AutomationProperties.Name="File berikutnya"/>
         <Button x:Name="BtnApplyDiffToDisk" Content="✓ Terapkan" Click="ApplyDiffToDisk_Click" Padding="8,2" Margin="6,0,0,0" FontSize="11" Style="{StaticResource NexusPrimaryButtonStyle}" ToolTip="Simpan perubahan diff ini ke berkas asli (otomatis backup .bak)"/>
        </StackPanel>
       </StackPanel>
       <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedReviewFile.Target}">
        <Run Text="{Binding SelectedReviewFile.DirectoryPrefix, Mode=OneWay}" Foreground="{DynamicResource DshTextSecondaryBrush}"/><Run Text="{Binding SelectedReviewFile.FileName, Mode=OneWay}" Foreground="{DynamicResource DshTextPrimaryBrush}" FontWeight="Medium"/>
       </TextBlock>
      </DockPanel>
     </Border>

     <!-- Hidden Legacy Status & Technical Details (Preserved for GateI tests) -->
     <Border x:Name="StatusBanner" Height="0" Padding="0" Margin="0" Opacity="0" IsHitTestVisible="False" Background="Transparent" BorderThickness="0" CornerRadius="{DynamicResource NexusRadiusSmall}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ScrollViewer MaxHeight="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="RunStatus" Text="{Binding FriendlyStatus}" FontSize="11" TextWrapping="Wrap" AutomationProperties.Name="{Binding FriendlyStatus}"/>
       </ScrollViewer>
      </Grid>
     </Border>
     <Expander x:Name="TechnicalReviewDetails" Header="Detail plan dan hasil" Margin="0">
      <Expander.Style>
       <Style TargetType="Expander">
        <Setter Property="Height" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
         <Trigger Property="IsExpanded" Value="True">
          <Setter Property="Height" Value="Auto"/>
          <Setter Property="Opacity" Value="1"/>
         </Trigger>
        </Style.Triggers>
       </Style>
      </Expander.Style>
      <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel>
        <Expander x:Name="RawDiffExpander" Header="Diff lengkap · teks asli">
         <TextBox x:Name="ExactDiffReview" Text="{Binding DiffText, Mode=OneWay}" Style="{StaticResource AgentDocumentStyle}" Height="240" MinHeight="180" IsReadOnly="True" TextWrapping="NoWrap" AutomationProperties.Name="Diff lengkap asli" KeyboardNavigation.TabIndex="11"/>
        </Expander>
        <Expander Header="Identitas plan">
         <TextBox x:Name="PlanDetailsReview" Text="{Binding PlanDetails, Mode=OneWay}" Style="{StaticResource AgentDocumentStyle}" Height="100" IsReadOnly="True" TextWrapping="NoWrap" AutomationProperties.Name="Exact plan identity and approval details"/>
        </Expander>
        <TextBlock x:Name="ResultEmptyState" Text="Belum ada hasil pemeriksaan" TextWrapping="Wrap" Foreground="{DynamicResource NexusForegroundSecondary}" Margin="0,6">
         <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasResult}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="0,6"/>
        <Expander Header="Receipt pemeriksaan dan pemulihan">
         <TextBox x:Name="AgentResultReceipt" Text="{Binding ResultText, Mode=OneWay}" Style="{StaticResource AgentDocumentStyle}" Height="180" IsReadOnly="True" TextWrapping="NoWrap" AutomationProperties.Name="Agent result receipt"/>
        </Expander>
       </StackPanel>
      </ScrollViewer>
     </Expander>
     </StackPanel></ScrollViewer>

     <!-- Row 3: Multi-Surface Body (Document / Start Guide / Files / cmd.exe / Browser) -->
     <Border Grid.Row="1" Background="{DynamicResource NexusSurfaceBase}" BorderBrush="{DynamicResource NexusStrokeSubtle}" BorderThickness="0" Padding="0">
      <Grid>
       <!-- SURFACE A: Document Preview (Code with Separate Line Number Gutter / Rendered Markdown / Diff) -->
       <Grid x:Name="DocumentSurfaceGrid">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Slim Code Language & Copy Sub-Banner (matching image_4efd47.png) -->
        <DockPanel x:Name="CodeLanguageBanner" Grid.Row="0" Margin="14,6,12,2">
         <Button DockPanel.Dock="Right" Width="24" Height="24" Padding="0" Click="CopySelectedDiffCode_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Salin isi berkas" AutomationProperties.Name="Salin kode">
          <TextBlock services:NexusIcon.Glyph="Copy" FontSize="12.5" Foreground="{DynamicResource DshTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Button>
         <TextBlock Text="{Binding SelectedReviewFile.CodeBannerLanguage, FallbackValue=csharp}" FontSize="11.5" Foreground="{DynamicResource DshTextTertiaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>
        <!-- 2-Column Viewport: Non-Selectable Line Number Gutter (Col 0) + Pure Code/Markdown RichTextBox (Col 1) -->
        <Grid Grid.Row="1">
         <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LineNumberGutterColumn" Width="42"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Border x:Name="LineNumberGutterBorder" Grid.Column="0" Background="Transparent" IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
          <Canvas x:Name="LineNumberCanvas" Width="38" HorizontalAlignment="Right" IsHitTestVisible="False" ClipToBounds="True"/>
         </Border>
         <RichTextBox x:Name="ColoredDiffReview" Grid.Column="1" IsReadOnly="True" IsDocumentEnabled="True" FontFamily="Consolas" FontSize="12.5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource NexusSurfaceBase}" Foreground="{DynamicResource NexusForegroundPrimary}" BorderThickness="0" Padding="0,2,8,8" AutomationProperties.Name="Diff kode, tambah plus, hapus minus" KeyboardNavigation.TabIndex="10"/>
         <TextBlock x:Name="ReviewEmptyState" Grid.ColumnSpan="2" Text="Belum ada perubahan untuk ditinjau" TextWrapping="Wrap" Margin="16,14" Foreground="{DynamicResource NexusForegroundSecondary}">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasReviewFiles}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Grid>
       </Grid>

       <!-- SURFACE B: "🧭 Start" Guide Page (1:1 Parity with image_4e735a.png) -->
       <ScrollViewer x:Name="StartGuideSurface" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource NexusSurfaceBase}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,32,20,32">
         <!-- Top Muted Compass Icon (48x48) -->
         <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,28">
          <Ellipse Stroke="{DynamicResource DshBorderL2Brush}" StrokeThickness="2.2"/>
          <Path Data="M 24,12 L 28.5,24 L 24,36 L 19.5,24 Z" Fill="{DynamicResource DshBorderL3Brush}" RenderTransformOrigin="0.5,0.5">
           <Path.RenderTransform><RotateTransform Angle="38"/></Path.RenderTransform>
          </Path>
         </Grid>

         <!-- Capsule 1: Workspace files (Ctrl + P) -->
         <Border Style="{StaticResource StartGuideCapsuleStyle}" MouseLeftButtonDown="StartOpenWorkspaceFiles_MouseDown">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" services:NexusIcon.Glyph="FolderOpen" FontSize="16" Foreground="{DynamicResource NexusWarningForeground}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
           <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Workspace files" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}"/>
            <TextBlock Text="Browse files in this session's workspace" FontSize="12" Foreground="{DynamicResource DshTextSecondaryBrush}" Margin="0,2,0,0"/>
           </StackPanel>
           <TextBlock Grid.Column="2" Text="Ctrl + P" FontSize="12" Foreground="{DynamicResource DshTextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </Grid>
         </Border>

         <!-- Capsule 2: New terminal (Ctrl + `) -> Opens ">_ cmd.exe" tab (image_41483f.png) -->
         <Border Style="{StaticResource StartGuideCapsuleStyle}" MouseLeftButtonDown="StartOpenTerminal_MouseDown">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="&gt;_" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource NexusAccentPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
           <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
             <TextBlock Text="New terminal" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}"/>
             <Path Data="{StaticResource DshIconChevronDown}" Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource DshTextSecondaryBrush}" VerticalAlignment="Center" Margin="6,2,0,0"/>
            </StackPanel>
            <TextBlock Text="Run commands in the Session workspace" FontSize="12" Foreground="{DynamicResource DshTextSecondaryBrush}" Margin="0,2,0,0"/>
           </StackPanel>
           <TextBlock Grid.Column="2" Text="Ctrl + `" FontSize="12" Foreground="{DynamicResource DshTextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </Grid>
         </Border>

         <!-- Capsule 3: Browser (Ctrl + T) -> Opens "🌐 Browser" tab (image_41443f.png) -->
         <Border Style="{StaticResource StartGuideCapsuleStyle}" MouseLeftButtonDown="StartOpenBrowser_MouseDown">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Path Grid.Column="0" Data="{StaticResource DshIconGlobe}" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource NexusAccentPrimary}" StrokeThickness="1.25" VerticalAlignment="Center" HorizontalAlignment="Left"/>
           <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Browser" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}"/>
            <TextBlock Text="Browse web pages" FontSize="12" Foreground="{DynamicResource DshTextSecondaryBrush}" Margin="0,2,0,0"/>
           </StackPanel>
           <TextBlock Grid.Column="2" Text="Ctrl + T" FontSize="12" Foreground="{DynamicResource DshTextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </Grid>
         </Border>

         <!-- Capsule 4: More tools (Single line matching image_4e735a.png) -->
         <Border Style="{StaticResource StartGuideCapsuleStyle}" Padding="16,14" MouseLeftButtonDown="StartToggleMoreTools_MouseDown">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" services:NexusIcon.Glyph="Applications" FontSize="15" Foreground="{DynamicResource DshTextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
           <TextBlock Grid.Column="1" Text="More tools" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}" VerticalAlignment="Center"/>
          </Grid>
         </Border>

         <!-- Expandable More Tools Tray -->
         <StackPanel x:Name="MoreToolsDrawer" Visibility="Collapsed" Width="348" Margin="0,4,0,0">
          <Border Style="{StaticResource StartGuideCapsuleStyle}" Padding="14,10" MouseLeftButtonDown="MoreToolsOpenGuidelines_MouseDown">
           <StackPanel>
            <TextBlock Text="Buka Konstitusi AGENTS.md &amp; GEMINI.md" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}"/>
            <TextBlock Text="Tinjau peta repositori baku dan aturan disiplin multi-agen" FontSize="11.5" Foreground="{DynamicResource DshTextSecondaryBrush}" Margin="0,2,0,0"/>
           </StackPanel>
          </Border>
          <Border Style="{StaticResource StartGuideCapsuleStyle}" Padding="14,10" MouseLeftButtonDown="MoreToolsOpenCoreCode_MouseDown">
           <StackPanel>
            <TextBlock Text="Simulasi Live Diff &amp; 1-Klik Terapkan (Stage C)" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource DshTextPrimaryBrush}"/>
            <TextBlock Text="Tampilkan contoh perbandingan perubahan kode (Merah/Hijau) siap pakai" FontSize="11.5" Foreground="{DynamicResource DshTextSecondaryBrush}" Margin="0,2,0,0"/>
           </StackPanel>
          </Border>
         </StackPanel>
        </StackPanel>
       </ScrollViewer>

       <!-- SURFACE C: "📁 Files" Interactive Workspace File Explorer -->
       <Grid x:Name="WorkspaceFilesSurface" Visibility="Collapsed" Background="{DynamicResource NexusSurfaceBase}">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="0,0,0,1" Padding="12,8">
         <DockPanel>
          <Button DockPanel.Dock="Right" Width="26" Height="26" Padding="0" Margin="6,0,0,0" Click="RefreshWorkspaceFiles_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Segarkan daftar berkas">
           <TextBlock services:NexusIcon.Glyph="Refresh" FontSize="12" Foreground="{DynamicResource DshTextSecondaryBrush}"/>
          </Button>
          <TextBox x:Name="WorkspaceFilesFilterBox" TextChanged="WorkspaceFilesFilterBox_TextChanged" Padding="8,4" FontSize="12" VerticalContentAlignment="Center" ToolTip="Filter nama berkas di workspace"/>
         </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6">
         <StackPanel x:Name="WorkspaceFilesListPanel"/>
        </ScrollViewer>
       </Grid>

       <!-- SURFACE D: ">_ cmd.exe" Direct Interactive Console (1:1 Parity with image_41483f.png) -->
       <Grid x:Name="TerminalSurface" Visibility="Collapsed" Background="{DynamicResource NexusSurfaceBase}">
        <TextBox x:Name="TerminalConsoleBox"
                 Style="{StaticResource AgentDocumentStyle}"
                 FontFamily="Consolas"
                 FontSize="12.5"
                 BorderThickness="0"
                 Padding="16,14"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource NexusSurfaceBase}"
                 Foreground="{DynamicResource DshTextPrimaryBrush}"
                 CaretBrush="{DynamicResource DshTextPrimaryBrush}"
                 PreviewKeyDown="TerminalConsoleBox_PreviewKeyDown"/>
       </Grid>

       <!-- SURFACE E: "🌐 Browser" Clean Modern Web & GitHub Reader (1:1 Parity with image_41443f.png) -->
       <Grid x:Name="BrowserSurface" Visibility="Collapsed" Background="{DynamicResource NexusSurfaceBase}">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Browser Navigation Toolbar: [<] [>] [↻] [Enter an HTTP(S) address] [↗] -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource DshBorderL1Brush}" BorderThickness="0,0,0,1" Padding="10,6">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto"/>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
           <Button Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BrowserBack_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Kembali">
            <TextBlock services:NexusIcon.Glyph="ChevronLeft" FontSize="11" Foreground="{DynamicResource DshTextSecondaryBrush}"/>
           </Button>
           <Button Width="26" Height="26" Padding="0" Margin="0,0,4,0" Click="BrowserForward_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Maju">
            <TextBlock services:NexusIcon.Glyph="ChevronRight" FontSize="11" Foreground="{DynamicResource DshTextSecondaryBrush}"/>
           </Button>
           <Button x:Name="BrowserHomeButton" Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BrowserHome_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Beranda (https://www.google.com)">
            <TextBlock services:NexusIcon.Glyph="Home" FontSize="12" Foreground="{DynamicResource DshTextSecondaryBrush}"/>
           </Button>
           <Button Width="26" Height="26" Padding="0" Click="BrowserReload_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Muat ulang halaman">
            <TextBlock services:NexusIcon.Glyph="Refresh" FontSize="12" Foreground="{DynamicResource DshTextSecondaryBrush}"/>
           </Button>
          </StackPanel>
          <Border Grid.Column="1" Height="28" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource DshBorderL2Brush}" Background="{DynamicResource NexusSurfaceBase}" Padding="8,0">
           <Grid VerticalAlignment="Center">
            <TextBox x:Name="BrowserAddressBox"
                     Style="{StaticResource AgentDocumentStyle}"
                     FontFamily="Segoe UI Variable, Segoe UI"
                     FontSize="12"
                     Padding="2,3"
                     Background="Transparent"
                     BorderThickness="0"
                     AcceptsReturn="False"
                     TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     Foreground="{DynamicResource DshTextPrimaryBrush}"
                     VerticalAlignment="Center"
                     KeyDown="BrowserAddressBox_KeyDown"
                     TextChanged="BrowserAddressBox_TextChanged"/>
            <TextBlock x:Name="BrowserAddressWatermark" Text="Enter an HTTP(S) address" FontSize="12" Margin="4,0,0,0" Foreground="{DynamicResource DshTextTertiaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center"/>
           </Grid>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
           <Button x:Name="BrowserAgentControlToggleButton" Width="26" Height="26" Padding="0" Margin="0,0,4,0" Click="BrowserAgentControlToggle_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Tampilkan / Sembunyikan Kontrol Agen (Take the Wheel, Pause, Stop)">
            <TextBlock Text="&#x2699;" FontSize="12.5" Foreground="{DynamicResource DshTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Button>
           <StackPanel x:Name="BrowserAgentControlCollapsiblePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <Button x:Name="BrowserTakeTheWheelButton" Height="26" Padding="8,0" Margin="0,0,4,0" Click="BrowserTakeTheWheel_Click" Style="{StaticResource NexusSubtleButtonStyle}" ToolTip="Take the Wheel / Return Control">
             <TextBlock x:Name="BrowserTakeTheWheelText" Text="Take the Wheel" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DshTextPrimaryBrush}" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="BrowserPauseResumeButton" Height="26" Padding="8,0" Margin="0,0,4,0" Click="BrowserPauseResume_Click" Style="{StaticResource NexusSubtleButtonStyle}" ToolTip="Pause / Resume Agent">
             <TextBlock x:Name="BrowserPauseResumeText" Text="Pause" FontSize="11.5" Foreground="{DynamicResource DshTextSecondaryBrush}" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="BrowserStopAgentButton" Height="26" Padding="8,0" Margin="0,0,4,0" Click="BrowserStopAgent_Click" Style="{StaticResource NexusSubtleButtonStyle}" ToolTip="Stop Agent &amp; Navigation">
             <TextBlock x:Name="BrowserStopAgentText" Text="Stop" FontSize="11.5" Foreground="{DynamicResource DshTextSecondaryBrush}" VerticalAlignment="Center"/>
            </Button>
           </StackPanel>
           <Button Width="26" Height="26" Padding="0" Click="BrowserOpenExternal_Click" Style="{StaticResource NexusIconButtonStyle}" ToolTip="Buka di browser eksternal">
            <TextBlock Text="&#x2197;" FontSize="13" Foreground="{DynamicResource DshTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Button>
          </StackPanel>
         </Grid>
        </Border>
        <!-- Native Chromium WebView2 / WebBrowser Viewport & Empty State -->
        <Grid Grid.Row="1">
         <ContentControl x:Name="CefBrowserHost"
                         Visibility="Collapsed"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Focusable="True"/>
         <RichTextBox x:Name="BrowserReaderBox"
                      Visibility="Collapsed"
                      IsReadOnly="True"
                      IsDocumentEnabled="True"
                      BorderThickness="0"
                      Padding="16,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource NexusSurfaceBase}"
                      Foreground="{DynamicResource DshTextPrimaryBrush}"/>
         <TextBlock x:Name="BrowserEmptyStateText" Text="Enter an HTTP(S) address to start browsing" FontSize="13" Foreground="{DynamicResource DshTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
       </Grid>
      </Grid>
     </Border>

     <!-- Hidden Legacy Approval Controls -->
     <Border Grid.Row="2" Height="0" Padding="0" Margin="0" Opacity="0" BorderThickness="0">
      <DockPanel>
       <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
        <Button x:Name="ApprovePlanButton" Content="Setujui perubahan" Height="0" Style="{StaticResource NexusPrimaryButtonStyle}" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanDecide}" IsDefault="False" AutomationProperties.Name="Setujui seluruh perubahan dalam plan" KeyboardNavigation.TabIndex="12"/>
        <Button x:Name="RejectPlanButton" Content="Tolak perubahan" Height="0" Command="{Binding RejectCommand}" IsEnabled="{Binding CanDecide}" IsCancel="False" AutomationProperties.Name="Tolak perubahan" KeyboardNavigation.TabIndex="13"/>
       </WrapPanel>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding ChangeSummary}" FontSize="11"/>
        <TextBlock x:Name="ReviewBudgetText" Text="{Binding RemainingText}" FontSize="11" AutomationProperties.Name="Sisa eksekusi dan waktu review dari host"/>
       </StackPanel>
      </DockPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
