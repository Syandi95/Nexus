<UserControl x:Class="Nexus.App.Views.DshSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Nexus.App.ViewModels"
             xmlns:services="clr-namespace:Nexus.App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="260">

    <UserControl.Resources>
        <!-- Session Item Context Menu -->
        <ContextMenu x:Key="DshSessionContextMenu">
            <MenuItem Header="Rename" Click="RenameSession_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource DshIconCodeBrackets}" Stroke="{DynamicResource DshTextSecondaryBrush}" StrokeThickness="1.2" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Delete" Click="DeleteSession_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource DshIconTrash}" Stroke="{DynamicResource DshDiffDeletedMarkerBrush}" StrokeThickness="1.2" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Session ListBoxItem Style (DeepSeek Harness Parity) -->
        <Style x:Key="DshSessionItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,1,4,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenu" Value="{StaticResource DshSessionContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemHost"
                                CornerRadius="{DynamicResource DshRadiusMd}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Margin="0"
                                Padding="8,5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemHost" Property="Background" Value="{DynamicResource DshSidebarHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemHost" Property="Background" Value="{DynamicResource DshSidebarActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Session Item DataTemplate -->
        <DataTemplate x:Key="DshSessionTemplate">
            <Grid Height="24" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Active Indicator Pill -->
                <Border Grid.Column="0"
                        Width="3"
                        Height="14"
                        CornerRadius="1.5"
                        Background="{DynamicResource DshAccentPrimaryBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Title / Rename TextBox -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="13"
                               Foreground="{DynamicResource DshTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="RenameBox"
                             Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="RenameBox_PreviewKeyDown"
                             IsVisibleChanged="RenameBox_IsVisibleChanged"
                             Padding="2,1"
                             FontSize="13"
                             Background="{DynamicResource DshInputMajorBgBrush}"
                             Foreground="{DynamicResource DshTextPrimaryBrush}"
                             BorderBrush="{DynamicResource DshAccentPrimaryBrush}"
                             BorderThickness="1"
                             VerticalAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Hover Quick Delete Button -->
                <Button Grid.Column="2"
                        x:Name="BtnQuickDelete"
                        Width="22" Height="22"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Click="QuickDelete_Click"
                        ToolTip="Delete session">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DshIconButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource DshIconClose}" Stroke="{DynamicResource DshTextTertiaryBrush}" StrokeThickness="1.2" Width="10" Height="10"/>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="SidebarContainer"
            Background="{DynamicResource DshSidebarBgBrush}"
            CornerRadius="12,0,0,0"
            BorderBrush="{DynamicResource DshBorderL2Brush}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True"
            SnapsToDevicePixels="True">

        <Grid>
            <!-- ==================================================== -->
            <!-- EXPANDED SIDEBAR VIEW (Width: 260px)                 -->
            <!-- ==================================================== -->
            <Grid x:Name="ExpandedView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header / Brand & Toggle -->
                    <RowDefinition Height="Auto"/> <!-- New Session Action -->
                    <RowDefinition Height="Auto"/> <!-- Search Box -->
                    <RowDefinition Height="*"/>    <!-- Session List -->
                    <RowDefinition Height="Auto"/> <!-- Footer / Settings -->
                </Grid.RowDefinitions>

                <!-- 1. Header: Brand & Collapse Toggle -->
                <Grid Grid.Row="0" Margin="14,12,12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource NexusAccentPrimary}" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="N" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource NexusForegroundOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nexus"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DshTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnCollapseSidebar"
                            Style="{StaticResource DshIconButtonStyle}"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Collapse sidebar"
                            AutomationProperties.Name="Buka / ciutkan riwayat">
                        <Path Data="{StaticResource DshIconPanelLeft}"
                              Stroke="{DynamicResource DshTextSecondaryBrush}"
                              StrokeThickness="1.2"
                              Width="16" Height="16"/>
                    </Button>
                </Grid>

                <!-- 2. New Session Pill Button -->
                <Button Grid.Row="1"
                        Command="{Binding NewConversationCommand}"
                        Height="36"
                        Margin="12,4,12,8"
                        Background="{DynamicResource DshSidebarHoverBrush}"
                        BorderBrush="{DynamicResource DshBorderL2Brush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="New Session (Ctrl+N)">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="PillBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource DshRadiusMd}"
                                    Padding="10,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Data="{StaticResource DshIconNewChat}"
                                          Stroke="{DynamicResource DshTextPrimaryBrush}"
                                          StrokeThickness="1.2"
                                          Width="16" Height="16"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="New Session"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource DshTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource DshSidebarActiveBrush}"/>
                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource DshAccentPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 3. Search Filter Box -->
                <Border Grid.Row="2"
                        Margin="12,0,12,8"
                        Height="32"
                        Background="{DynamicResource DshInputMajorBgBrush}"
                        BorderBrush="{DynamicResource DshBorderL2Brush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource DshRadiusMd}"
                        Padding="8,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="{StaticResource DshIconSearch}"
                              Stroke="{DynamicResource DshTextTertiaryBrush}"
                              StrokeThickness="1.2"
                              Width="14" Height="14"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Foreground="{DynamicResource DshTextPrimaryBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Search sessions..."
                                   FontSize="12"
                                   Foreground="{DynamicResource DshTextTertiaryBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 4. Grouped Session List -->
                <ScrollViewer x:Name="SessionListScrollViewer"
                              Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,2,0,4">
                    <StackPanel>
                    <ListBox ItemsSource="{Binding GroupedConversations}"
                             SelectedItem="{Binding SelectedConversation}"
                             ItemContainerStyle="{StaticResource DshSessionItemStyle}"
                             ItemTemplate="{StaticResource DshSessionTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             PreviewMouseWheel="SessionListBox_PreviewMouseWheel"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DshTextTertiaryBrush}"
                                                   Margin="12,10,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                    <Button Content="{Binding HistoryExpandLabel}"
                            Command="{Binding ToggleHistoryExpandedCommand}"
                            Visibility="{Binding HasMoreConversations, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{Binding HistoryExpandLabel}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource DshTextSecondaryBrush}"
                            HorizontalAlignment="Left" Padding="12,6" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>


            </Grid>

            <!-- ==================================================== -->
            <!-- COLLAPSED RAIL VIEW (Width: 56px)                    -->
            <!-- ==================================================== -->
            <Grid x:Name="CollapsedRailView" Visibility="Collapsed" Width="56">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Whale & Toggle -->
                    <RowDefinition Height="Auto"/> <!-- New Session Action -->
                    <RowDefinition Height="*"/>    <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Status -->
                </Grid.RowDefinitions>

                <!-- Rail Header: Whale & Expand Toggle (36x36 Centered) -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,12,0,8">
                    <Button Style="{StaticResource DshIconButtonStyle}"
                            Width="36" Height="36"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Expand sidebar">
                        <Path Data="{StaticResource DshIconPanelLeft}"
                              Stroke="{DynamicResource DshTextSecondaryBrush}"
                              StrokeThickness="1.2"
                              Width="18" Height="18"/>
                    </Button>
                </StackPanel>

                <!-- Rail New Session Action (36x36 Centered) -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,8">
                    <Button Style="{StaticResource DshIconButtonStyle}"
                            Width="36" Height="36"
                            Background="{DynamicResource DshSidebarHoverBrush}"
                            BorderBrush="{DynamicResource DshBorderL2Brush}"
                            BorderThickness="1"
                            Command="{Binding NewConversationCommand}"
                            ToolTip="New Session">
                        <Path Data="{StaticResource DshIconNewChat}"
                              Stroke="{DynamicResource DshTextPrimaryBrush}"
                              StrokeThickness="1.2"
                              Width="18" Height="18"/>
                    </Button>
                </StackPanel>


            </Grid>
        </Grid>
    </Border>
</UserControl>
