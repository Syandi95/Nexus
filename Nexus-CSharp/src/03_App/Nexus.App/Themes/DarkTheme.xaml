<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens/PrimitiveTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource NexusPrimitiveColor202020}"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource NexusPrimitiveColor272727}"/>
    <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{StaticResource NexusPrimitiveColor252525}"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource NexusPrimitiveColor252525}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource NexusPrimitiveColor252525}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource NexusPrimitiveColor252525}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource NexusPrimitiveColor333333}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource NexusPrimitiveColor333333}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource NexusPrimitiveWhite}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource NexusPrimitiveColorC5FFFFFF}"/>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource NexusPrimitiveColor4CC2FF}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource NexusPrimitiveColor38BAFF}"/>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="{StaticResource NexusPrimitiveColor4CC2FF}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource NexusPrimitiveColorEF4444}"/>
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="{StaticResource NexusPrimitiveColor2AFFFFFF}"/>
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="{StaticResource NexusPrimitiveColor40FFFFFF}"/>
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="{StaticResource NexusPrimitiveColorC42B1C}"/>
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="{StaticResource NexusPrimitiveColorB22415}"/>
    <RadialGradientBrush x:Key="AIWorkspaceWelcomeGlowBrush">
        <GradientStop Color="{StaticResource NexusPrimitiveColor664CC2FF}" Offset="0"/>
        <GradientStop Color="{StaticResource NexusPrimitiveColor244CC2FF}" Offset="0.55"/>
        <GradientStop Color="{StaticResource NexusPrimitiveColor00202020}" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="AIWorkspaceDeepThinkOffBackgroundBrush" Color="{StaticResource NexusPrimitiveColor00202020}"/>
    <SolidColorBrush x:Key="AIWorkspaceDeepThinkOnBackgroundBrush" Color="{StaticResource NexusPrimitiveColor244CC2FF}"/>
    <SolidColorBrush x:Key="AIWorkspaceDeepThinkOffBorderBrush" Color="{StaticResource NexusPrimitiveColor806B7280}"/>
    <SolidColorBrush x:Key="AIWorkspaceDeepThinkOnBorderBrush" Color="{StaticResource NexusPrimitiveColor4CC2FF}"/>
    <SolidColorBrush x:Key="AIWorkspaceDeepThinkOffForegroundBrush" Color="{StaticResource NexusPrimitiveColorC5FFFFFF}"/>
    <SolidColorBrush x:Key="AIWorkspaceDeepThinkOnForegroundBrush" Color="{StaticResource NexusPrimitiveColor4CC2FF}"/>
    <SolidColorBrush x:Key="AIWorkspaceUserBubbleBackgroundBrush" Color="{StaticResource NexusPrimitiveColor333333}"/>
    <SolidColorBrush x:Key="AIWorkspaceModalBackdropBrush" Color="{StaticResource NexusPrimitiveColor3B000000}"/>

    <!-- ============================================================ -->
    <!-- NEXUS UI FOUNDATION SEMANTIC BRUSHES                         -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="NexusBrushBackground" Color="{StaticResource NexusPrimitiveColor202020}"/>
    <SolidColorBrush x:Key="NexusBrushPanelBackground" Color="{StaticResource NexusPrimitiveColor252525}"/>
    <SolidColorBrush x:Key="NexusBrushInputBackground" Color="{StaticResource NexusPrimitiveColor252525}"/>
    <SolidColorBrush x:Key="NexusBrushTextPrimary" Color="{StaticResource NexusPrimitiveWhite}"/>
    <SolidColorBrush x:Key="NexusBrushTextSecondary" Color="{StaticResource NexusPrimitiveColorC5FFFFFF}"/>
    <SolidColorBrush x:Key="NexusBrushBorder" Color="{StaticResource NexusPrimitiveColor333333}"/>
    <SolidColorBrush x:Key="NexusBrushAccent" Color="{StaticResource NexusPrimitiveColor0078D4}"/>
    <SolidColorBrush x:Key="NexusBrushStatusSuccess" Color="{StaticResource NexusPrimitiveColor10B981}"/>
    <SolidColorBrush x:Key="NexusBrushStatusDanger" Color="{StaticResource NexusPrimitiveColorEF4444}"/>
    <SolidColorBrush x:Key="NexusBrushHeroStop0" Color="{StaticResource NexusPrimitiveColor0F172A}"/>
    <SolidColorBrush x:Key="NexusBrushHeroStop1" Color="{StaticResource NexusPrimitiveColor1E293B}"/>
    <SolidColorBrush x:Key="NexusBrushHeroStop2" Color="{StaticResource NexusPrimitiveColor334155}"/>
    <SolidColorBrush x:Key="NexusBrushCardIconBg" Color="{StaticResource NexusPrimitiveColor1E293B}"/>

    <Color x:Key="NexusColorHeroStop0">#0F172A</Color>
    <Color x:Key="NexusColorHeroStop1">#1E293B</Color>
    <Color x:Key="NexusColorHeroStop2">#334155</Color>
</ResourceDictionary>
