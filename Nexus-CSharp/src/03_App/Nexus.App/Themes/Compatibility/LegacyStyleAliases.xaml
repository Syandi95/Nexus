<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Migration-only compatibility style aliases. Do not consume in new code. -->


    <Style x:Key="NexusAccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NexusPrimaryButtonStyle}"/>
    <Style x:Key="NexusButtonPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource NexusPrimaryButtonStyle}"/>
    <Style x:Key="RemoveBackgroundPrimaryActionStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NexusPrimaryButtonStyle}"/>
    <Style x:Key="RemoveBackgroundModernButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NexusSecondaryButtonStyle}"/>
    <Style x:Key="RemoveBackgroundToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NexusIconButtonStyle}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="2,0"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Inputs -->
    <Style x:Key="NexusTextBoxStandard" TargetType="{x:Type TextBox}" BasedOn="{StaticResource NexusTextBoxStyle}"/>

    <Style x:Key="NexusPasswordBoxStandard" TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="{DynamicResource NexusBrushInputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusBrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Height" Value="{StaticResource NexusHeightStandard}"/>
        <Setter Property="FontSize" Value="{DynamicResource NexusFontBody}"/>
    </Style>

    <Style x:Key="RemoveBackgroundSettingsTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource NexusTextBoxStyle}"/>

    <!-- Selection & Controls -->
    <Style x:Key="NexusComboBoxStandard" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource NexusComboBoxStyle}"/>
    <Style x:Key="NexusCheckBoxStandard" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource NexusCheckBoxStyle}"/>
    <Style x:Key="NexusRadioButtonStandard" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource NexusRadioButtonStyle}"/>
    <Style x:Key="PdfPageSegmentStyle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource NexusSegmentedRadioButtonStyle}"/>

    <Style x:Key="NexusToggleButtonStandard" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource NexusBrushInputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusBrushTextPrimary}"/>
        <Setter Property="Height" Value="{StaticResource NexusHeightStandard}"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <Style x:Key="NexusSliderStandard" TargetType="{x:Type Slider}" BasedOn="{StaticResource NexusSliderStyle}"/>

    <Style x:Key="NexusProgressBarStandard" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource NexusProgressBarStyle}"/>
    <Style x:Key="RemoveBackgroundProgressStyle" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource NexusProgressBarStyle}"/>

    <!-- Data & Collections -->
    <Style x:Key="NexusListBoxStandard" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource NexusBrushPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="NexusListViewStandard" TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="{DynamicResource NexusBrushPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="NexusDataGridStandard" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource NexusBrushPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource NexusBrushPanelBackground}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource NexusBrushInputBackground}"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style x:Key="NexusTreeViewStandard" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{DynamicResource NexusBrushPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="NexusTabControlStandard" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource NexusBrushPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusBrushBorder}"/>
    </Style>

    <Style x:Key="NexusScrollViewerStandard" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource NexusScrollViewerStyle}"/>

    <!-- Menus & Overlays -->
    <Style x:Key="NexusMenuStandard" TargetType="{x:Type Menu}" BasedOn="{StaticResource NexusMenuStyle}"/>
    <Style x:Key="NexusContextMenuStandard" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource NexusContextMenuStyle}"/>
    <Style x:Key="NexusToolTipStandard" TargetType="{x:Type ToolTip}" BasedOn="{StaticResource NexusToolTipStyle}"/>
    <Style x:Key="NexusDialogStandard" TargetType="{x:Type Border}" BasedOn="{StaticResource NexusDialogStyle}"/>

    <Style x:Key="NexusCardStandard" TargetType="{x:Type Border}" BasedOn="{StaticResource NexusCardStyle}"/>
</ResourceDictionary>
