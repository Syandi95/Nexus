<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canonical ProgressBar Style (Supports 4px compact / 8px standard, Determinate & Indeterminate) -->
    <Style x:Key="NexusProgressBarStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusAccentRest}"/>
        <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="TemplateRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NexusRadiusSmall}"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="AnimationTarget">
                            <Rectangle x:Name="PART_Track"/>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border x:Name="IndicatorChrome"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="{DynamicResource NexusRadiusSmall}"/>
                            </Decorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="IndicatorChrome" Property="Background" Value="{DynamicResource NexusAccentRest}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NexusCompactProgressBarStyle"
           TargetType="{x:Type ProgressBar}"
           BasedOn="{StaticResource NexusProgressBarStyle}">
        <Setter Property="Height" Value="4"/>
    </Style>

    <!-- Non-blocking feedback presentation styles (Icon + Text + Semantic Status) -->
    <Style x:Key="NexusValidationMessageStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource NexusErrorForeground}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="NexusInlineMessageStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource NexusInfoBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusInfoStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource NexusRadiusMedium}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="NexusPageBannerStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource NexusSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <!-- Modern Circular Ring Spinner for Batch Active Card and Footer Status -->
    <ControlTemplate x:Key="NexusModernRingSpinnerTemplate">
        <Viewbox Stretch="Uniform">
            <Grid Width="38" Height="38" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:1.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Ellipse Width="32" Height="32" Stroke="{DynamicResource NexusAccentPrimary}"
                         StrokeThickness="3" Opacity="0.18"/>
                <Path Data="M 19,3 A 16,16 0 0 1 35,19"
                      Stroke="{DynamicResource NexusAccentPrimary}"
                      StrokeThickness="3.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
            </Grid>
        </Viewbox>
    </ControlTemplate>
</ResourceDictionary>
