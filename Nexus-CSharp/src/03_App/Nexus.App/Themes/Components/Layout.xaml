<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Buttons.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Page & Toolbar Layout Metrics -->
    <Thickness x:Key="NexusMarginPageInset">24</Thickness>
    <sys:Double x:Key="NexusHeightCompactToolbar">32</sys:Double>
    <sys:Double x:Key="NexusHeightNavigationItem">44</sys:Double>

    <!-- Page Region Layout Contracts (Page -> Header -> Toolbar -> Content -> Footer) -->
    <Style x:Key="NexusPageRegionStyle" TargetType="{x:Type Grid}">
        <Setter Property="Margin" Value="{StaticResource NexusMarginPageInset}"/>
    </Style>

    <Style x:Key="NexusPageHeaderStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="NexusToolbarRegionStyle" TargetType="{x:Type ToolBar}">
        <Setter Property="MinHeight" Value="{StaticResource NexusHeightCompactToolbar}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
    </Style>

    <Style x:Key="NexusCompactToolbarStyle" TargetType="{x:Type ToolBar}" BasedOn="{StaticResource NexusToolbarRegionStyle}">
        <Setter Property="Height" Value="{StaticResource NexusHeightCompactToolbar}"/>
    </Style>

    <Style x:Key="NexusPageContentStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="NexusPageFooterStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>

    <!-- Shell Navigation Hit-Target Contract -->
    <Style x:Key="NexusNavigationItemStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NexusSubtleButtonStyle}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Connected Desktop Tabs: Curved Shoulder Style unified with PDF Tools -->
    <Style x:Key="NexusWorkspaceTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Height" Value="{DynamicResource NexusHeightNavigation}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="-8,0,-8,0"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource NexusPdfTabStripBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{DynamicResource NexusTypographyFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource NexusTypographyBodyCompactSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource NexusTypographyRegularWeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TabChrome"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="8,8,0,0"/>
                        <Border x:Name="SelectedBottomJoin"
                                Grid.ColumnSpan="3"
                                Height="3"
                                Margin="2,0,2,-1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource NexusSurfaceBase}"
                                Visibility="Collapsed"/>
                        <Grid x:Name="LowerShoulders"
                              Grid.ColumnSpan="3"
                              Height="9"
                              VerticalAlignment="Bottom"
                              Visibility="Collapsed"
                              IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Height="8" VerticalAlignment="Bottom" Background="{Binding Background, ElementName=TabChrome}"/>
                            <Path Grid.Column="0" VerticalAlignment="Bottom" Height="8" Width="8"
                                  Fill="{Binding Background, ElementName=TabChrome}" Data="M0,8 A8,8 0 0 0 8,0 L8,8 Z"/>
                            <Path Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="9" Width="9"
                                  Stroke="{Binding BorderBrush, ElementName=TabChrome}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True" Data="M0,8.5 A8.5,7.5 0 0 0 8.5,1"/>
                            <Path Grid.Column="2" VerticalAlignment="Bottom" Height="8" Width="8"
                                  Fill="{Binding Background, ElementName=TabChrome}" Data="M0,0 A8,8 0 0 0 8,8 L0,8 Z"/>
                            <Path Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="9" Width="9"
                                  Stroke="{Binding BorderBrush, ElementName=TabChrome}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True" Data="M0.5,1 A8.5,7.5 0 0 0 9,8.5"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource NexusSurfaceRaised}"/>
                            <Setter TargetName="TabChrome" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="LowerShoulders" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseCaptured" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
                            <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
                            <Setter TargetName="TabChrome" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="TabChrome" Property="CornerRadius" Value="8,8,0,0"/>
                            <Setter TargetName="LowerShoulders" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SelectedBottomJoin" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource NexusTypographyStrongWeight}"/>
                            <Setter Property="Panel.ZIndex" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="TabChrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NexusWorkspaceTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource NexusPdfTabStripBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Panel.ZIndex" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NexusWorkspaceTabItemStyle}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="12,0,0,0"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid>
                            <Border Height="1" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}"/>
                            <TabPanel IsItemsHost="True"
                                      Margin="24,8,24,0"
                                      HorizontalAlignment="Left"
                                      KeyboardNavigation.TabNavigation="Local"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
