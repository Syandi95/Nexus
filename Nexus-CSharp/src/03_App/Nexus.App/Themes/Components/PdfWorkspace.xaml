<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:Nexus.App.Services">
        <Style x:Key="NexusPdfWorkspaceTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource NexusWorkspaceTabItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource NexusPdfTabStripBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="-8,0,-8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TabChrome" Grid.Column="1" Margin="0,0,0,8"
                                    Background="Transparent" BorderThickness="0" CornerRadius="8,8,0,0"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                            </Border>
                            <Grid x:Name="LowerShoulders" Grid.ColumnSpan="3" Height="9" VerticalAlignment="Bottom"
                                  Visibility="Collapsed" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Height="8" VerticalAlignment="Bottom" Background="{Binding Background, ElementName=TabChrome}"/>
                                <Path Grid.Column="0" VerticalAlignment="Bottom" Height="8" Width="8"
                                      Fill="{Binding Background, ElementName=TabChrome}" Data="M0,8 A8,8 0 0 0 8,0 L8,8 Z"/>
                                <Path Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="9" Width="9"
                                      Stroke="{Binding BorderBrush, ElementName=TabChrome}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True" Data="M0,8.5 A8.5,7.5 0 0 0 8.5,1"/>
                                <Path Grid.Column="2" VerticalAlignment="Bottom" Height="8" Width="8"
                                      Fill="{Binding Background, ElementName=TabChrome}" Data="M0,0 A8,8 0 0 0 8,8 L0,8 Z"/>
                                <Path Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="9" Width="9"
                                      Stroke="{Binding BorderBrush, ElementName=TabChrome}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True" Data="M0.5,1 A8.5,7.5 0 0 0 9,8.5"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource NexusSurfaceRaised}"/>
                                <Setter TargetName="TabChrome" Property="BorderThickness" Value="1,1,1,0"/>
                                <Setter TargetName="LowerShoulders" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
                                <Setter TargetName="TabChrome" Property="BorderThickness" Value="1,1,1,0"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
                                <Setter TargetName="LowerShoulders" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
                                <Setter Property="FontWeight" Value="{DynamicResource NexusTypographyStrongWeight}"/>
                                <Setter Property="Panel.ZIndex" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <Style x:Key="NexusPdfWorkspaceTabControlStyle" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource NexusPdfWorkspaceTabItemStyle}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource NexusPdfTabStripBackground}" CornerRadius="12,0,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid>
                                <Border Height="1" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}"/>
                                <Grid Margin="16,8,16,0" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False" Focusable="False">
                                        <TabPanel IsItemsHost="True" Margin="8,0,8,0" KeyboardNavigation.TabIndex="1"/>
                                    </ScrollViewer>
                                    <Button x:Name="AddPdfWorkspaceButton" Grid.Column="1" Width="36" Height="36" Padding="0" Margin="6,0,0,0"
                                            Style="{StaticResource NexusToolbarButtonStyle}" Command="{Binding AddTabCommand}"
                                            ToolTip="Workspace PDF baru" AutomationProperties.Name="Tambah workspace PDF">
                                        <TextBlock services:NexusIcon.Glyph="Add" FontSize="16"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              KeyboardNavigation.TabNavigation="Local"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
    </Style>
    <Style x:Key="NexusPdfAddFilesButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusPrimaryButtonStyle}">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="24">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
