<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canonical Native Dialog Container Style (Border) -->
    <Style x:Key="NexusDialogStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource NexusSurfaceOverlay}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource NexusRadiusLarge}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <!-- Canonical Native Popup Child Container Style (Border) -->
    <Style x:Key="NexusPopupContainerStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource NexusSurfaceOverlay}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource NexusRadiusMedium}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- Canonical Native ToolTip Style -->
    <Style x:Key="NexusToolTipStyle" TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource NexusSurfaceOverlay}"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NexusRadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
