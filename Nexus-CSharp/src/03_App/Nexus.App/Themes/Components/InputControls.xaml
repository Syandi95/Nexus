<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Nexus.App.Behaviors"
                    xmlns:services="clr-namespace:Nexus.App.Services">
    <Style x:Key="NexusTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{DynamicResource NexusHeightStandard}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource NexusAccentSelected}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource NexusFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="InputChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NexusRadiusSmall}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NexusStrokeStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NexusStrokeFocus}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="InputChrome"
                                    Property="Background"
                                    Value="{DynamicResource NexusSurfaceSunken}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NexusForegroundDisabled}"/>
                            <Setter TargetName="InputChrome"
                                    Property="Background"
                                    Value="{DynamicResource NexusSurfaceSunken}"/>
                            <Setter TargetName="InputChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NexusStrokeSubtle}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="InputChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NexusErrorStroke}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NexusSearchBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource NexusTextBoxStyle}">
        <Setter Property="AutomationProperties.Name" Value="Search"/>
        <Setter Property="behaviors:SearchBoxBehavior.IsSearchEnabled" Value="True"/>
    </Style>

    <Style x:Key="NexusComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="MinHeight" Value="{DynamicResource NexusHeightCompact}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="ItemChrome"
                                Margin="4,1,4,1"
                                Padding="0"
                                VerticalAlignment="Stretch"
                                CornerRadius="{DynamicResource NexusRadiusSmall}">
                            <Grid>
                                <Border x:Name="ActiveIndicator"
                                        Width="3"
                                        Height="16"
                                        Margin="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource NexusAccentSelected}"
                                        CornerRadius="1.5"
                                        Visibility="Collapsed"/>
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  TextElement.Foreground="{DynamicResource NexusForegroundPrimary}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource NexusSurfaceSunken}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ActiveIndicator"
                                    Property="Visibility"
                                    Value="Visible"/>
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource NexusSurfaceSunken}"/>
                            <Setter TargetName="PART_ContentPresenter"
                                    Property="TextElement.Foreground"
                                    Value="{DynamicResource NexusForegroundPrimary}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NexusForegroundPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NexusForegroundDisabled}"/>
                            <Setter TargetName="PART_ContentPresenter"
                                    Property="TextElement.Foreground"
                                    Value="{DynamicResource NexusForegroundDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NexusComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="{DynamicResource NexusHeightCompact}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource NexusComboBoxItemStyle}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource NexusFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Foreground="{DynamicResource NexusForegroundPrimary}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="InputChrome"
                                            Background="{Binding Background,
                                                                 RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush,
                                                                  RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness,
                                                                      RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="{DynamicResource NexusRadiusSmall}">
                                        <Grid Margin="{Binding Padding,
                                                               RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplateSelector="{Binding SelectionBoxItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource NexusForegroundPrimary}"/>
                                            <TextBlock Grid.Column="1"
                                                       services:NexusIcon.Glyph="ChevronDown"
                                                       FontFamily="{StaticResource NexusGlyphFontFamily}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource NexusForegroundSecondary}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="0,4,0,0"
                                    Padding="4"
                                    MinWidth="{Binding ActualWidth,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource NexusSurfaceOverlay}"
                                    BorderBrush="{DynamicResource NexusStrokeDefault}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource NexusRadiusMedium}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.12" ShadowDepth="6" Color="Black"/>
                                </Border.Effect>
                                <Grid>
                                    <ScrollViewer x:Name="ItemsHost">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="EmptyState"
                                               Text="No items"
                                               Foreground="{DynamicResource NexusForegroundSecondary}"
                                               Padding="12,8"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource NexusSurfaceSunken}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource NexusStrokeFocus}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource NexusStrokeFocus}"/>
                            <Setter Property="Background"
                                    Value="{DynamicResource NexusSurfaceBase}"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="EmptyState" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NexusForegroundDisabled}"/>
                            <Setter Property="Background"
                                    Value="{DynamicResource NexusSurfaceSunken}"/>
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource NexusStrokeSubtle}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource NexusErrorStroke}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NexusCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource NexusFontBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NexusRadioButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource NexusFontBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NexusSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,0"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource NexusFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border x:Name="ActiveTrack" Height="4" CornerRadius="2"
                                                    Background="{DynamicResource NexusAccentPrimary}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb" Focusable="False" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Grid Width="18" Height="18" Background="Transparent">
                                                <Ellipse x:Name="ThumbRing" Fill="{DynamicResource NexusSurfaceBase}"
                                                         Stroke="{DynamicResource NexusAccentPrimary}" StrokeThickness="2"/>
                                                <Ellipse x:Name="ThumbDot" Width="6" Height="6" Fill="{DynamicResource NexusAccentPrimary}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbRing" Property="Stroke" Value="{DynamicResource NexusAccentHover}"/>
                                                    <Setter TargetName="ThumbDot" Property="Fill" Value="{DynamicResource NexusAccentHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbRing" Property="Stroke" Value="{DynamicResource NexusAccentPressed}"/>
                                                    <Setter TargetName="ThumbDot" Property="Fill" Value="{DynamicResource NexusAccentPressed}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource NexusStrokeSubtle}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NexusToggleSwitchStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource NexusFocusVisualStyle}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ToggleTrack" Grid.Column="0"
                                Width="40" Height="20" CornerRadius="10"
                                Background="{DynamicResource NexusSurfaceSunken}"
                                BorderBrush="{DynamicResource NexusStrokeStrong}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <Ellipse x:Name="ToggleThumb" Width="12" Height="12"
                                         Fill="{DynamicResource NexusForegroundSecondary}"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource NexusAccentPrimary}"/>
                            <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource NexusAccentPrimary}"/>
                            <Setter TargetName="ToggleTrack" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="ToggleThumb" Property="Fill" Value="White"/>
                            <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
