<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="NexusButtonBaseStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{DynamicResource NexusHeightStandard}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource NexusFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NexusRadiusSmall}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"/>
                        <Trigger Property="IsPressed" Value="True"/>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NexusStrokeSubtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NexusPrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NexusAccentRest}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentRest}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusAccentHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusAccentPressed}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusAccentPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource NexusStrokeSubtle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NexusButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NexusSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource NexusSurfaceRaised}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NexusSecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusButtonStyle}"/>

    <Style x:Key="NexusSubtleButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NexusToolbarButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusButtonBaseStyle}">
        <Setter Property="Height" Value="{DynamicResource NexusHeightCompact}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NexusDangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NexusErrorStroke}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusErrorStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusErrorForeground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusErrorForeground}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusErrorStroke}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource NexusStrokeSubtle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NexusIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusButtonBaseStyle}">
        <Setter Property="Width" Value="{DynamicResource NexusHeightStandard}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusForegroundPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"/>
                        <Trigger Property="IsPressed" Value="True"/>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NexusStrokeSubtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSurfaceBase}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NexusOutlinedIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusIconButtonStyle}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
    </Style>

    <Style x:Key="NexusOverlayIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusIconButtonStyle}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="{DynamicResource NexusOverlayButtonRest}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeDefault}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusOverlayButtonHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusOverlayButtonPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NexusSoftFolderIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusIconButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource NexusSoftFolderBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusSoftFolderBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusSoftFolderForeground}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSoftFolderBorder}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusSoftFolderForeground}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSoftFolderBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusSoftFolderBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NexusSoftDeleteIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NexusIconButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource NexusSoftDeleteBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NexusSoftDeleteBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusSoftDeleteForeground}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSoftDeleteBorder}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusSoftDeleteForeground}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NexusSoftDeleteBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NexusSoftDeleteBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource NexusStrokeSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource NexusForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Windows 11 Caption Buttons (Minimize, Maximize) -->
    <Style x:Key="NexusCaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionButtonPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows 11 Caption Close Button (Turns Red on hover with white icon) -->
    <Style x:Key="NexusCaptionCloseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionClosePressedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource NexusForegroundOnAccent}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter TargetName="Chrome" Property="CornerRadius" Value="0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Existing workspace pill templates, centralized without changing geometry. -->
    <Style x:Key="AIWorkspacePillButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusSecondaryButtonStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NexusAccentRest}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AIWorkspacePrimaryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusPrimaryButtonStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NexusStrokeStrong}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NexusRoundActionButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="18" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource NexusRoundActionHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource NexusRoundActionPressed}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NexusAttachmentCardButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource NexusFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonChrome"
                            CornerRadius="18"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource NexusSurfaceSunken}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource NexusSurfaceSecondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Image-preview overlay navigation; preserve the Photos-style visual states. -->
    <Style x:Key="PhotosNavigationButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Foreground" Value="{DynamicResource NexusImageNavigationForeground}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource NexusImageNavigationRest}"
                            BorderBrush="{DynamicResource NexusImageNavigationStroke}"
                            BorderThickness="1"
                            CornerRadius="4"
                            SnapsToDevicePixels="True"
                            Opacity="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover state when Host is hovered AND Button is Enabled -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True"/>
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NexusImageNavigationHover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NexusImageNavigationHoverStroke}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </MultiDataTrigger>
                        <!-- Pressed state when Button is pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NexusImageNavigationPressed}"/>
                        </Trigger>
                        <!-- Hover state when Host is hovered AND Button is Disabled -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True"/>
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.28"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NexusImageNavigationDisabled}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NexusImageNavigationDisabledStroke}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
